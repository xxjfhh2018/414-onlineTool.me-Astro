{
  "$ref": "#/definitions/tools",
  "definitions": {
    "tools": {
      "type": "object",
      "properties": {
        "seoTitle": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "keywords": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "calculators",
            "sports",
            "converters",
            "text-tools",
            "qr-code",
            "generators",
            "timers"
          ]
        },
        "subcategory": {
          "type": "string",
          "enum": [
            "education",
            "games",
            "engineering",
            "everyday",
            "finance"
          ]
        },
        "icon": {
          "type": "string"
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "useCases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "method": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "formula": {
              "type": "string"
            },
            "example": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "description",
            "example"
          ],
          "additionalProperties": false
        },
        "calculationDetails": {
          "type": "object",
          "properties": {
            "formula": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "rounding": {
              "type": "string"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "publisher": {
                    "type": "string"
                  },
                  "accessedDate": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "url"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "version": {
              "type": "string"
            },
            "applicableDate": {
              "type": "string"
            },
            "lastVerified": {
              "type": "string"
            },
            "updateResponsibility": {
              "type": "string"
            },
            "resultLabel": {
              "type": "string",
              "enum": [
                "Exact calculation",
                "Planning estimate",
                "Estimated equivalent",
                "Demonstration",
                "Version-specific result"
              ]
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "example": {
              "type": "object",
              "properties": {
                "inputs": {
                  "type": "string"
                },
                "calculation": {
                  "type": "string"
                },
                "result": {
                  "type": "string"
                }
              },
              "required": [
                "inputs",
                "calculation",
                "result"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "howToUse": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "number"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "step",
              "title",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "question",
              "answer"
            ],
            "additionalProperties": false
          }
        },
        "ogImage": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "seoTitle",
        "title",
        "description",
        "intro",
        "category",
        "icon",
        "features",
        "useCases",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}