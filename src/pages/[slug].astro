---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ToolVerificationPanel from '../components/ToolVerificationPanel.astro';
import { toolVerification } from '../data/toolVerification';
import { toolRegistry } from '../data/toolRegistry';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map(tool => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const {
  seoTitle,
  title,
  description,
  intro,
  category,
  subcategory,
  icon,
  features,
  useCases,
  method,
  calculationDetails,
  limitations,
  howToUse,
  faq,
  ogImage,
  relatedTools,
} = tool.data;

const allTools = await getCollection('tools');
const related = relatedTools
  .map(slug => allTools.find(entry => entry.slug === slug))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

const canonical = `https://onlinetool.me/${tool.slug}/`;
const resolvedOgImage = ogImage
  ? new URL(ogImage, 'https://onlinetool.me').toString()
  : 'https://onlinetool.me/images/og/default-tools.png';

const categoryLabels: Record<string, string> = {
  'calculators': 'Calculators',
  'sports': 'Sports Tools',
  'converters': 'Converters',
  'text-tools': 'Text & List Tools',
  'qr-code': 'QR Code Tools',
  'generators': 'Generators',
  'timers': 'Timers & Counters',
};

const calculatorSubcategoryLabels: Record<string, string> = {
  'education': 'Education Calculators',
  'games': 'Game Calculators',
  'engineering': 'Material Calculator',
  'everyday': 'Everyday Calculators',
  'finance': 'Financial Calculators',
};

const displayCategory = category === 'calculators' && subcategory
  ? calculatorSubcategoryLabels[subcategory]
  : categoryLabels[category] || category;
const categoryAnchor = category === 'calculators' && subcategory
  ? `calculator-${subcategory}`
  : `category-${category}`;
const categoryHref = `/#${categoryAnchor}`;
const breadcrumbCategoryUrl = `https://onlinetool.me/#${categoryAnchor}`;

const registryEntry = toolRegistry[tool.slug];
const ToolComponent = registryEntry?.component;
const ToolReferenceComponent = registryEntry?.referenceComponent;
const verification = toolVerification[tool.slug];

const webApplicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  description,
  url: canonical,
  applicationCategory: registryEntry?.applicationCategory
    ?? (subcategory === 'education'
      ? 'EducationalApplication'
      : subcategory === 'finance'
        ? 'FinanceApplication'
        : 'UtilitiesApplication'),
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  ...(verification ? { dateModified: verification.lastReviewed } : {}),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://onlinetool.me/' },
    { '@type': 'ListItem', position: 2, name: displayCategory, item: breadcrumbCategoryUrl },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};

const faqJsonLd = faq?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;
---

<BaseLayout 
  title={seoTitle}
  description={description}
  canonical={canonical}
  ogImage={resolvedOgImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(webApplicationJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  <!-- Breadcrumb -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <nav class="flex items-center gap-2 overflow-x-auto whitespace-nowrap text-sm text-gray-500 dark:text-gray-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Home</a>
      <svg class="w-4 h-4 flex-none" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <a href={categoryHref} class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">{displayCategory}</a>
      <svg class="w-4 h-4 flex-none" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-gray-900 dark:text-white font-medium" aria-current="page">{title}</span>
    </nav>
  </div>

  <!-- Hero -->
  <section class="pt-8 pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-primary-50 dark:bg-primary-900/30 flex items-center justify-center text-primary-500 dark:text-primary-400">
        <Icon name={icon} class="w-8 h-8" />
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-3">
        {title}
      </h1>
      <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
        {intro}
      </p>
    </div>
  </section>

  <!-- Tool Function Area -->
  <section class="pb-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      {ToolComponent ? <ToolComponent course={tool.slug} /> : (
        <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-8 text-center">
          <p class="text-sm text-gray-500 dark:text-gray-400">Tool interface coming soon.</p>
        </div>
      )}
    </div>
  </section>

  <!-- Calculator Data Status -->
  {verification && (
    <section class="pb-12">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <ToolVerificationPanel verification={verification} />
      </div>
    </section>
  )}

  <!-- How to Use -->
  {howToUse && howToUse.length > 0 && (
    <section class="pb-12">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">How to Use {title}</h2>
        <div class="space-y-4">
          {howToUse.map((step) => (
            <div class="flex gap-4 p-5 rounded-xl bg-white dark:bg-surface-dark border border-gray-100 dark:border-white/5">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-primary-500 text-white flex items-center justify-center text-sm font-bold">
                {step.step}
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-white mb-1">{step.title}</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Features -->
  <section class="pb-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">{title} Features</h2>
      <ul class="grid sm:grid-cols-2 gap-3">
        {features.map(feature => (
          <li class="flex gap-3 rounded-xl bg-white dark:bg-surface-dark border border-gray-100 dark:border-white/5 p-4 text-sm text-gray-600 dark:text-gray-400">
            <span class="text-primary-500 font-bold" aria-hidden="true">✓</span>
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="pb-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">Common Use Cases</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {useCases.map(item => (
          <article class="rounded-xl bg-white dark:bg-surface-dark border border-gray-100 dark:border-white/5 p-5">
            <h3 class="font-semibold text-gray-900 dark:text-white mb-2">{item.title}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-6">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Limits and Assumptions -->
  <section class="pb-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Limits and Important Notes</h2>
      <div class="space-y-5">
        {(calculationDetails || method) && (
          <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-100 dark:border-white/5 p-6 space-y-5">
            {calculationDetails?.resultLabel && (
              <p class="text-sm font-medium text-primary-700 dark:text-primary-300">
                Result type: {calculationDetails.resultLabel}
              </p>
            )}

            {calculationDetails ? (
              <>
                {calculationDetails.steps.length > 0 && (
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Calculation Details</h3>
                    <ul class="list-disc pl-5 space-y-2 text-sm text-gray-600 dark:text-gray-400 leading-6">
                      {calculationDetails.steps.map(step => <li>{step}</li>)}
                    </ul>
                  </div>
                )}
                {calculationDetails.formula && (
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Formula</h3>
                    <div class="rounded-xl bg-gray-50 dark:bg-white/5 px-4 py-3 font-mono text-sm text-gray-800 dark:text-gray-200 overflow-x-auto">
                      {calculationDetails.formula}
                    </div>
                  </div>
                )}
                {calculationDetails.rounding && (
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Rounding</h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 leading-6">{calculationDetails.rounding}</p>
                  </div>
                )}
                {calculationDetails.assumptions.length > 0 && (
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Default Assumptions</h3>
                    <ul class="list-disc pl-5 space-y-2 text-sm text-gray-600 dark:text-gray-400 leading-6">
                      {calculationDetails.assumptions.map(assumption => <li>{assumption}</li>)}
                    </ul>
                  </div>
                )}
                {calculationDetails.example && (
                  <div class="border-l-4 border-primary-500 pl-4">
                    <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Verified Example</h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 leading-6"><strong>Inputs:</strong> {calculationDetails.example.inputs}</p>
                    <p class="text-sm text-gray-600 dark:text-gray-400 leading-6"><strong>Calculation:</strong> {calculationDetails.example.calculation}</p>
                    <p class="text-sm text-gray-600 dark:text-gray-400 leading-6"><strong>Result:</strong> {calculationDetails.example.result}</p>
                  </div>
                )}
                {(calculationDetails.sources.length > 0 || calculationDetails.version || calculationDetails.applicableDate || calculationDetails.lastVerified || calculationDetails.updateResponsibility) && (
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Sources and Version</h3>
                    <div class="space-y-2 text-sm text-gray-600 dark:text-gray-400 leading-6">
                      {calculationDetails.version && <p><strong>Version:</strong> {calculationDetails.version}</p>}
                      {calculationDetails.applicableDate && <p><strong>Applicable date:</strong> {calculationDetails.applicableDate}</p>}
                      {calculationDetails.lastVerified && <p><strong>Last verified:</strong> {calculationDetails.lastVerified}</p>}
                      {calculationDetails.updateResponsibility && <p><strong>Update responsibility:</strong> {calculationDetails.updateResponsibility}</p>}
                      {calculationDetails.sources.length > 0 && (
                        <ul class="list-disc pl-5 space-y-1">
                          {calculationDetails.sources.map(source => (
                            <li>
                              <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-primary-600 dark:text-primary-400 hover:underline">
                                {source.name}
                              </a>
                              {source.publisher ? ` — ${source.publisher}` : ''}
                              {source.accessedDate ? ` (accessed ${source.accessedDate})` : ''}
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </div>
                )}
              </>
            ) : method && (
              <>
                <div>
                  <h3 class="font-semibold text-gray-900 dark:text-white mb-2">{method.title}</h3>
                  <div class="space-y-3 text-sm text-gray-600 dark:text-gray-400 leading-6">
                    {method.description.map(paragraph => <p>{paragraph}</p>)}
                  </div>
                </div>
                {method.formula && (
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Formula</h3>
                    <div class="rounded-xl bg-gray-50 dark:bg-white/5 px-4 py-3 font-mono text-sm text-gray-800 dark:text-gray-200 overflow-x-auto">
                      {method.formula}
                    </div>
                  </div>
                )}
                <div class="border-l-4 border-primary-500 pl-4">
                  <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Example</h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400 leading-6">{method.example}</p>
                </div>
              </>
            )}
          </div>
        )}

        <ul class="list-disc pl-5 space-y-2 text-sm text-gray-600 dark:text-gray-400 leading-6">
          {limitations.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Optional research/reference context -->
  {ToolReferenceComponent && <ToolReferenceComponent />}

  <!-- Related Tools -->
  {related.length > 0 && (
    <section class="pb-12">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">Related Tools</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {related.map(entry => (
            <a href={`/${entry.slug}/`} class="block rounded-xl bg-white dark:bg-surface-dark border border-gray-100 dark:border-white/5 p-5 hover:border-primary-300 dark:hover:border-primary-700 transition-colors">
              <h3 class="font-semibold text-gray-900 dark:text-white mb-1">{entry.data.title}</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400 leading-6">{entry.data.intro}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  {faq && faq.length > 0 && (
    <section class="pb-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {faq.map((item, index) => (
            <div class="rounded-xl bg-white dark:bg-surface-dark border border-gray-100 dark:border-white/5 overflow-hidden">
              <button 
                class="faq-toggle w-full flex items-center justify-between p-5 text-left group"
                data-index={index}
                aria-expanded="false"
              >
                <span class="font-medium text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                  {item.question}
                </span>
                <svg 
                  class="faq-icon w-5 h-5 text-gray-400 flex-shrink-0 ml-4 transition-transform duration-300" 
                  fill="none" 
                  stroke="currentColor" 
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div class="faq-content hidden px-5 pb-5">
                <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
                  {item.answer}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  (function() {
    const toggles = document.querySelectorAll('.faq-toggle');
    
    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const content = toggle.nextElementSibling;
        const icon = toggle.querySelector('.faq-icon');
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        
        toggles.forEach(t => {
          if (t !== toggle) {
            t.setAttribute('aria-expanded', 'false');
            t.nextElementSibling?.classList.add('hidden');
            t.querySelector('.faq-icon')?.classList.remove('rotate-180');
          }
        });
        
        toggle.setAttribute('aria-expanded', String(!isExpanded));
        content?.classList.toggle('hidden');
        icon?.classList.toggle('rotate-180');
      });
    });
  })();
</script>
