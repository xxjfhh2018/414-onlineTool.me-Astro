---
import VersionedLookupToolShell from './templates/VersionedLookupToolShell.astro';
---
<div class="lsat-score-tool">
  <VersionedLookupToolShell inputTitle="Convert an April 2022 LSAT Raw Score" inputDescription="Enter correct answers from disclosed Form LTZB03 to get that form’s exact published 120–180 conversion." resultLabel="Version-specific result">
    <div slot="version"><div class="font-semibold text-gray-700 dark:text-gray-200">Disclosed test version</div><div class="mt-1">April 2022 · Form LTZB03 · 75 scored questions</div></div>
    <div slot="source" class="sm:text-right"><div class="font-semibold text-gray-700 dark:text-gray-200">Data source</div><a href="https://www.lsac.org/document-library/809" target="_blank" rel="noopener noreferrer" class="mt-1 inline-block text-primary-600 underline dark:text-primary-400">LSAC Disclosure Booklet</a></div>
    <div slot="inputs" class="max-w-sm mx-auto"><label for="lsat-raw" class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">Raw score (correct answers)</label><input id="lsat-raw" class="lsat-raw w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" inputmode="numeric" min="0" max="75" step="1" placeholder="50"><p class="mt-2 text-xs text-gray-500">Whole numbers only, from 0 to 75.</p></div>
    <div slot="cutoffSummary" class="rounded-xl border border-gray-200/60 bg-gray-50 px-4 py-3 text-xs text-gray-600 dark:border-white/10 dark:bg-white/[0.03] dark:text-gray-300"><strong>Current table:</strong> April 2022 Form LTZB03. Another LSAT form may convert the same raw score differently because LSAC uses equating.</div>
    <div slot="controls" class="flex justify-center gap-3"><button type="button" class="lsat-calculate min-h-11 rounded-xl bg-primary-500 px-6 py-2.5 text-sm font-semibold text-white">Calculate</button><button type="button" class="lsat-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10">Reset</button></div>
    <div slot="result" class="lsat-result"><div class="min-h-[9rem] rounded-xl border border-dashed border-gray-300 bg-gray-50/70 p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:border-white/15 dark:bg-white/[0.03]">Your form-specific scaled score will appear here.</div></div>
    <div slot="footer" class="mx-auto mt-4 max-w-4xl rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs leading-5 text-amber-800 dark:border-amber-800/40 dark:bg-amber-900/10 dark:text-amber-300">Use only with April 2022 Form LTZB03. This does not predict a current official LSAT score, percentile, or admission outcome.</div>
  </VersionedLookupToolShell>
</div>
<script>
  import { calculateLsatScore } from '../../lib/dailyBatchCalculators.mjs';
  document.querySelectorAll<HTMLElement>('.lsat-score-tool').forEach(root => { if (root.dataset.ready) return; root.dataset.ready='true'; const input=root.querySelector('.lsat-raw') as HTMLInputElement; const result=root.querySelector('.lsat-result') as HTMLElement; const placeholder=result.innerHTML; const render=(force=false)=>{ if(!input.value&&!force){result.innerHTML=placeholder;return;} try{const value=calculateLsatScore(input.value); result.innerHTML=`<div class="rounded-xl border border-primary-100 bg-primary-50 p-6 text-center dark:border-primary-800/30 dark:bg-primary-900/20"><div class="text-sm text-gray-600 dark:text-gray-400">April 2022 scaled score</div><div class="mt-1 text-5xl font-bold text-primary-600 dark:text-primary-400">${value.scaledScore}</div><div class="mt-2 text-xs text-gray-500">Raw ${value.rawScore} of 75 · Form LTZB03</div></div><div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300"><strong>Scale context:</strong> LSAT reported scores run from 120 to 180; this result is tied to the selected disclosed form.</div>`;}catch(error){result.innerHTML=`<div class="min-h-[9rem] rounded-xl border border-amber-200 bg-amber-50 p-4 flex items-center justify-center text-center text-sm text-amber-800">${error instanceof Error?error.message:'Unable to convert this score.'}</div>`;}}; input.addEventListener('input',()=>render()); root.querySelector('.lsat-calculate')?.addEventListener('click',()=>render(true)); root.querySelector('.lsat-reset')?.addEventListener('click',()=>{input.value='';result.innerHTML=placeholder;input.focus();}); });
</script>
