<div class="max-w-md mx-auto text-center">
  <div class="rounded-3xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-8">
    <div class="mb-6">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Run a Focus and Break Cycle</h2>
      <p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">Studying, writing, or working in short blocks? Set the focus and break lengths, then start the countdown.</p>
    </div>
    <!-- Timer Display -->
    <div class="mb-8">
      <div id="pomo-timer" class="text-7xl font-mono font-bold text-gray-900 dark:text-white tracking-wider">
        25:00
      </div>
      <div id="pomo-status" class="mt-2 text-sm text-gray-500 dark:text-gray-400">Ready to focus</div>
    </div>
    
    <!-- Progress Ring -->
    <div class="relative w-48 h-48 mx-auto mb-8">
      <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-width="3" class="text-gray-100 dark:text-white/5" />
        <circle id="pomo-progress" cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-width="3" 
                stroke-linecap="round" stroke-dasharray="283" stroke-dashoffset="0" 
                class="text-primary-500 transition-all duration-1000" />
      </svg>
      <div class="absolute inset-0 flex items-center justify-center">
        <svg class="w-10 h-10 text-primary-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
    </div>

    <div id="pomo-context" class="mb-6 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300" aria-live="polite">
      <strong>Session progress:</strong> 0% elapsed · 25:00 remaining in the focus interval.
    </div>
    
    <!-- Controls -->
    <div class="flex items-center justify-center gap-4">
      <button id="pomo-start" class="px-8 py-3 rounded-xl bg-primary-500 text-white font-semibold hover:bg-primary-600 transition-colors">
        Start
      </button>
      <button id="pomo-pause" class="hidden px-8 py-3 rounded-xl bg-gray-100 dark:bg-white/10 text-gray-700 dark:text-gray-300 font-semibold hover:bg-gray-200 dark:hover:bg-white/20 transition-colors">
        Pause
      </button>
      <button id="pomo-reset" class="px-6 py-3 rounded-xl bg-gray-100 dark:bg-white/10 text-gray-700 dark:text-gray-300 font-medium hover:bg-gray-200 dark:hover:bg-white/20 transition-colors">
        Reset
      </button>
    </div>
    
    <!-- Settings -->
    <div class="mt-8 flex items-center justify-center gap-6 text-sm text-gray-500 dark:text-gray-400">
      <div class="flex items-center gap-2">
        <span>Work:</span>
        <input id="pomo-work" type="number" value="25" min="1" max="60" class="w-14 px-2 py-1 rounded-lg bg-gray-100 dark:bg-white/5 text-center outline-none text-gray-800 dark:text-gray-200" />
        <span>min</span>
      </div>
      <div class="flex items-center gap-2">
        <span>Break:</span>
        <input id="pomo-break" type="number" value="5" min="1" max="30" class="w-14 px-2 py-1 rounded-lg bg-gray-100 dark:bg-white/5 text-center outline-none text-gray-800 dark:text-gray-200" />
        <span>min</span>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const timerEl = document.getElementById('pomo-timer');
    const statusEl = document.getElementById('pomo-status');
    const progressEl = document.getElementById('pomo-progress');
    const contextEl = document.getElementById('pomo-context');
    const startBtn = document.getElementById('pomo-start');
    const pauseBtn = document.getElementById('pomo-pause');
    const resetBtn = document.getElementById('pomo-reset');
    const workInput = document.getElementById('pomo-work');
    const breakInput = document.getElementById('pomo-break');
    
    let timeLeft = 25 * 60;
    let totalTime = 25 * 60;
    let timer = null;
    let isRunning = false;
    let isBreak = false;
    
    const CIRCUMFERENCE = 2 * Math.PI * 45;
    
    function formatTime(seconds) {
      const m = Math.floor(seconds / 60);
      const s = seconds % 60;
      return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    }
    
    function updateDisplay() {
      if (timerEl) timerEl.textContent = formatTime(timeLeft);
      const offset = CIRCUMFERENCE - (timeLeft / totalTime) * CIRCUMFERENCE;
      if (progressEl) progressEl.style.strokeDashoffset = String(offset);
      const elapsedPercent = totalTime > 0 ? (1 - timeLeft / totalTime) * 100 : 0;
      if (contextEl) contextEl.innerHTML = `<strong>Session progress:</strong> ${Math.max(0, elapsedPercent).toFixed(1)}% elapsed · ${formatTime(timeLeft)} remaining in the ${isBreak ? 'break' : 'focus'} interval.`;
    }
    
    function start() {
      if (!isRunning) {
        isRunning = true;
        startBtn?.classList.add('hidden');
        pauseBtn?.classList.remove('hidden');
        if (statusEl) statusEl.textContent = isBreak ? 'Break time' : 'Focusing...';
        
        timer = setInterval(function() {
          timeLeft--;
          updateDisplay();
          
          if (timeLeft <= 0) {
            clearInterval(timer);
            isRunning = false;
            isBreak = !isBreak;
            var minutes = isBreak ? (parseInt(breakInput?.value || '5')) : (parseInt(workInput?.value || '25'));
            timeLeft = minutes * 60;
            totalTime = timeLeft;
            updateDisplay();
            if (statusEl) statusEl.textContent = isBreak ? 'Break finished! Ready to focus?' : 'Session complete! Take a break?';
            startBtn?.classList.remove('hidden');
            pauseBtn?.classList.add('hidden');
          }
        }, 1000);
      }
    }
    
    function pause() {
      if (timer) clearInterval(timer);
      isRunning = false;
      startBtn?.classList.remove('hidden');
      pauseBtn?.classList.add('hidden');
      if (statusEl) statusEl.textContent = 'Paused';
    }
    
    function reset() {
      if (timer) clearInterval(timer);
      isRunning = false;
      isBreak = false;
      var minutes = parseInt(workInput?.value || '25');
      timeLeft = minutes * 60;
      totalTime = timeLeft;
      updateDisplay();
      startBtn?.classList.remove('hidden');
      pauseBtn?.classList.add('hidden');
      if (statusEl) statusEl.textContent = 'Ready to focus';
    }
    
    startBtn?.addEventListener('click', start);
    pauseBtn?.addEventListener('click', pause);
    resetBtn?.addEventListener('click', reset);
    
    workInput?.addEventListener('change', function() { if (!isRunning) reset(); });
    breakInput?.addEventListener('change', function() { if (!isRunning) reset(); });
  })();
</script>
