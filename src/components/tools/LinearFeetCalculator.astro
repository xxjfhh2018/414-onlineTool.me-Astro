---
import MultiRowToolShell from './templates/MultiRowToolShell.astro';
---
<div class="linear-feet-tool max-w-4xl min-w-0 overflow-hidden mx-auto">
  <MultiRowToolShell inputTitle="Add Pieces to Calculate Linear Feet" inputDescription="Enter quantity and length for each item. Completed rows are totaled automatically.">
    <button slot="headerActions" type="button" class="lf-add min-h-11 rounded-xl border border-primary-200 px-4 py-2 text-sm font-semibold text-primary-700 dark:border-primary-800 dark:text-primary-300">Add item</button>
    <table slot="table" class="w-full min-w-[590px]">
      <thead><tr class="text-left text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400"><th class="pb-2 pr-3">Item</th><th class="pb-2 px-3 w-28">Quantity</th><th class="pb-2 px-3 w-28">Feet</th><th class="pb-2 px-3 w-28">Inches</th><th aria-label="Remove" class="pb-2 pl-3 w-20"></th></tr></thead>
      <tbody class="lf-rows"></tbody>
    </table>
    <div slot="controls" class="flex justify-center"><button type="button" class="lf-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold text-gray-700 dark:border-white/10 dark:text-gray-200">Reset</button></div>
    <div slot="result" class="lf-result"><div class="min-h-[9rem] rounded-xl border border-dashed border-gray-300 bg-gray-50/70 p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:border-white/15 dark:bg-white/[0.03] dark:text-gray-400">Your total linear feet, metres, and piece count will appear here.</div></div>
    <div slot="footer" class="mt-4 rounded-xl border border-gray-200/60 px-4 py-3 text-xs leading-5 text-gray-500 dark:border-white/10 dark:text-gray-400">Linear feet measure total length, not area or volume. Add your own cut, trim, or waste allowance before purchasing material.</div>
  </MultiRowToolShell>
</div>
<script>
  import { calculateLinearFeet } from '../../lib/dailyBatch260811.mjs';
  document.querySelectorAll<HTMLElement>('.linear-feet-tool').forEach(root => {
    if (root.dataset.ready) return; root.dataset.ready='true';
    const rows=root.querySelector('.lf-rows') as HTMLElement; const result=root.querySelector('.lf-result') as HTMLElement; const placeholder=result.innerHTML;
    const addRow=()=>{const row=document.createElement('tr');row.className='border-t border-gray-100 dark:border-white/5';row.innerHTML='<td class="py-3 pr-3"><input aria-label="Item name" class="lf-name w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2.5 dark:border-white/10 dark:bg-white/5" placeholder="Board or trim"></td><td class="py-3 px-3"><input aria-label="Quantity" class="lf-quantity w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2.5 dark:border-white/10 dark:bg-white/5" type="number" inputmode="numeric" min="1" step="1" placeholder="8"></td><td class="py-3 px-3"><input aria-label="Length in feet" class="lf-feet w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2.5 dark:border-white/10 dark:bg-white/5" type="number" inputmode="decimal" min="0" step="0.01" placeholder="6"></td><td class="py-3 px-3"><input aria-label="Additional inches" class="lf-inches w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2.5 dark:border-white/10 dark:bg-white/5" type="number" inputmode="decimal" min="0" max="11.99" step="0.01" placeholder="6"></td><td class="py-3 pl-3"><button type="button" aria-label="Remove item" class="lf-remove min-h-11 px-3 text-gray-400 hover:text-red-500">Remove</button></td>';rows.appendChild(row);};
    const warning=(message:string)=>`<div class="min-h-[9rem] rounded-xl border border-amber-200 bg-amber-50 p-4 flex items-center justify-center text-center text-sm text-amber-800 dark:border-amber-800/40 dark:bg-amber-900/10 dark:text-amber-300">${message}</div>`;
    function render(){const items=[...rows.querySelectorAll('tr')].map(row=>({quantity:(row.querySelector('.lf-quantity') as HTMLInputElement).value,feet:(row.querySelector('.lf-feet') as HTMLInputElement).value,inches:(row.querySelector('.lf-inches') as HTMLInputElement).value})).filter(item=>item.quantity||item.feet||item.inches);if(!items.length){result.innerHTML=placeholder;return;}if(items.some(item=>!item.quantity||(!item.feet&&!item.inches))){result.innerHTML=warning('Complete quantity and at least one length field for every started row.');return;}try{const value=calculateLinearFeet(items);result.innerHTML=`<div class="grid gap-3 sm:grid-cols-3"><div class="rounded-xl border border-primary-100 bg-primary-50 p-5 text-center dark:border-primary-800/30 dark:bg-primary-900/20"><div class="text-sm text-gray-600 dark:text-gray-400">Total linear feet</div><div class="mt-1 text-4xl font-bold text-primary-600 dark:text-primary-400">${value.totalFeet.toFixed(2)} ft</div></div><div class="rounded-xl bg-gray-50 p-5 text-center dark:bg-white/5"><div class="text-sm text-gray-500">Metric equivalent</div><div class="mt-2 text-2xl font-bold">${value.totalMetres.toFixed(2)} m</div></div><div class="rounded-xl bg-gray-50 p-5 text-center dark:bg-white/5"><div class="text-sm text-gray-500">Pieces included</div><div class="mt-2 text-2xl font-bold">${value.pieceCount}</div></div></div><div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300"><strong>Planning context:</strong> This is the measured total before cuts, kerfs, trim loss, and project waste.</div>`;}catch(error){result.innerHTML=warning(error instanceof Error?error.message:'Unable to total these items.');}}
    root.querySelector('.lf-add')?.addEventListener('click',()=>addRow());root.addEventListener('click',event=>{const button=(event.target as HTMLElement).closest('.lf-remove');if(!button)return;button.closest('tr')?.remove();if(!rows.children.length)addRow();render();});root.addEventListener('input',render);root.querySelector('.lf-reset')?.addEventListener('click',()=>{rows.replaceChildren();addRow();addRow();result.innerHTML=placeholder;});addRow();addRow();
  });
</script>
