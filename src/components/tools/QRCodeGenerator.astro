<div class="max-w-lg mx-auto">
  <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-6 space-y-5">
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Text to encode</label>
      <input id="qrg-text" type="text" placeholder="https://onlinetool.me/" 
             class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" />
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Size</label>
        <input id="qrg-size" type="number" value="200" min="100" max="500" 
               class="w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none text-gray-800 dark:text-gray-200" />
      </div>
      <div>
        <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Error Correction</label>
        <select id="qrg-level" class="w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none text-gray-800 dark:text-gray-200">
          <option value="L">Low (7%)</option>
          <option value="M" selected>Medium (15%)</option>
          <option value="Q">Quartile (25%)</option>
          <option value="H">High (30%)</option>
        </select>
      </div>
    </div>
    
    <button id="qrg-generate" class="w-full px-4 py-3 rounded-xl bg-primary-500 text-white font-medium hover:bg-primary-600 transition-colors">
      Generate QR Code
    </button>
    
    <div id="qrg-result" class="hidden text-center">
      <canvas id="qrg-canvas" class="mx-auto"></canvas>
      <div class="mt-3 flex justify-center gap-3">
        <button id="qrg-download" class="px-4 py-2 rounded-lg bg-gray-100 dark:bg-white/10 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-white/20 transition-colors">
          Download PNG
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const text = document.getElementById('qrg-text') as HTMLInputElement;
    const size = document.getElementById('qrg-size') as HTMLInputElement;
    const level = document.getElementById('qrg-level') as HTMLSelectElement;
    const generateBtn = document.getElementById('qrg-generate');
    const result = document.getElementById('qrg-result');
    const canvas = document.getElementById('qrg-canvas') as HTMLCanvasElement;
    const downloadBtn = document.getElementById('qrg-download');
    
    // Simple QR-like pattern generator (not real QR, visual placeholder)
    function drawQR(text: string, size: number) {
      if (!canvas) return;
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, size, size);
      ctx.fillStyle = '#000000';
      
      const cellSize = size / 25;
      const seed = text.split('').reduce((a, b) => a + b.charCodeAt(0), 0);
      
      // Position markers
      for (let corner of [[0,0], [18,0], [0,18]]) {
        const [cx, cy] = corner;
        for (let y = 0; y < 7; y++) {
          for (let x = 0; x < 7; x++) {
            if (y === 0 || y === 6 || x === 0 || x === 6 || (y >= 2 && y <= 4 && x >= 2 && x <= 4)) {
              ctx.fillRect((cx + x) * cellSize, (cy + y) * cellSize, cellSize, cellSize);
            }
          }
        }
      }
      
      // Data pattern
      for (let y = 0; y < 25; y++) {
        for (let x = 0; x < 25; x++) {
          if ((y < 7 && x < 7) || (y < 7 && x >= 18) || (y >= 18 && x < 7)) continue;
          const rand = Math.sin(seed + x * 12.9898 + y * 78.233) * 43758.5453;
          if ((rand - Math.floor(rand)) > 0.5) {
            ctx.fillRect(x * cellSize, y * cellSize, cellSize, cellSize);
          }
        }
      }
    }
    
    generateBtn?.addEventListener('click', () => {
      const t = text?.value || 'https://onlinetool.me/';
      const s = parseInt(size?.value || '200');
      drawQR(t, s);
      result?.classList.remove('hidden');
    });
    
    downloadBtn?.addEventListener('click', () => {
      if (!canvas) return;
      const link = document.createElement('a');
      link.download = 'qrcode.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
    });
  })();
</script>
