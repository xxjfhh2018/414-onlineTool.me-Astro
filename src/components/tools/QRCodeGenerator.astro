<div class="max-w-lg mx-auto">
  <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-6 space-y-5">
    <div>
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Create a QR-Style Pattern Demo</h2>
      <p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">Previewing the planned generator workflow? Enter sample text and an image size to create a decorative, non-scannable pattern.</p>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Text to encode</label>
      <input id="qrg-text" type="text" placeholder="https://onlinetool.me/" 
             class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" />
    </div>
    <div>
      <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Image size (px)</label>
      <input id="qrg-size" type="number" value="200" min="100" max="500" 
             class="w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none text-gray-800 dark:text-gray-200" />
    </div>
    
    <button id="qrg-generate" class="w-full px-4 py-3 rounded-xl bg-primary-500 text-white font-medium hover:bg-primary-600 transition-colors">
      Generate Pattern Demo
    </button>
    
    <div id="qrg-result" class="min-h-[12rem] rounded-xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-5 text-center" aria-live="polite">
      <div id="qrg-placeholder" class="min-h-[8rem] flex items-center justify-center text-sm text-gray-500 dark:text-gray-400">Your decorative pattern preview will appear here</div>
      <canvas id="qrg-canvas" class="hidden mx-auto max-w-full"></canvas>
      <div id="qrg-actions" class="hidden mt-3 flex justify-center gap-3">
        <button id="qrg-download" class="px-4 py-2 rounded-lg bg-gray-100 dark:bg-white/10 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-white/20 transition-colors">
          Download Demo PNG
        </button>
      </div>
      <div id="qrg-context" class="mt-4 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300">
        <strong>Demo status:</strong> No standards-compliant QR data is encoded; the output is decorative only.
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const text = document.getElementById('qrg-text') as HTMLInputElement;
    const size = document.getElementById('qrg-size') as HTMLInputElement;
    const generateBtn = document.getElementById('qrg-generate');
    const canvas = document.getElementById('qrg-canvas') as HTMLCanvasElement;
    const placeholder = document.getElementById('qrg-placeholder');
    const actions = document.getElementById('qrg-actions');
    const context = document.getElementById('qrg-context');
    const downloadBtn = document.getElementById('qrg-download');
    
    // Simple QR-like pattern generator (not real QR, visual placeholder)
    function drawQR(text: string, size: number) {
      if (!canvas) return;
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, size, size);
      ctx.fillStyle = '#000000';
      
      const cellSize = size / 25;
      const seed = text.split('').reduce((a, b) => a + b.charCodeAt(0), 0);
      
      // Position markers
      for (let corner of [[0,0], [18,0], [0,18]]) {
        const [cx, cy] = corner;
        for (let y = 0; y < 7; y++) {
          for (let x = 0; x < 7; x++) {
            if (y === 0 || y === 6 || x === 0 || x === 6 || (y >= 2 && y <= 4 && x >= 2 && x <= 4)) {
              ctx.fillRect((cx + x) * cellSize, (cy + y) * cellSize, cellSize, cellSize);
            }
          }
        }
      }
      
      // Data pattern
      for (let y = 0; y < 25; y++) {
        for (let x = 0; x < 25; x++) {
          if ((y < 7 && x < 7) || (y < 7 && x >= 18) || (y >= 18 && x < 7)) continue;
          const rand = Math.sin(seed + x * 12.9898 + y * 78.233) * 43758.5453;
          if ((rand - Math.floor(rand)) > 0.5) {
            ctx.fillRect(x * cellSize, y * cellSize, cellSize, cellSize);
          }
        }
      }
    }
    
    generateBtn?.addEventListener('click', () => {
      const t = text?.value || 'https://onlinetool.me/';
      const s = parseInt(size?.value || '200');
      if (!Number.isInteger(s) || s < 100 || s > 500) {
        if (context) context.innerHTML = '<strong>Demo status:</strong> Enter an image size from 100 to 500 pixels.';
        return;
      }
      drawQR(t, s);
      placeholder?.classList.add('hidden');
      canvas?.classList.remove('hidden');
      actions?.classList.remove('hidden');
      if (context) context.innerHTML = `<strong>Output context:</strong> ${s} × ${s} px PNG-style canvas · deterministic decorative pattern · not scannable as a QR code.`;
    });
    
    downloadBtn?.addEventListener('click', () => {
      if (!canvas) return;
      const link = document.createElement('a');
      link.download = 'qr-style-pattern-demo.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
    });
  })();
</script>
