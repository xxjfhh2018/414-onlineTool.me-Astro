<div class="max-w-lg mx-auto">
  <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-6 space-y-5">
    <div>
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Compare a CD Growth Scenario</h2>
      <p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">Comparing a deposit offer? Enter the deposit, term, rate, and compounding schedule shown by the institution.</p>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Deposit Amount ($)</label>
      <input id="cd-amount" type="number" min="0.01" step="0.01" placeholder="10000" 
             class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Term (months)</label>
      <select id="cd-term" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200">
        <option value="6">6 months</option>
        <option value="12">1 year</option>
        <option value="24">2 years</option>
        <option value="36">3 years</option>
        <option value="60" selected>5 years</option>
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">APY (%)</label>
      <input id="cd-apy" type="number" min="0" step="0.01" placeholder="4.5" 
             class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Compounding</label>
      <select id="cd-compound" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200">
        <option value="365">Daily</option>
        <option value="12" selected>Monthly</option>
        <option value="4">Quarterly</option>
        <option value="1">Annually</option>
      </select>
    </div>
    
    <div id="cd-result" class="min-h-[9rem]" aria-live="polite">
      <div class="min-h-[9rem] rounded-xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:text-gray-400">Your CD maturity value and interest will appear here</div>
    </div>
  </div>
</div>

<script>
  (function() {
    const amount = document.getElementById('cd-amount') as HTMLInputElement;
    const term = document.getElementById('cd-term') as HTMLSelectElement;
    const apy = document.getElementById('cd-apy') as HTMLInputElement;
    const compound = document.getElementById('cd-compound') as HTMLSelectElement;
    const result = document.getElementById('cd-result');
    const placeholder = '<div class="min-h-[9rem] rounded-xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:text-gray-400">Your CD maturity value and interest will appear here</div>';

    function calculate() {
      const amountRaw = amount?.value.trim() || '';
      const apyRaw = apy?.value.trim() || '';
      if (!result) return;
      if (!amountRaw || !apyRaw) {
        result.innerHTML = placeholder;
        return;
      }
      const p = parseFloat(amountRaw);
      const months = parseInt(term?.value || '60');
      const rateValue = parseFloat(apyRaw);
      const n = parseInt(compound?.value || '12');
      if (!Number.isFinite(p) || p <= 0 || !Number.isFinite(rateValue) || rateValue < 0) {
        result.innerHTML = '<div class="min-h-[9rem] rounded-xl bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800/40 p-4 flex items-center justify-center text-center text-sm text-amber-800 dark:text-amber-300">Enter a deposit greater than zero and an APY of zero or more.</div>';
        return;
      }
      const r = rateValue / 100;
      const years = months / 12;
      const total = p * Math.pow(1 + r / n, n * years);
      const interest = total - p;
      const effectiveApy = (Math.pow(total / p, 1 / years) - 1) * 100;
      const growthPercent = interest / p * 100;
      result.innerHTML = `<div class="space-y-3"><div class="p-4 rounded-xl bg-primary-50 dark:bg-primary-900/20 text-center"><div class="text-sm text-gray-500 dark:text-gray-400">Total at Maturity</div><div class="text-3xl font-bold text-primary-600 dark:text-primary-400 mt-1">$${total.toFixed(2)}</div></div><div class="grid grid-cols-2 gap-3"><div class="p-4 rounded-xl bg-gray-50 dark:bg-white/5 text-center"><div class="text-xs text-gray-500 dark:text-gray-400">Interest Earned</div><div class="text-xl font-bold text-gray-800 dark:text-white mt-1">$${interest.toFixed(2)}</div></div><div class="p-4 rounded-xl bg-gray-50 dark:bg-white/5 text-center"><div class="text-xs text-gray-500 dark:text-gray-400">Effective APY</div><div class="text-xl font-bold text-gray-800 dark:text-white mt-1">${effectiveApy.toFixed(2)}%</div></div></div><div class="rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300"><strong>Growth comparison:</strong> The maturity balance is ${growthPercent.toFixed(2)}% above the opening deposit after ${months} months.</div></div>`;
    }
    [amount, term, apy, compound].forEach(control => {
      control?.addEventListener('input', calculate);
      control?.addEventListener('change', calculate);
    });
  })();
</script>
