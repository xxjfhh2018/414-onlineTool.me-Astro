---
import FormulaToolShell from './templates/FormulaToolShell.astro';
const { course }=Astro.props;
const field='mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5';
const placeholder='min-h-[11rem] rounded-xl border border-dashed border-gray-300 bg-gray-50/70 p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:border-white/15 dark:bg-white/[0.03]';
---
{course==='roth-401k-calculator'&&<div class="roth-tool"><FormulaToolShell inputTitle="Project a Roth 401(k) Balance" inputDescription="Enter your current Roth balance, monthly employee contribution, time horizon, assumed return, and 2026 age group."><div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"><label class="text-sm font-medium">Current Roth balance (USD)<input class:list={[field,'rt-balance']} type="number" min="0" step="100" inputmode="decimal" value="0" /></label><label class="text-sm font-medium">Monthly employee contribution (USD)<input class:list={[field,'rt-monthly']} type="number" min="0" step="10" inputmode="decimal" placeholder="1000" /></label><label class="text-sm font-medium">Years to invest<input class:list={[field,'rt-years']} type="number" min="1" max="70" step="1" inputmode="numeric" placeholder="25" /></label><label class="text-sm font-medium">Assumed annual return (%)<input class:list={[field,'rt-return']} type="number" min="-99.99" max="50" step="0.1" inputmode="decimal" placeholder="7" /></label><label class="text-sm font-medium">2026 contribution-limit group<select class:list={[field,'rt-age']}><option value="under50">Under age 50</option><option value="age50plus">Age 50+ (except 60–63)</option><option value="age60to63">Age 60–63</option></select></label></div><div slot="result" class="rt-result"><div class={placeholder}>Your projected balance, contributions, growth, and 2026 limit context will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="rt-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div></FormulaToolShell></div>}

{course==='schd-calculator'&&<div class="schd-tool"><FormulaToolShell inputTitle="Model an SCHD Investment Scenario" inputDescription="Enter your investment, contributions, horizon, assumed total return, and assumed forward yield; no live market value is used."><div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"><label class="text-sm font-medium">Initial investment (USD)<input class:list={[field,'sc-initial']} type="number" min="0" step="100" inputmode="decimal" placeholder="10000" /></label><label class="text-sm font-medium">Monthly investment (USD)<input class:list={[field,'sc-monthly']} type="number" min="0" step="10" inputmode="decimal" value="0" /></label><label class="text-sm font-medium">Years<input class:list={[field,'sc-years']} type="number" min="1" max="70" step="1" inputmode="numeric" placeholder="10" /></label><label class="text-sm font-medium">Assumed annual total return (%)<input class:list={[field,'sc-return']} type="number" min="-99.99" max="50" step="0.1" inputmode="decimal" placeholder="8" /></label><label class="text-sm font-medium">Assumed forward dividend yield (%)<input class:list={[field,'sc-yield']} type="number" min="0" max="20" step="0.01" inputmode="decimal" placeholder="3.5" /></label></div><div slot="result" class="sc-result"><div class={placeholder}>Your scenario value, modeled growth, and yield-based annual dividend estimate will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="sc-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div></FormulaToolShell></div>}

{course==='tire-pressure-calculator'&&<div class="tire-tool"><FormulaToolShell inputTitle="Estimate Tire Pressure at Another Temperature" inputDescription="Enter a measured gauge pressure and two ambient temperatures to estimate pressure change at constant tire volume."><div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><label class="text-sm font-medium">Units<select class:list={[field,'tp-unit']}><option value="psi">psi and °F</option><option value="kpa">kPa and °C</option></select></label><label class="text-sm font-medium">Measured gauge pressure <span class="tp-pressure-unit">(psi)</span><input class:list={[field,'tp-pressure']} type="number" min="0" step="0.1" inputmode="decimal" placeholder="35" /></label><label class="text-sm font-medium">Measured temperature <span class="tp-temp-unit">(°F)</span><input class:list={[field,'tp-from']} type="number" step="0.1" inputmode="decimal" placeholder="70" /></label><label class="text-sm font-medium">Target temperature <span class="tp-temp-unit">(°F)</span><input class:list={[field,'tp-to']} type="number" step="0.1" inputmode="decimal" placeholder="30" /></label></div><div slot="result" class="tp-result"><div class={placeholder}>The temperature-adjusted pressure estimate will appear here. Always use the vehicle placard for the correct cold pressure.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="tp-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div></FormulaToolShell></div>}

{course==='partial-derivative-calculator'&&<div class="partial-tool"><FormulaToolShell inputTitle="Differentiate a Two-Variable Polynomial" inputDescription="Enter a polynomial in x and y using * between factors, then choose the differentiation variable. This parser does not support trig, logs, roots, quotients, or parentheses."><div slot="inputs" class="grid gap-4 lg:grid-cols-4"><label class="text-sm font-medium lg:col-span-2">Polynomial f(x,y)<input class:list={[field,'pd-expression']} type="text" inputmode="text" placeholder="3*x^2*y+4*y^2-5*x" /></label><label class="text-sm font-medium">Differentiate with respect to<select class:list={[field,'pd-variable']}><option value="x">x</option><option value="y">y</option></select></label><div></div><label class="text-sm font-medium">Evaluate at x <span class="text-gray-400">optional pair</span><input class:list={[field,'pd-x']} type="number" step="any" inputmode="decimal" placeholder="2" /></label><label class="text-sm font-medium">Evaluate at y <span class="text-gray-400">optional pair</span><input class:list={[field,'pd-y']} type="number" step="any" inputmode="decimal" placeholder="3" /></label></div><div slot="result" class="pd-result"><div class={placeholder}>The polynomial partial derivative and optional evaluated value will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="pd-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div></FormulaToolShell></div>}

{course==='edpi-calculator'&&<div class="edpi-tool"><FormulaToolShell inputTitle="Calculate Effective Mouse DPI" inputDescription="Enter mouse DPI and the in-game sensitivity multiplier to get eDPI and an equivalent sensitivity at another DPI."><div slot="inputs" class="grid gap-4 sm:grid-cols-3"><label class="text-sm font-medium">Mouse DPI<input class:list={[field,'ed-dpi']} type="number" min="1" max="100000" step="1" inputmode="numeric" placeholder="800" /></label><label class="text-sm font-medium">In-game sensitivity<input class:list={[field,'ed-sensitivity']} type="number" min="0" max="1000" step="0.001" inputmode="decimal" placeholder="0.5" /></label><label class="text-sm font-medium">Target DPI <span class="text-gray-400">optional</span><input class:list={[field,'ed-target']} type="number" min="1" max="100000" step="1" inputmode="numeric" placeholder="1600" /></label></div><div slot="result" class="ed-result"><div class={placeholder}>Your eDPI and optional equivalent sensitivity will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="ed-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div></FormulaToolShell></div>}

<script>
import{calculateEdpi,calculatePartialDerivative,calculateRoth401k,calculateSchdScenario,calculateTirePressureTemperature}from'../../lib/dailyBatch260814.mjs';
const get=(r:HTMLElement,s:string)=>(r.querySelector(s)as HTMLInputElement|HTMLSelectElement).value;const money=(n:number)=>n.toLocaleString(undefined,{style:'currency',currency:'USD',maximumFractionDigits:0});
const warning=(m:string)=>`<div class="min-h-[11rem] rounded-xl border border-amber-200 bg-amber-50 p-4 flex items-center justify-center text-center text-sm text-amber-800 dark:border-amber-800/40 dark:bg-amber-900/10 dark:text-amber-300">${m}</div>`;
const card=(l:string,v:string,d:string,a:string)=>`<div class="min-h-[11rem] rounded-xl border border-primary-100 bg-primary-50 p-5 text-center dark:border-primary-800/30 dark:bg-primary-900/20"><div class="text-sm text-gray-600 dark:text-gray-300">${l}</div><div class="mt-2 text-4xl font-bold text-primary-600 dark:text-primary-400">${v}</div><div class="mt-2 text-sm text-gray-500">${d}</div></div><div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300">${a}</div>`;
document.querySelectorAll<HTMLElement>('.roth-tool').forEach(r=>{const o=r.querySelector('.rt-result')as HTMLElement,i=o.innerHTML,render=()=>{if(!get(r,'.rt-monthly')||!get(r,'.rt-years')||!get(r,'.rt-return')){o.innerHTML=i;return}try{const v=calculateRoth401k({currentBalance:get(r,'.rt-balance'),monthlyContribution:get(r,'.rt-monthly'),years:get(r,'.rt-years'),annualReturnPercent:get(r,'.rt-return'),ageGroup:get(r,'.rt-age')});o.innerHTML=card('Projected Roth balance',money(v.endingBalance),`New contributions: ${money(v.contributions)} · modeled growth: ${money(v.growth)}`,`<strong>2026 limit context:</strong> ${money(v.annualContribution)} annual employee deferral versus ${money(v.limit)} selected limit${v.overLimit?' — entered amount exceeds this limit.':'.'} Returns are hypothetical.`)}catch(e){o.innerHTML=warning(e instanceof Error?e.message:'Check the retirement inputs.')}};r.addEventListener('input',render);r.addEventListener('change',render);r.querySelector('.rt-reset')?.addEventListener('click',()=>{for(const[s,v]of[['.rt-balance','0'],['.rt-monthly',''],['.rt-years',''],['.rt-return','']])(r.querySelector(s)as HTMLInputElement).value=v;(r.querySelector('.rt-age')as HTMLSelectElement).value='under50';render()})});
document.querySelectorAll<HTMLElement>('.schd-tool').forEach(r=>{const o=r.querySelector('.sc-result')as HTMLElement,i=o.innerHTML,render=()=>{if(!get(r,'.sc-initial')||!get(r,'.sc-years')||!get(r,'.sc-return')||!get(r,'.sc-yield')){o.innerHTML=i;return}try{const v=calculateSchdScenario({initialInvestment:get(r,'.sc-initial'),monthlyInvestment:get(r,'.sc-monthly'),years:get(r,'.sc-years'),annualTotalReturnPercent:get(r,'.sc-return'),forwardYieldPercent:get(r,'.sc-yield')});o.innerHTML=card('Projected scenario value',money(v.endingValue),`Added contributions: ${money(v.contributions)} · modeled growth: ${money(v.growth)}`,`<strong>Income context:</strong> At the entered yield, the ending value implies about ${money(v.estimatedAnnualDividends)} per year. This is not a forecast or live SCHD data.`)}catch(e){o.innerHTML=warning(e instanceof Error?e.message:'Check the scenario inputs.')}};r.addEventListener('input',render);r.querySelector('.sc-reset')?.addEventListener('click',()=>{for(const[s,v]of[['.sc-initial',''],['.sc-monthly','0'],['.sc-years',''],['.sc-return',''],['.sc-yield','']])(r.querySelector(s)as HTMLInputElement).value=v;render()})});
document.querySelectorAll<HTMLElement>('.tire-tool').forEach(r=>{const o=r.querySelector('.tp-result')as HTMLElement,i=o.innerHTML,sync=()=>{const metric=get(r,'.tp-unit')==='kpa';r.querySelectorAll<HTMLElement>('.tp-pressure-unit').forEach(n=>n.textContent=metric?'(kPa)':'(psi)');r.querySelectorAll<HTMLElement>('.tp-temp-unit').forEach(n=>n.textContent=metric?'(°C)':'(°F)')},render=()=>{if(get(r,'.tp-pressure')===''||get(r,'.tp-from')===''||get(r,'.tp-to')===''){o.innerHTML=i;return}try{const v=calculateTirePressureTemperature({unitSystem:get(r,'.tp-unit'),measuredPressure:get(r,'.tp-pressure'),measuredTemperature:get(r,'.tp-from'),targetTemperature:get(r,'.tp-to')});const sign=v.pressureChange>=0?'+':'';o.innerHTML=card('Estimated gauge pressure',`${v.estimatedPressure.toFixed(1)} ${v.unit}`,`Estimated change: ${sign}${v.pressureChange.toFixed(1)} ${v.unit}`,'<strong>Safety context:</strong> This constant-volume physics estimate does not set the correct tire pressure. Check and adjust cold tires to the vehicle door-placard value.') }catch(e){o.innerHTML=warning(e instanceof Error?e.message:'Check the pressure and temperatures.')}};r.addEventListener('input',render);r.addEventListener('change',e=>{if((e.target as Element).matches('.tp-unit')){for(const s of['.tp-pressure','.tp-from','.tp-to'])(r.querySelector(s)as HTMLInputElement).value='';sync()}render()});r.querySelector('.tp-reset')?.addEventListener('click',()=>{(r.querySelector('.tp-unit')as HTMLSelectElement).value='psi';for(const s of['.tp-pressure','.tp-from','.tp-to'])(r.querySelector(s)as HTMLInputElement).value='';sync();render()});sync()});
document.querySelectorAll<HTMLElement>('.partial-tool').forEach(r=>{const o=r.querySelector('.pd-result')as HTMLElement,i=o.innerHTML,render=()=>{if(!get(r,'.pd-expression')){o.innerHTML=i;return}try{const v=calculatePartialDerivative({expression:get(r,'.pd-expression'),variable:get(r,'.pd-variable'),xValue:get(r,'.pd-x'),yValue:get(r,'.pd-y')});const detail=v.value===null?'Enter both x and y to evaluate the derivative at a point.':`At the entered point: ${v.value.toLocaleString(undefined,{maximumFractionDigits:8})}`;o.innerHTML=card(`Partial derivative with respect to ${get(r,'.pd-variable')}`,v.derivativeExpression,detail,'<strong>Scope context:</strong> Verified for sums of x/y polynomial terms with nonnegative integer exponents. Unsupported function types are rejected, not approximated.') }catch(e){o.innerHTML=warning(e instanceof Error?e.message:'Check the polynomial syntax.')}};r.addEventListener('input',render);r.addEventListener('change',render);r.querySelector('.pd-reset')?.addEventListener('click',()=>{for(const s of['.pd-expression','.pd-x','.pd-y'])(r.querySelector(s)as HTMLInputElement).value='';(r.querySelector('.pd-variable')as HTMLSelectElement).value='x';render()})});
document.querySelectorAll<HTMLElement>('.edpi-tool').forEach(r=>{const o=r.querySelector('.ed-result')as HTMLElement,i=o.innerHTML,render=()=>{if(!get(r,'.ed-dpi')||get(r,'.ed-sensitivity')===''){o.innerHTML=i;return}try{const v=calculateEdpi({mouseDpi:get(r,'.ed-dpi'),inGameSensitivity:get(r,'.ed-sensitivity'),targetDpi:get(r,'.ed-target')});const detail=v.equivalentSensitivity===null?'Add a target DPI to calculate an equivalent sensitivity.':`Equivalent sensitivity at target DPI: ${v.equivalentSensitivity.toFixed(4)}`;o.innerHTML=card('Effective DPI',v.edpi.toLocaleString(undefined,{maximumFractionDigits:4}),detail,'<strong>Comparison context:</strong> eDPI compares settings only within the same game and sensitivity scale; it does not standardize yaw, FOV, ADS multipliers, acceleration, or raw-input behavior.') }catch(e){o.innerHTML=warning(e instanceof Error?e.message:'Check the mouse settings.')}};r.addEventListener('input',render);r.querySelector('.ed-reset')?.addEventListener('click',()=>{for(const s of['.ed-dpi','.ed-sensitivity','.ed-target'])(r.querySelector(s)as HTMLInputElement).value='';render()})});
</script>
