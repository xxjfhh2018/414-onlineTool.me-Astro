<div class="max-w-lg mx-auto">
  <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-6 space-y-5">
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Principal Amount ($)</label>
      <input id="bac-amount" type="number" placeholder="100000" 
             class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Term (days)</label>
      <input id="bac-term" type="number" placeholder="90" 
             class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Commission Rate (%)</label>
      <input id="bac-rate" type="number" step="0.01" placeholder="1.5" 
             class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" />
    </div>
    
    <button id="bac-calc" class="w-full px-4 py-3 rounded-xl bg-primary-500 text-white font-medium hover:bg-primary-600 transition-colors">
      Calculate BAC
    </button>
    
    <div id="bac-result" class="hidden p-5 rounded-xl bg-primary-50 dark:bg-primary-900/20 text-center">
      <div class="text-sm text-gray-500 dark:text-gray-400">Banker's Acceptance Commission</div>
      <div id="bac-value" class="text-3xl font-bold text-primary-600 dark:text-primary-400 mt-1">$0.00</div>
    </div>
  </div>
</div>

<script>
  (function() {
    const amount = document.getElementById('bac-amount') as HTMLInputElement;
    const term = document.getElementById('bac-term') as HTMLInputElement;
    const rate = document.getElementById('bac-rate') as HTMLInputElement;
    const calcBtn = document.getElementById('bac-calc');
    const result = document.getElementById('bac-result');
    const value = document.getElementById('bac-value');
    
    calcBtn?.addEventListener('click', () => {
      const p = parseFloat(amount?.value || '0');
      const t = parseFloat(term?.value || '0');
      const r = parseFloat(rate?.value || '0');
      
      if (p > 0 && t > 0 && r >= 0) {
        const bac = p * (r / 100) * (t / 360);
        if (value) value.textContent = '$' + bac.toFixed(2);
        result?.classList.remove('hidden');
      }
    });
  })();
</script>
