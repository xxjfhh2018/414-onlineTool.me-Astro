---
import FormulaToolShell from './templates/FormulaToolShell.astro';
---
<div class="partial-fraction-tool">
  <FormulaToolShell inputTitle="Decompose a Proper Rational Expression" inputDescription="Enter coefficients for (mx + n) / (ax² + bx + c). The real-number form updates automatically.">
    <div slot="inputs" class="space-y-4">
      <div class="rounded-xl bg-gray-50 p-4 text-center font-mono text-sm dark:bg-white/5">(<input class="pf-m coefficient" aria-label="Numerator x coefficient" type="number" step="any" value="1">x + <input class="pf-n coefficient" aria-label="Numerator constant" type="number" step="any" value="0">) / (<input class="pf-a coefficient" aria-label="Denominator x squared coefficient" type="number" step="any" value="1">x² + <input class="pf-b coefficient" aria-label="Denominator x coefficient" type="number" step="any" value="-5">x + <input class="pf-c coefficient" aria-label="Denominator constant" type="number" step="any" value="6">)</div>
      <p class="text-center text-xs text-gray-500">Scope: a linear numerator over a quadratic denominator. The numerator must already be proper.</p>
    </div>
    <div slot="result" class="pf-result"></div>
    <div slot="reference" class="mt-5 flex justify-center"><button type="button" class="pf-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10">Reset</button></div>
  </FormulaToolShell>
</div>
<style>.coefficient{width:4.5rem;border:1px solid rgb(229 231 235);border-radius:.5rem;padding:.45rem;text-align:center;background:transparent}.dark .coefficient{border-color:rgb(255 255 255/.1)}</style>
<script>
  import { decomposePartialFraction } from '../../lib/dailyBatch260811.mjs';
  document.querySelectorAll<HTMLElement>('.partial-fraction-tool').forEach(root=>{if(root.dataset.ready)return;root.dataset.ready='true';const result=root.querySelector('.pf-result') as HTMLElement;const get=(s:string)=>(root.querySelector(s) as HTMLInputElement).value;const fmt=(n:number)=>Math.abs(n)<1e-10?'0':Number(n.toPrecision(8)).toString();const factor=(rootValue:number)=>rootValue<0?`(x + ${fmt(Math.abs(rootValue))})`:`(x − ${fmt(rootValue)})`;const firstTerm=(coefficient:number,denominator:string)=>`${coefficient<0?'− ':''}${fmt(Math.abs(coefficient))} / ${denominator}`;const nextTerm=(coefficient:number,denominator:string)=>`${coefficient<0?' − ':' + '}${fmt(Math.abs(coefficient))} / ${denominator}`;function render(){try{const value=decomposePartialFraction({numeratorX:get('.pf-m'),numeratorConstant:get('.pf-n'),denominatorX2:get('.pf-a'),denominatorX:get('.pf-b'),denominatorConstant:get('.pf-c')});let answer='';let check='';if(value.type==='distinct-real'){answer=firstTerm(value.coefficient1,factor(value.root1))+nextTerm(value.coefficient2,factor(value.root2));check='Two distinct real factors were found.';}else if(value.type==='repeated-real'){const denominator=factor(value.root);answer=firstTerm(value.coefficient1,denominator)+nextTerm(value.coefficient2,`${denominator}²`);check='A repeated real factor was found.';}else{answer='No real linear partial-fraction decomposition';check='The quadratic is irreducible over the real numbers.';}result.innerHTML=`<div class="min-h-[11rem] rounded-xl border border-primary-100 bg-primary-50 p-5 flex flex-col items-center justify-center text-center dark:border-primary-800/30 dark:bg-primary-900/20"><div class="text-sm text-gray-600 dark:text-gray-300">Decomposition</div><div class="mt-3 break-words font-mono text-xl font-bold text-primary-700 dark:text-primary-300">${answer}</div><div class="mt-3 text-xs text-gray-500">${check}</div></div><div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10"><strong>Verification anchor:</strong> Combining the displayed terms reproduces the entered numerator and denominator within floating-point rounding.</div>`;}catch(error){result.innerHTML=`<div class="min-h-[11rem] rounded-xl border border-amber-200 bg-amber-50 p-4 flex items-center justify-center text-sm text-amber-800 dark:border-amber-800/40 dark:bg-amber-900/10 dark:text-amber-300">${error instanceof Error?error.message:'Check the coefficients.'}</div>`;}}root.addEventListener('input',render);root.querySelector('.pf-reset')?.addEventListener('click',()=>{for(const [selector,value] of [['.pf-m','1'],['.pf-n','0'],['.pf-a','1'],['.pf-b','-5'],['.pf-c','6']]) (root.querySelector(selector) as HTMLInputElement).value=value;render();});render();});
</script>
