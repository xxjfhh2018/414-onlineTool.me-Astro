---
import FormulaToolShell from './templates/FormulaToolShell.astro';
const { course } = Astro.props;
const field = 'mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5';
const placeholder = 'min-h-[11rem] rounded-xl border border-dashed border-gray-300 bg-gray-50/70 p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:border-white/15 dark:bg-white/[0.03]';
---

{course === 'audiobook-calculator' && <div class="audiobook-tool"><FormulaToolShell inputTitle="Calculate Audiobook Listening Time" inputDescription="Enter the original duration and playback speed to see the adjusted listening time and time saved.">
  <div slot="inputs" class="grid gap-4 sm:grid-cols-3"><label class="text-sm font-medium">Original hours<input class:list={[field,'ab-hours']} type="number" min="0" step="1" inputmode="numeric" placeholder="10" /></label><label class="text-sm font-medium">Additional minutes<input class:list={[field,'ab-minutes']} type="number" min="0" max="59" step="1" inputmode="numeric" value="0" /></label><label class="text-sm font-medium">Playback speed (×)<input class:list={[field,'ab-speed']} type="number" min="0.25" max="4" step="0.05" inputmode="decimal" value="1.5" /></label></div>
  <div slot="result" class="ab-result"><div class={placeholder}>Your adjusted listening time and time saved will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="ab-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div>
</FormulaToolShell></div>}

{course === 'rpm-calculator' && <div class="rpm-tool"><FormulaToolShell inputTitle="Calculate Revolutions per Minute" inputDescription="Enter a revolution count and elapsed time to get RPM, hertz, angular speed, and cycle time.">
  <div slot="inputs" class="grid gap-4 sm:grid-cols-3"><label class="text-sm font-medium">Revolutions<input class:list={[field,'rpm-revolutions']} type="number" min="0" step="0.01" inputmode="decimal" placeholder="120" /></label><label class="text-sm font-medium">Elapsed time<input class:list={[field,'rpm-time']} type="number" min="0.000001" step="0.01" inputmode="decimal" placeholder="30" /></label><label class="text-sm font-medium">Time unit<select class:list={[field,'rpm-unit']}><option value="seconds">Seconds</option><option value="minutes">Minutes</option><option value="hours">Hours</option></select></label></div>
  <div slot="result" class="rpm-result"><div class={placeholder}>RPM and equivalent rotational-frequency values will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="rpm-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div>
</FormulaToolShell></div>}

{course === 'foc-calculator' && <div class="foc-tool"><FormulaToolShell inputTitle="Calculate Arrow Front of Center" inputDescription="Measure from the bottom of the nock groove to the shaft end and to the finished arrow's balance point.">
  <div slot="inputs" class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-medium">Correct arrow length<input class:list={[field,'foc-length']} type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="28" /><span class="mt-1 block text-xs text-gray-500">Use inches or centimetres consistently.</span></label><label class="text-sm font-medium">Balance point from nock groove<input class:list={[field,'foc-balance']} type="number" min="0" step="0.01" inputmode="decimal" placeholder="17" /><span class="mt-1 block text-xs text-gray-500">Measure the finished arrow with point, nock, and fletching installed.</span></label></div>
  <div slot="result" class="foc-result"><div class={placeholder}>Your FOC percentage and balance offset will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="foc-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div>
</FormulaToolShell></div>}

{course === 'circle-skirt-calculator' && <div class="circle-skirt-tool"><FormulaToolShell inputTitle="Draft Circle Skirt Radii" inputDescription="Enter the waistline measurement, finished skirt length, and fullness to get the waist and hem-line radii.">
  <div slot="inputs" class="grid gap-4 sm:grid-cols-3"><label class="text-sm font-medium">Waistline circumference<input class:list={[field,'cs-waist']} type="number" min="0.01" step="0.1" inputmode="decimal" placeholder="30" /><span class="mt-1 block text-xs text-gray-500">Use inches or centimetres consistently.</span></label><label class="text-sm font-medium">Finished skirt length<input class:list={[field,'cs-length']} type="number" min="0.01" step="0.1" inputmode="decimal" placeholder="24" /></label><label class="text-sm font-medium">Skirt fullness<select class:list={[field,'cs-fullness']}><option value="full">Full circle</option><option value="three-quarter">Three-quarter circle</option><option value="half">Half circle</option><option value="quarter">Quarter circle</option></select></label></div>
  <div slot="result" class="cs-result"><div class={placeholder}>Your waist radius and outer hem-line radius will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="cs-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div>
</FormulaToolShell></div>}

{course === 'linear-interpolation-calculator' && <div class="interpolation-tool"><FormulaToolShell inputTitle="Interpolate Between Two Points" inputDescription="Enter two known coordinate pairs and a target x value to estimate y on the straight line between them.">
  <div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5"><label class="text-sm font-medium">First x (x₁)<input class:list={[field,'li-x1']} type="number" step="any" inputmode="decimal" placeholder="10" /></label><label class="text-sm font-medium">First y (y₁)<input class:list={[field,'li-y1']} type="number" step="any" inputmode="decimal" placeholder="100" /></label><label class="text-sm font-medium">Second x (x₂)<input class:list={[field,'li-x2']} type="number" step="any" inputmode="decimal" placeholder="20" /></label><label class="text-sm font-medium">Second y (y₂)<input class:list={[field,'li-y2']} type="number" step="any" inputmode="decimal" placeholder="200" /></label><label class="text-sm font-medium">Target x<input class:list={[field,'li-target']} type="number" step="any" inputmode="decimal" placeholder="15" /></label></div>
  <div slot="result" class="li-result"><div class={placeholder}>The interpolated y value, slope, and interval position will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="li-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div>
</FormulaToolShell></div>}

<script>
  import { calculateAudiobook, calculateCircleSkirt, calculateFoc, calculateLinearInterpolation, calculateRpm } from '../../lib/dailyBatch260813.mjs';
  const get=(root:HTMLElement,s:string)=>(root.querySelector(s) as HTMLInputElement|HTMLSelectElement).value;
  const warning=(message:string)=>`<div class="min-h-[11rem] rounded-xl border border-amber-200 bg-amber-50 p-4 flex items-center justify-center text-center text-sm text-amber-800 dark:border-amber-800/40 dark:bg-amber-900/10 dark:text-amber-300">${message}</div>`;
  const card=(label:string,value:string,detail:string,anchor:string)=>`<div class="min-h-[11rem] rounded-xl border border-primary-100 bg-primary-50 p-5 text-center dark:border-primary-800/30 dark:bg-primary-900/20"><div class="text-sm text-gray-600 dark:text-gray-300">${label}</div><div class="mt-2 text-4xl font-bold text-primary-600 dark:text-primary-400">${value}</div><div class="mt-2 text-sm text-gray-500">${detail}</div></div><div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300">${anchor}</div>`;
  const time=(minutes:number)=>{const total=Math.round(minutes);return `${Math.floor(total/60)} hr ${total%60} min`;};
  document.querySelectorAll<HTMLElement>('.audiobook-tool').forEach(root=>{const result=root.querySelector('.ab-result') as HTMLElement,initial=result.innerHTML;const render=()=>{const hours=get(root,'.ab-hours'),minutes=get(root,'.ab-minutes');if(hours===''&&(minutes===''||minutes==='0')){result.innerHTML=initial;return;}try{const v=calculateAudiobook({hours:hours||0,minutes:minutes||0,playbackSpeed:get(root,'.ab-speed')});const saved=v.timeSavedMinutes>=0?`${time(v.timeSavedMinutes)} saved`:`${time(Math.abs(v.timeSavedMinutes))} longer`;result.innerHTML=card('Adjusted listening time',time(v.adjustedMinutes),`${saved} · original ${time(v.originalMinutes)}`,`<strong>Speed context:</strong> ${v.speed.toFixed(2)}× changes playback duration only; pauses, chapter gaps, and app-specific processing are excluded.`);}catch(e){result.innerHTML=warning(e instanceof Error?e.message:'Check the duration and speed.');}};root.addEventListener('input',render);root.querySelector('.ab-reset')?.addEventListener('click',()=>{(root.querySelector('.ab-hours') as HTMLInputElement).value='';(root.querySelector('.ab-minutes') as HTMLInputElement).value='0';(root.querySelector('.ab-speed') as HTMLInputElement).value='1.5';render();});});
  document.querySelectorAll<HTMLElement>('.rpm-tool').forEach(root=>{const result=root.querySelector('.rpm-result') as HTMLElement,initial=result.innerHTML;const render=()=>{if(!get(root,'.rpm-revolutions')||!get(root,'.rpm-time')){result.innerHTML=initial;return;}try{const v=calculateRpm({revolutions:get(root,'.rpm-revolutions'),time:get(root,'.rpm-time'),timeUnit:get(root,'.rpm-unit')});const period=Number.isFinite(v.secondsPerRevolution)?`${v.secondsPerRevolution.toFixed(4)} s/rev`:'No completed rotation rate';result.innerHTML=card('Rotational speed',`${v.rpm.toFixed(2)} RPM`,`${v.hertz.toFixed(4)} Hz · ${v.radiansPerSecond.toFixed(4)} rad/s · ${period}`,'<strong>Rate context:</strong> RPM is the average revolution count per minute across the entered interval, not an instantaneous tachometer reading.');}catch(e){result.innerHTML=warning(e instanceof Error?e.message:'Check the revolution and time values.');}};root.addEventListener('input',render);root.addEventListener('change',render);root.querySelector('.rpm-reset')?.addEventListener('click',()=>{(root.querySelector('.rpm-revolutions') as HTMLInputElement).value='';(root.querySelector('.rpm-time') as HTMLInputElement).value='';(root.querySelector('.rpm-unit') as HTMLSelectElement).value='seconds';render();});});
  document.querySelectorAll<HTMLElement>('.foc-tool').forEach(root=>{const result=root.querySelector('.foc-result') as HTMLElement,initial=result.innerHTML;const render=()=>{if(!get(root,'.foc-length')||!get(root,'.foc-balance')){result.innerHTML=initial;return;}try{const v=calculateFoc({arrowLength:get(root,'.foc-length'),balancePoint:get(root,'.foc-balance')});const context=v.focPercent>=10&&v.focPercent<=15?'within Easton’s 10–15% hunting recommendation':v.focPercent<10?'below Easton’s 10–15% hunting recommendation':'above Easton’s 10–15% hunting recommendation';result.innerHTML=card('Arrow FOC',`${v.focPercent.toFixed(2)}%`,`Midpoint: ${v.midpoint.toFixed(2)} · balance is ${v.forwardDistance.toFixed(2)} units forward`,`<strong>Balance context:</strong> This result is ${context}. Tuning needs depend on the complete bow-and-arrow setup.`);}catch(e){result.innerHTML=warning(e instanceof Error?e.message:'Check arrow measurements.');}};root.addEventListener('input',render);root.querySelector('.foc-reset')?.addEventListener('click',()=>{(root.querySelector('.foc-length') as HTMLInputElement).value='';(root.querySelector('.foc-balance') as HTMLInputElement).value='';render();});});
  document.querySelectorAll<HTMLElement>('.circle-skirt-tool').forEach(root=>{const result=root.querySelector('.cs-result') as HTMLElement,initial=result.innerHTML;const labels={full:'Full circle','three-quarter':'Three-quarter circle',half:'Half circle',quarter:'Quarter circle'};const render=()=>{if(!get(root,'.cs-waist')||!get(root,'.cs-length')){result.innerHTML=initial;return;}try{const fullness=get(root,'.cs-fullness');const v=calculateCircleSkirt({waistCircumference:get(root,'.cs-waist'),skirtLength:get(root,'.cs-length'),fullness});result.innerHTML=card('Waistline radius',v.waistRadius.toFixed(2),`Outer hem-line radius: ${v.outerRadius.toFixed(2)} · ${v.arcAngle}° pattern arc`,`<strong>Drafting context:</strong> ${labels[fullness as keyof typeof labels]} geometry. Add seam and hem allowances separately before cutting and test the pattern first.`);}catch(e){result.innerHTML=warning(e instanceof Error?e.message:'Check the skirt measurements.');}};root.addEventListener('input',render);root.addEventListener('change',render);root.querySelector('.cs-reset')?.addEventListener('click',()=>{(root.querySelector('.cs-waist') as HTMLInputElement).value='';(root.querySelector('.cs-length') as HTMLInputElement).value='';(root.querySelector('.cs-fullness') as HTMLSelectElement).value='full';render();});});
  document.querySelectorAll<HTMLElement>('.interpolation-tool').forEach(root=>{const result=root.querySelector('.li-result') as HTMLElement,initial=result.innerHTML;const selectors=['.li-x1','.li-y1','.li-x2','.li-y2','.li-target'];const render=()=>{if(selectors.some(s=>get(root,s)==='')){result.innerHTML=initial;return;}try{const v=calculateLinearInterpolation({x1:get(root,'.li-x1'),y1:get(root,'.li-y1'),x2:get(root,'.li-x2'),y2:get(root,'.li-y2'),targetX:get(root,'.li-target')});const context=v.isExtrapolation?'outside the two known x values, so this is linear extrapolation':'inside the two known x values';result.innerHTML=card('Estimated y',v.y.toLocaleString(undefined,{maximumFractionDigits:8}),`Slope: ${v.slope.toLocaleString(undefined,{maximumFractionDigits:8})} · interval position: ${(v.position*100).toFixed(2)}%`,`<strong>Range context:</strong> The target is ${context}. The result assumes a straight-line relationship.`);}catch(e){result.innerHTML=warning(e instanceof Error?e.message:'Check the coordinate values.');}};root.addEventListener('input',render);root.querySelector('.li-reset')?.addEventListener('click',()=>{selectors.forEach(s=>(root.querySelector(s) as HTMLInputElement).value='');render();});});
</script>
