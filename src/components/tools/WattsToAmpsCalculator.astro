---
import FormulaToolShell from './templates/FormulaToolShell.astro';
---
<div class="watts-amps-tool">
  <FormulaToolShell inputTitle="Convert Watts to Amps" inputDescription="Enter circuit type, real power, voltage, and AC power factor to calculate current.">
    <div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Circuit type<select class="wa-phase mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5"><option value="dc">DC</option><option value="single">Single-phase AC</option><option value="three">Balanced three-phase AC</option></select></label>
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Real power (W)<input class="wa-watts mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" min="0.01" step="0.01" placeholder="1200"></label>
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Voltage (V)<input class="wa-volts mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" min="0.01" step="0.01" placeholder="120"></label>
      <label class="wa-pf-label text-sm font-medium text-gray-400">Power factor<input class="wa-pf mt-2 w-full rounded-xl border border-gray-200 bg-gray-100 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" min="0.01" max="1" step="0.01" value="1" disabled><span class="mt-1 block text-xs">Used for AC only</span></label>
    </div>
    <div slot="reference" class="mt-5 flex justify-center gap-3"><button class="wa-calculate min-h-11 rounded-xl bg-primary-500 px-6 py-2.5 text-sm font-semibold text-white" type="button">Calculate</button><button class="wa-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div>
    <div slot="result" class="wa-result"><div class="min-h-[11rem] rounded-xl border border-dashed border-gray-300 bg-gray-50/70 p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:border-white/15 dark:bg-white/[0.03]">Calculated current and the applied circuit assumptions will appear here.</div></div>
  </FormulaToolShell>
</div>
<script>
  import { calculateWattsToAmps } from '../../lib/dailyBatchCalculators.mjs';
  document.querySelectorAll<HTMLElement>('.watts-amps-tool').forEach(root=>{if(root.dataset.ready)return;root.dataset.ready='true';const phase=root.querySelector('.wa-phase') as HTMLSelectElement;const pf=root.querySelector('.wa-pf') as HTMLInputElement;const result=root.querySelector('.wa-result') as HTMLElement;const placeholder=result.innerHTML;const value=(s:string)=>(root.querySelector(s) as HTMLInputElement).value;const sync=()=>{pf.disabled=phase.value==='dc';pf.closest('label')?.classList.toggle('text-gray-400',pf.disabled);pf.classList.toggle('bg-gray-100',pf.disabled);};const render=(force=false)=>{if((!value('.wa-watts')||!value('.wa-volts'))&&!force){result.innerHTML=placeholder;return;}try{const data=calculateWattsToAmps({phase:phase.value,watts:value('.wa-watts'),volts:value('.wa-volts'),powerFactor:pf.value});const mode=data.phase==='dc'?'DC':data.phase==='single'?'single-phase AC':'balanced three-phase AC';result.innerHTML=`<div class="rounded-xl border border-primary-100 bg-primary-50 p-6 text-center dark:border-primary-800/30 dark:bg-primary-900/20"><div class="text-sm text-gray-600">Calculated current</div><div class="mt-1 text-5xl font-bold text-primary-600 dark:text-primary-400">${data.amps<1?data.amps.toFixed(3):data.amps.toFixed(2)} A</div><div class="mt-2 text-xs text-gray-500">${mode} · ${data.watts.toLocaleString()} W · ${data.volts.toLocaleString()} V${data.phase==='dc'?'':` · PF ${data.powerFactor}`}</div></div><div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300"><strong>Electrical context:</strong> Compare this calculated operating current with equipment nameplate data. Do not use it alone to size conductors, protection, or safety equipment.</div>`;}catch(error){result.innerHTML=`<div class="min-h-[11rem] rounded-xl border border-amber-200 bg-amber-50 p-4 flex items-center justify-center text-center text-sm text-amber-800">${error instanceof Error?error.message:'Unable to calculate current.'}</div>`;}};phase.addEventListener('change',()=>{sync();render();});root.addEventListener('input',()=>render());root.querySelector('.wa-calculate')?.addEventListener('click',()=>render(true));root.querySelector('.wa-reset')?.addEventListener('click',()=>{phase.value='dc';(root.querySelector('.wa-watts') as HTMLInputElement).value='';(root.querySelector('.wa-volts') as HTMLInputElement).value='';pf.value='1';sync();result.innerHTML=placeholder;});sync();});
</script>
