---
import MultiRowToolShell from './templates/MultiRowToolShell.astro';
---

<div class="max-w-4xl mx-auto" id="grade-calculator-tool">
  <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 overflow-hidden">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 p-4 sm:p-6 border-b border-gray-100 dark:border-white/5" role="tablist" aria-label="Grade calculator modes">
      <button type="button" class="gc-tab rounded-xl px-4 py-3 text-sm font-semibold bg-primary-500 text-white" data-mode="points" role="tab" aria-selected="true">Points Grade</button>
      <button type="button" class="gc-tab rounded-xl px-4 py-3 text-sm font-semibold bg-gray-100 dark:bg-white/5 text-gray-700 dark:text-gray-300" data-mode="weighted" role="tab" aria-selected="false">Weighted Grade</button>
      <button type="button" class="gc-tab rounded-xl px-4 py-3 text-sm font-semibold bg-gray-100 dark:bg-white/5 text-gray-700 dark:text-gray-300" data-mode="final" role="tab" aria-selected="false">Final Grade Needed</button>
    </div>

    <section class="gc-panel p-4 sm:p-6" data-panel="points">
      <MultiRowToolShell embedded inputTitle="Calculate a Grade by Points" inputDescription="Enter the points earned and points possible for each assignment or exam." tableLabel="Points grade items">
        <table slot="table" class="w-full min-w-[520px]">
          <thead><tr class="text-left text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400"><th class="pb-2 pr-3 font-medium">Item</th><th class="pb-2 px-3 font-medium w-32">Earned</th><th class="pb-2 px-3 font-medium w-32">Possible</th><th class="pb-2 pl-3 w-12"><span class="sr-only">Remove</span></th></tr></thead>
          <tbody id="gc-points-rows"></tbody>
        </table>
        <button slot="controls" id="gc-add-points" type="button" class="px-4 py-2.5 rounded-xl bg-gray-100 dark:bg-white/5 text-sm font-medium text-gray-700 dark:text-gray-300">+ Add Item</button>
        <div slot="result" id="gc-points-result"><div class="min-h-[9rem] rounded-xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-5 flex flex-col items-center justify-center text-center"><div class="text-sm font-medium text-gray-700 dark:text-gray-300">Your points grade will appear here</div><div class="mt-1 text-xs text-gray-500 dark:text-gray-400">Enter earned and possible points to calculate automatically.</div></div></div>
      </MultiRowToolShell>
    </section>

    <section class="gc-panel hidden p-4 sm:p-6" data-panel="weighted">
      <MultiRowToolShell embedded inputTitle="Weighted Grade Calculator" inputDescription="Enter each category grade and its share of the course grade." tableLabel="Weighted grade categories">
        <table slot="table" class="w-full min-w-[520px]">
          <thead><tr class="text-left text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400"><th class="pb-2 pr-3 font-medium">Category</th><th class="pb-2 px-3 font-medium w-36">Grade (%)</th><th class="pb-2 px-3 font-medium w-36">Weight (%)</th><th class="pb-2 pl-3 w-12"><span class="sr-only">Remove</span></th></tr></thead>
          <tbody id="gc-weight-rows"></tbody>
        </table>
        <button slot="controls" id="gc-add-weight" type="button" class="px-4 py-2.5 rounded-xl bg-gray-100 dark:bg-white/5 text-sm font-medium text-gray-700 dark:text-gray-300">+ Add Category</button>
        <div slot="result" id="gc-weight-result"><div class="min-h-[9rem] rounded-xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-5 flex flex-col items-center justify-center text-center"><div class="text-sm font-medium text-gray-700 dark:text-gray-300">Your weighted grade will appear here</div><div class="mt-1 text-xs text-gray-500 dark:text-gray-400">Enter a category grade and weight to calculate automatically.</div></div></div>
      </MultiRowToolShell>
    </section>

    <section class="gc-panel hidden p-4 sm:p-6" data-panel="final">
      <div class="mb-5"><h2 class="text-lg font-semibold text-gray-900 dark:text-white">What Grade Do I Need on My Final?</h2><p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Use your current grade, target grade, and the final exam weight to find the required exam score.</p></div>
      <div class="grid md:grid-cols-3 gap-4">
        <div><label for="gc-current-grade" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Current grade (%)</label><input id="gc-current-grade" type="number" inputmode="decimal" min="0" step="0.01" placeholder="87" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" /></div>
        <div><label for="gc-target-grade" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Desired course grade (%)</label><input id="gc-target-grade" type="number" inputmode="decimal" min="0" step="0.01" placeholder="90" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" /></div>
        <div><label for="gc-final-weight" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Final exam weight (%)</label><input id="gc-final-weight" type="number" inputmode="decimal" min="0.01" max="100" step="0.01" placeholder="30" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" /></div>
      </div>
      <div id="gc-final-result" class="mt-5 min-h-[9rem]" aria-live="polite"><div class="min-h-[9rem] rounded-xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-5 flex flex-col items-center justify-center text-center"><div class="text-sm font-medium text-gray-700 dark:text-gray-300">Your required final grade will appear here</div><div class="mt-1 text-xs text-gray-500 dark:text-gray-400">Enter all three percentages to calculate automatically.</div></div></div>
    </section>
  </div>
  <p class="mt-4 text-xs leading-5 text-gray-500 dark:text-gray-400">Results use the percentages you enter. Letter-grade cutoffs, rounding, dropped assignments, extra credit, and course policies vary, so confirm the result against your syllabus or gradebook.</p>
</div>

<script>
  import { calculatePointsGrade, calculateRequiredFinal, calculateWeightedGrade } from '../../lib/gradeCalculator.mjs';

  (function () {
    const root = document.getElementById('grade-calculator-tool');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const pointsRows = root.querySelector('#gc-points-rows');
    const weightRows = root.querySelector('#gc-weight-rows');
    const pointsResult = root.querySelector('#gc-points-result') as HTMLElement;
    const weightResult = root.querySelector('#gc-weight-result') as HTMLElement;
    const finalResult = root.querySelector('#gc-final-result') as HTMLElement;
    const inputClass = 'w-full px-3 py-2.5 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-sm text-gray-800 dark:text-gray-200';
    const pointsPlaceholder = pointsResult.innerHTML;
    const weightPlaceholder = weightResult.innerHTML;
    const finalPlaceholder = finalResult.innerHTML;
    const warning = (message: string) => `<div class="min-h-[9rem] rounded-xl border border-amber-200 dark:border-amber-800/40 bg-amber-50 dark:bg-amber-900/10 p-4 flex items-center justify-center text-center text-sm text-amber-800 dark:text-amber-300">${message}</div>`;
    const summaryCard = (label: string, value: string, details: string) => `<div class="rounded-xl bg-primary-50 dark:bg-primary-900/20 border border-primary-100 dark:border-primary-800/30 p-5 text-center"><div class="text-sm text-gray-600 dark:text-gray-400">${label}</div><div class="mt-1 text-3xl font-bold text-primary-600 dark:text-primary-400">${value}</div><div class="mt-2 text-xs text-gray-500 dark:text-gray-400">${details}</div></div>`;

    function addPointsRow(name = '') {
      const row = document.createElement('tr');
      row.className = 'gc-row border-t border-gray-100 dark:border-white/5';
      row.innerHTML = `<td class="py-2.5 pr-3"><input aria-label="Item name" class="gc-item-name ${inputClass}" type="text" placeholder="Assignment" value="${name}"></td><td class="py-2.5 px-3"><input aria-label="Points earned" class="gc-earned ${inputClass}" type="number" inputmode="decimal" min="0" step="0.01" placeholder="85"></td><td class="py-2.5 px-3"><input aria-label="Points possible" class="gc-possible ${inputClass}" type="number" inputmode="decimal" min="0.01" step="0.01" placeholder="100"></td><td class="py-2.5 pl-3"><button type="button" class="gc-remove w-9 h-9 rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20" aria-label="Remove item">×</button></td>`;
      pointsRows?.appendChild(row);
    }

    function addWeightRow(name = '') {
      const row = document.createElement('tr');
      row.className = 'gc-row border-t border-gray-100 dark:border-white/5';
      row.innerHTML = `<td class="py-2.5 pr-3"><input aria-label="Category name" class="gc-category-name ${inputClass}" type="text" placeholder="Homework" value="${name}"></td><td class="py-2.5 px-3"><input aria-label="Category grade" class="gc-category-grade ${inputClass}" type="number" inputmode="decimal" min="0" step="0.01" placeholder="92"></td><td class="py-2.5 px-3"><input aria-label="Category weight" class="gc-category-weight ${inputClass}" type="number" inputmode="decimal" min="0.01" step="0.01" placeholder="30"></td><td class="py-2.5 pl-3"><button type="button" class="gc-remove w-9 h-9 rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20" aria-label="Remove category">×</button></td>`;
      weightRows?.appendChild(row);
    }

    function calculatePoints() {
      try {
        const calculated = calculatePointsGrade([...root.querySelectorAll('#gc-points-rows .gc-row')].map(row => ({ earned: (row.querySelector('.gc-earned') as HTMLInputElement).value.trim(), possible: (row.querySelector('.gc-possible') as HTMLInputElement).value.trim() })));
        pointsResult.innerHTML = calculated ? summaryCard('Overall grade', `${calculated.grade.toFixed(2)}%`, `${calculated.earnedTotal.toFixed(2)} of ${calculated.possibleTotal.toFixed(2)} points · common scale estimate: ${calculated.letterGrade}`) : pointsPlaceholder;
      } catch (error) { pointsResult.innerHTML = warning(error instanceof Error ? error.message : 'These rows could not be calculated.'); }
    }

    function calculateWeighted() {
      try {
        const calculated = calculateWeightedGrade([...root.querySelectorAll('#gc-weight-rows .gc-row')].map(row => ({ grade: (row.querySelector('.gc-category-grade') as HTMLInputElement).value.trim(), weight: (row.querySelector('.gc-category-weight') as HTMLInputElement).value.trim() })));
        if (!calculated) { weightResult.innerHTML = weightPlaceholder; return; }
        const status = calculated.isCompleteWeight ? 'Weights total 100%, so this is the complete weighted grade.' : `Weights total ${calculated.totalWeight.toFixed(2)}%. The normalized grade covers only the categories entered.`;
        weightResult.innerHTML = `<div class="grid sm:grid-cols-2 gap-3">${summaryCard('Normalized weighted grade', `${calculated.normalizedGrade.toFixed(2)}%`, `Common scale estimate: ${calculated.letterGrade}`)}${summaryCard('Contribution to course grade', `${calculated.weightedPoints.toFixed(2)} pts`, status)}</div>`;
      } catch (error) { weightResult.innerHTML = warning(error instanceof Error ? error.message : 'These categories could not be calculated.'); }
    }

    function calculateFinal() {
      const current = (root.querySelector('#gc-current-grade') as HTMLInputElement).value.trim();
      const target = (root.querySelector('#gc-target-grade') as HTMLInputElement).value.trim();
      const weight = (root.querySelector('#gc-final-weight') as HTMLInputElement).value.trim();
      if (!current || !target || !weight) { finalResult.innerHTML = finalPlaceholder; return; }
      try {
        const calculated = calculateRequiredFinal({ currentGrade: current, targetGrade: target, finalWeightPercent: weight });
        let note = `A 100% final would produce a maximum course grade of ${calculated.maximumCourseGrade.toFixed(2)}%.`;
        if (calculated.required <= 0) note = 'Your target is already secured even with a 0% on the final, assuming these inputs and no other work remains.';
        else if (calculated.required > 100) note = `This target requires more than 100%. A perfect final would produce ${calculated.maximumCourseGrade.toFixed(2)}%. Extra credit or another policy adjustment would be needed.`;
        finalResult.innerHTML = summaryCard('Grade needed on the final', `${calculated.displayedRequired.toFixed(2)}%`, note);
      } catch (error) { finalResult.innerHTML = warning(error instanceof Error ? error.message : 'These percentages could not be calculated.'); }
    }

    root.querySelectorAll<HTMLButtonElement>('.gc-tab').forEach(button => button.addEventListener('click', () => {
      const mode = button.dataset.mode;
      root.querySelectorAll<HTMLButtonElement>('.gc-tab').forEach(tab => { const active = tab === button; tab.setAttribute('aria-selected', String(active)); tab.classList.toggle('bg-primary-500', active); tab.classList.toggle('text-white', active); tab.classList.toggle('bg-gray-100', !active); tab.classList.toggle('dark:bg-white/5', !active); tab.classList.toggle('text-gray-700', !active); tab.classList.toggle('dark:text-gray-300', !active); });
      root.querySelectorAll<HTMLElement>('.gc-panel').forEach(panel => panel.classList.toggle('hidden', panel.dataset.panel !== mode));
    }));
    root.addEventListener('click', event => { const remove = (event.target as HTMLElement).closest<HTMLButtonElement>('.gc-remove'); if (!remove) return; const body = remove.closest('tbody'); remove.closest('tr')?.remove(); if (body && !body.children.length) body === pointsRows ? addPointsRow() : addWeightRow(); body === pointsRows ? calculatePoints() : calculateWeighted(); });
    root.querySelector('#gc-add-points')?.addEventListener('click', () => addPointsRow());
    root.querySelector('#gc-add-weight')?.addEventListener('click', () => addWeightRow());
    root.addEventListener('input', event => { const target = event.target as HTMLElement; if (target.closest('[data-panel="points"]')) calculatePoints(); else if (target.closest('[data-panel="weighted"]')) calculateWeighted(); else if (target.closest('[data-panel="final"]')) calculateFinal(); });
    addPointsRow('Assignment 1'); addPointsRow('Assignment 2'); addPointsRow('Exam');
    addWeightRow('Homework'); addWeightRow('Midterm'); addWeightRow('Final Exam');
  })();
</script>
