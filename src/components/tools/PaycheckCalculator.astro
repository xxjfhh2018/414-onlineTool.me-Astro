---
const { course = 'paycheck-calculator' } = Astro.props;
const stateBySlug: Record<string,string> = {
  'arkansas-paycheck-calculator':'ar','michigan-paycheck-calculator':'mi','washington-paycheck-calculator':'wa','indiana-paycheck-calculator':'in','maryland-paycheck-calculator':'md','virginia-paycheck-calculator':'va','illinois-paycheck-calculator':'il','missouri-paycheck-calculator':'mo'
};
const initialState = stateBySlug[course] || 'none';
const stateInfo: Record<string,{name:string,summary:string,source:string}> = {
  none:{name:'No state selected',summary:'Choose a state to include its 2026 wage-withholding model.',source:'https://www.irs.gov/publications/p15t'},
  ar:{name:'Arkansas',summary:'2026 planning model uses Arkansas’s published 3.9% current withholding rate. Official wage tables can differ.',source:'https://www.dfa.arkansas.gov/wp-content/uploads/withholdInstructions_2026.pdf'},
  mi:{name:'Michigan',summary:'2026 rate: 4.25%; personal exemption: $5,900 for each entered exemption.',source:'https://www.michigan.gov/taxes/business-taxes/withholding/calendar-year-tax-information'},
  wa:{name:'Washington',summary:'Washington has no individual wage income tax. Other state payroll programs are not included automatically.',source:'https://dor.wa.gov/taxes-rates/income-tax'},
  in:{name:'Indiana',summary:'2026 state rate: 2.95%; $1,000 per entered personal exemption. Enter the applicable county rate separately.',source:'https://www.in.gov/dor/files/dn01.pdf'},
  md:{name:'Maryland',summary:'Uses the 2024–2026 percentage-method structure plus an editable local rate; 3.05% is an example default.',source:'https://interactive.marylandtaxes.gov/business/calculators/WHCalc.asp'},
  va:{name:'Virginia',summary:'Uses Virginia tables for wages after July 1, 2025, including the standard deduction scheduled through tax year 2026.',source:'https://www.tax.virginia.gov/sites/default/files/vatax-pdf/employer-withholding-instructions.pdf'},
  il:{name:'Illinois',summary:'2026 rate: 4.95%; exemption allowance: $2,925 for each entered allowance.',source:'https://tax.illinois.gov/forms/withholding/currentyear/il-700-t-withholding-guide-tables.html'},
  mo:{name:'Missouri',summary:'Uses the official 2026 annual withholding brackets and standard deductions; state withholding is rounded to cents here.',source:'https://dor.mo.gov/forms/Withholding%20Formula_2026.pdf'}
};
const selectedInfo=stateInfo[initialState];
---
<div class="max-w-5xl mx-auto paycheck-tool" id={`paycheck-tool-${course}`} data-course={course} data-state={initialState}>
  <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-4 sm:p-6">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-5">
      <div><h2 class="text-lg font-semibold text-gray-900 dark:text-white">2026 Take-Home Pay Estimate</h2><p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">Reviewing a paycheck or job offer? Enter gross pay and filing details, then refine the estimate with deductions and state settings.</p></div>
      <span class="inline-flex self-start rounded-full bg-primary-50 dark:bg-primary-900/20 px-3 py-1 text-xs font-semibold text-primary-700 dark:text-primary-300">Tax year 2026</span>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div><label for={`pc-gross-${course}`} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Gross pay per period ($)</label><input id={`pc-gross-${course}`} data-field="gross" type="number" inputmode="decimal" min="0.01" max="10000000" step="0.01" placeholder="3000" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" /></div>
      <div><label for={`pc-frequency-${course}`} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Pay frequency</label><select id={`pc-frequency-${course}`} data-field="frequency" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200"><option value="52">Weekly</option><option value="26" selected>Biweekly</option><option value="24">Semimonthly</option><option value="12">Monthly</option><option value="1">Annual</option></select></div>
      <div><label for={`pc-filing-${course}`} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Federal filing status</label><select id={`pc-filing-${course}`} data-field="filing" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200"><option value="single">Single / married separately</option><option value="married">Married filing jointly</option><option value="head">Head of household</option></select></div>
      {initialState==='none' ? <div><label for={`pc-state-${course}`} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">State model</label><select id={`pc-state-${course}`} data-field="state" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200"><option value="none">No state income tax model</option>{Object.entries(stateInfo).filter(([key])=>key!=='none').map(([key,value])=><option value={key}>{value.name}</option>)}</select></div> : <div><span class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">State model</span><div class="px-4 py-3 rounded-xl bg-gray-100 dark:bg-white/5 border border-transparent text-gray-800 dark:text-gray-200">{selectedInfo.name}</div></div>}
    </div>
    <details class="mt-5 rounded-xl border border-gray-200 dark:border-white/10 bg-gray-50/50 dark:bg-white/[0.02]">
      <summary class="cursor-pointer px-4 py-3 text-sm font-semibold text-gray-800 dark:text-gray-200">Advanced W-4, state, and deduction settings</summary>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 p-4 border-t border-gray-200 dark:border-white/10">
        <div><label for={`pc-pretax-${course}`} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Pre-tax deductions per pay ($)</label><input id={`pc-pretax-${course}`} data-field="pretax" type="number" inputmode="decimal" min="0" step="0.01" value="0" class="w-full px-3 py-2.5 rounded-lg bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" /></div>
        <div><label for={`pc-posttax-${course}`} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Post-tax deductions per pay ($)</label><input id={`pc-posttax-${course}`} data-field="posttax" type="number" inputmode="decimal" min="0" step="0.01" value="0" class="w-full px-3 py-2.5 rounded-lg bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" /></div>
        <div><label for={`pc-credits-${course}`} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">W-4 Step 3 annual credits ($)</label><input id={`pc-credits-${course}`} data-field="credits" type="number" inputmode="decimal" min="0" step="1" value="0" class="w-full px-3 py-2.5 rounded-lg bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" /></div>
        <div><label for={`pc-other-income-${course}`} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">W-4 Step 4(a) other income ($/year)</label><input id={`pc-other-income-${course}`} data-field="otherIncome" type="number" inputmode="decimal" min="0" step="1" value="0" class="w-full px-3 py-2.5 rounded-lg bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" /></div>
        <div><label for={`pc-deductions-${course}`} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">W-4 Step 4(b) deductions ($/year)</label><input id={`pc-deductions-${course}`} data-field="deductions" type="number" inputmode="decimal" min="0" step="1" value="0" class="w-full px-3 py-2.5 rounded-lg bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" /></div>
        <div><label for={`pc-extra-federal-${course}`} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">W-4 Step 4(c) extra withholding ($/pay)</label><input id={`pc-extra-federal-${course}`} data-field="extraFederal" type="number" inputmode="decimal" min="0" step="0.01" value="0" class="w-full px-3 py-2.5 rounded-lg bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" /></div>
        <div><label for={`pc-state-exemptions-${course}`} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">State exemptions / allowances</label><input id={`pc-state-exemptions-${course}`} data-field="stateExemptions" type="number" inputmode="numeric" min="0" max="50" step="1" value="0" class="w-full px-3 py-2.5 rounded-lg bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" /></div>
        <div><label for={`pc-state-deduction-${course}`} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Additional state deduction ($/year)</label><input id={`pc-state-deduction-${course}`} data-field="stateDeduction" type="number" inputmode="decimal" min="0" step="1" value="0" class="w-full px-3 py-2.5 rounded-lg bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" /></div>
        <div><label for={`pc-local-rate-${course}`} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Local / county income tax rate (%)</label><input id={`pc-local-rate-${course}`} data-field="localRate" type="number" inputmode="decimal" min="0" max="10" step="0.001" value={initialState==='md'?'3.05':'0'} class="w-full px-3 py-2.5 rounded-lg bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" /></div>
        <div><label for={`pc-ytd-${course}`} class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">YTD Social Security wages before this pay ($)</label><input id={`pc-ytd-${course}`} data-field="ytd" type="number" inputmode="decimal" min="0" step="1" value="0" class="w-full px-3 py-2.5 rounded-lg bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" /></div>
        <label class="flex items-center gap-3 rounded-lg px-3 py-2.5 bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10"><input data-field="step2" type="checkbox" class="w-4 h-4" /><span class="text-sm text-gray-700 dark:text-gray-300">W-4 Step 2 checkbox</span></label>
      </div>
    </details>
    <div data-state-summary class="mt-4 rounded-xl bg-blue-50 dark:bg-blue-900/10 border border-blue-100 dark:border-blue-800/30 px-4 py-3 text-sm text-blue-800 dark:text-blue-300">{selectedInfo.summary}</div>
    <div data-result class="mt-5 min-h-[13rem]" aria-live="polite"><div class="min-h-[13rem] rounded-xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-5 flex flex-col items-center justify-center text-center"><div class="text-sm font-medium text-gray-700 dark:text-gray-300">Your take-home pay estimate will appear here</div><div class="mt-1 text-xs text-gray-500 dark:text-gray-400">Enter gross pay to calculate federal, FICA, state, and local estimates.</div></div></div>
  </div>
  <p class="mt-4 text-xs leading-5 text-gray-500 dark:text-gray-400">Planning estimate for regular 2026 wages and a 2020-or-later Form W-4. It does not cover every credit, deduction, reciprocal agreement, local rule, paid-leave premium, benefit, bonus, tip, overtime, nonresident, or multi-job situation. Compare payroll with the <a href="https://www.irs.gov/publications/p15t" target="_blank" rel="noopener" class="text-primary-600 dark:text-primary-400 underline">2026 IRS Publication 15-T</a> and the applicable <a data-state-source href={selectedInfo.source} target="_blank" rel="noopener" class="text-primary-600 dark:text-primary-400 underline">state source</a>.</p>
</div>

<script>
  (function(){
    const root=document.querySelector('.paycheck-tool:not([data-ready="true"])') as HTMLElement;
    if(!root||root.dataset.ready==='true')return;root.dataset.ready='true';
    const stateInfo:any={none:{name:'No state selected',summary:'No state income tax model is included.'},ar:{name:'Arkansas',summary:'2026 simplified planning model: 3.9% current Arkansas withholding rate after any additional state deduction entered.'},mi:{name:'Michigan',summary:'2026 model: 4.25% after $5,900 for each entered personal exemption.'},wa:{name:'Washington',summary:'Washington has no individual wage income tax; separate paid-leave and long-term-care premiums are not included.'},in:{name:'Indiana',summary:'2026 model: 2.95% state rate after $1,000 per exemption, plus the local/county rate you enter.'},md:{name:'Maryland',summary:'2024–2026 percentage-method model. The local rate is editable; 3.05% is an example, not a statewide default.'},va:{name:'Virginia',summary:'Virginia formula for wages after July 1, 2025, with standard deductions scheduled through tax year 2026.'},il:{name:'Illinois',summary:'2026 model: 4.95% after $2,925 for each entered allowance.'},mo:{name:'Missouri',summary:'Official 2026 annual withholding brackets and filing-status standard deduction.'}};
    const stateSources:any={none:'https://www.irs.gov/publications/p15t',ar:'https://www.dfa.arkansas.gov/wp-content/uploads/withholdInstructions_2026.pdf',mi:'https://www.michigan.gov/taxes/business-taxes/withholding/calendar-year-tax-information',wa:'https://dor.wa.gov/taxes-rates/income-tax',in:'https://www.in.gov/dor/files/dn01.pdf',md:'https://interactive.marylandtaxes.gov/business/calculators/WHCalc.asp',va:'https://www.tax.virginia.gov/sites/default/files/vatax-pdf/employer-withholding-instructions.pdf',il:'https://tax.illinois.gov/forms/withholding/currentyear/il-700-t-withholding-guide-tables.html',mo:'https://dor.mo.gov/forms/Withholding%20Formula_2026.pdf'};
    const fields=(name:string)=>root.querySelector(`[data-field="${name}"]`) as HTMLInputElement|HTMLSelectElement;const result=root.querySelector('[data-result]') as HTMLElement,summary=root.querySelector('[data-state-summary]') as HTMLElement,sourceLink=root.querySelector('[data-state-source]') as HTMLAnchorElement,placeholder=result.innerHTML;
    const standard:any={married:[[0,19300,0,0],[19300,44100,0,.10],[44100,120100,2480,.12],[120100,230700,11600,.22],[230700,422850,35932,.24],[422850,531750,82048,.32],[531750,788000,116896,.35],[788000,Infinity,206583.5,.37]],single:[[0,7500,0,0],[7500,19900,0,.10],[19900,57900,1240,.12],[57900,113200,5800,.22],[113200,209275,17966,.24],[209275,263725,41024,.32],[263725,648100,58448,.35],[648100,Infinity,192979.25,.37]],head:[[0,15550,0,0],[15550,33250,0,.10],[33250,83000,1770,.12],[83000,121250,7740,.22],[121250,217300,16155,.24],[217300,271750,39207,.32],[271750,656150,56631,.35],[656150,Infinity,191171,.37]]};
    const step2:any={married:[[0,16100,0,0],[16100,28500,0,.10],[28500,66500,1240,.12],[66500,121800,5800,.22],[121800,217875,17966,.24],[217875,272325,41024,.32],[272325,400450,58448,.35],[400450,Infinity,103291.75,.37]],single:[[0,8050,0,0],[8050,14250,0,.10],[14250,33250,620,.12],[33250,60900,2900,.22],[60900,108938,8983,.24],[108938,136163,20512,.32],[136163,328350,29224,.35],[328350,Infinity,96489.63,.37]],head:[[0,12075,0,0],[12075,20925,0,.10],[20925,45800,885,.12],[45800,64925,3870,.22],[64925,112950,8077.5,.24],[112950,140175,19603.5,.32],[140175,332375,28315.5,.35],[332375,Infinity,95585.5,.37]]};
    function bracketTax(amount:number,rows:any[]){const row=rows.find(r=>amount>=r[0]&&amount<r[1])||rows[rows.length-1];return row[2]+(amount-row[0])*row[3];}
    function stateTax(code:string,annual:number,filing:string,ex:number,deduction:number,localPct:number){const taxable=(extra=0)=>Math.max(0,annual-deduction-extra);if(code==='none'||code==='wa')return 0;if(code==='ar')return taxable()*0.039;if(code==='mi')return taxable(ex*5900)*.0425;if(code==='in')return taxable(ex*1000)*(.0295+localPct/100);if(code==='il')return taxable(ex*2925)*.0495;if(code==='va'){const std=filing==='married'?17500:8750,t=taxable(std+ex*930);return bracketTax(t,[[0,3000,0,.02],[3000,5000,60,.03],[5000,17000,120,.05],[17000,Infinity,720,.0575]]);}if(code==='mo'){const std=filing==='married'?32200:filing==='head'?24150:16100,t=taxable(std);return bracketTax(t,[[0,1348,0,0],[1348,2696,0,.02],[2696,4044,26.96,.025],[4044,5392,60.66,.03],[5392,6740,101.1,.035],[6740,8088,148.28,.04],[8088,9436,202.2,.045],[9436,Infinity,262.86,.047]]);}if(code==='md'){const std=Math.min(2800,Math.max(1850,annual*.15)),t=taxable(std+ex*3200),joint=filing==='married'||filing==='head',cuts=joint?[0,150000,175000,225000,300000]:[0,100000,125000,150000,250000],rates=[.0475+localPct/100,.05+localPct/100,.0525+localPct/100,.055+localPct/100,.0575+localPct/100];let tax=0;for(let i=0;i<rates.length;i++){const low=cuts[i],high=cuts[i+1]??Infinity;if(t>low)tax+=(Math.min(t,high)-low)*rates[i];}return tax;}return 0;}
    function money(v:number){return '$'+v.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});}
    function calc(){
      const gross=Number(fields('gross')?.value),periods=Number(fields('frequency')?.value||26),filing=fields('filing')?.value||'single';
      if(!fields('gross')?.value){result.innerHTML=placeholder;return;}
      const nums=['pretax','posttax','credits','otherIncome','deductions','extraFederal','stateExemptions','stateDeduction','localRate','ytd'].map(n=>Number(fields(n)?.value||0));
      if(!Number.isFinite(gross)||gross<=0||gross>1e7||nums.some(v=>!Number.isFinite(v)||v<0)||nums[0]>=gross){result.innerHTML='<div class="min-h-[13rem] rounded-xl border border-amber-200 dark:border-amber-800/40 bg-amber-50 dark:bg-amber-900/10 p-5 flex items-center justify-center text-center text-sm text-amber-800 dark:text-amber-300">Enter positive, finite amounts. Pre-tax deductions must be less than gross pay, and rates or deductions cannot be negative.</div>';return;}
      const [pretax,posttax,credits,otherIncome,deductions,extraFederal,stateExemptions,stateDeduction,localRate,ytd]=nums;
      const taxablePay=gross-pretax,annual=taxablePay*periods,checked=(fields('step2') as HTMLInputElement)?.checked||false,adjustment=checked?0:(filing==='married'?12900:8600),adjusted=Math.max(0,annual+otherIncome-deductions-adjustment),fedAnnual=Math.max(0,bracketTax(adjusted,checked?step2[filing]:standard[filing])-credits),federal=fedAnnual/periods+extraFederal,ssTax=Math.min(taxablePay,Math.max(0,184500-ytd))*.062,medicare=taxablePay*.0145+Math.max(0,ytd+taxablePay-200000-Math.max(0,ytd-200000))*.009,state=fields('state')?.value||root.dataset.state||'none',stateAnnual=stateTax(state,annual,filing,stateExemptions,stateDeduction,localRate),statePer=stateAnnual/periods,localIncluded=state==='in'||state==='md',totalTaxes=federal+ssTax+medicare+statePer,net=gross-pretax-posttax-totalTaxes;
      if(net<0){result.innerHTML='<div class="min-h-[13rem] rounded-xl border border-amber-200 dark:border-amber-800/40 bg-amber-50 dark:bg-amber-900/10 p-5 flex items-center justify-center text-center text-sm text-amber-800 dark:text-amber-300">Entered deductions and estimated taxes exceed gross pay. Review the amounts and W-4 settings.</div>';return;}
      const takeHomePercent=net/gross*100,taxPercent=totalTaxes/gross*100,deductionPercent=(pretax+posttax)/gross*100;
      result.innerHTML=`<div class="min-h-[13rem] rounded-xl bg-primary-50 dark:bg-primary-900/20 border border-primary-100 dark:border-primary-800/30 p-5"><div class="text-center"><div class="text-sm text-gray-600 dark:text-gray-400">Estimated take-home pay</div><div class="mt-1 text-3xl font-bold text-primary-600 dark:text-primary-400">${money(net)}</div><div class="mt-1 text-xs text-gray-500 dark:text-gray-400">per pay period · ${money(net*periods)} annualized</div></div><div class="mt-5 grid grid-cols-2 sm:grid-cols-4 gap-3 text-center text-sm"><div><span class="block text-gray-500 dark:text-gray-400">Federal</span><strong class="text-gray-900 dark:text-white">${money(federal)}</strong></div><div><span class="block text-gray-500 dark:text-gray-400">Social Security</span><strong class="text-gray-900 dark:text-white">${money(ssTax)}</strong></div><div><span class="block text-gray-500 dark:text-gray-400">Medicare</span><strong class="text-gray-900 dark:text-white">${money(medicare)}</strong></div><div><span class="block text-gray-500 dark:text-gray-400">State${localIncluded?' + local':''}</span><strong class="text-gray-900 dark:text-white">${money(statePer)}</strong></div></div><div class="mt-4 rounded-lg bg-white/70 dark:bg-white/5 px-4 py-3 text-xs leading-5 text-gray-600 dark:text-gray-300"><strong>Calculation:</strong> ${money(gross)} gross − ${money(pretax)} pre-tax deductions − ${money(totalTaxes)} estimated taxes − ${money(posttax)} post-tax deductions = ${money(net)} net.<br><strong>Taxable pay this period:</strong> ${money(taxablePay)} · <strong>Federal adjusted annual wage:</strong> ${money(adjusted)}.</div><div class="mt-4 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300"><strong>Paycheck comparison:</strong> Take-home pay is ${takeHomePercent.toFixed(1)}% of gross pay · estimated taxes are ${taxPercent.toFixed(1)}% · entered deductions are ${deductionPercent.toFixed(1)}%.</div><p class="mt-3 text-center text-xs text-gray-500 dark:text-gray-400">2026 Social Security wage base: $184,500 · state model: ${stateInfo[state].name}. Open “Assumptions and exclusions” above for items not modeled.</p></div>`;
    }
    const stateSelect=fields('state');if(stateSelect)stateSelect.addEventListener('change',()=>{const code=stateSelect.value;if(code==='md'&&Number(fields('localRate').value)===0)fields('localRate').value='3.05';summary.textContent=stateInfo[code].summary;if(sourceLink)sourceLink.href=stateSources[code];calc();});root.addEventListener('input',calc);root.addEventListener('change',calc);
  })();
</script>
