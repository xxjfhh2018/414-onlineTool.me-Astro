<div class="max-w-md mx-auto">
  <div class="rounded-3xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-8 text-center">
    <div class="mb-6">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Track Repeated Events</h2>
      <p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">Counting repetitions, arrivals, inventory, or observations? Use the main counter or add separate counters for parallel totals.</p>
    </div>
    <!-- Counter Display -->
    <div id="tc-display" class="text-8xl font-mono font-bold text-primary-500 mb-8">0</div>
    
    <!-- Controls -->
    <div class="flex items-center justify-center gap-4 mb-6">
      <button id="tc-dec" class="w-14 h-14 rounded-2xl bg-gray-100 dark:bg-white/10 text-gray-700 dark:text-gray-300 text-2xl font-bold hover:bg-gray-200 dark:hover:bg-white/20 transition-colors flex items-center justify-center">
        −
      </button>
      <button id="tc-inc" class="w-16 h-16 rounded-2xl bg-primary-500 text-white text-3xl font-bold hover:bg-primary-600 transition-colors flex items-center justify-center">
        +
      </button>
    </div>
    
    <button id="tc-reset" class="px-6 py-2 rounded-xl bg-gray-100 dark:bg-white/10 text-gray-600 dark:text-gray-400 text-sm font-medium hover:bg-gray-200 dark:hover:bg-white/20 transition-colors">
      Reset
    </button>
  </div>
  
  <!-- Multiple Counters -->
  <div class="mt-6">
    <button id="tc-add" class="w-full py-3 rounded-xl border border-dashed border-gray-300 dark:border-white/10 text-gray-500 dark:text-gray-400 text-sm hover:border-primary-500 hover:text-primary-500 transition-colors">
      + Add Counter
    </button>
  </div>
  <div id="tc-counters" class="mt-4 space-y-3"></div>
  <div id="tc-summary" class="mt-4 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300" aria-live="polite">
    <strong>Count summary:</strong> Main count 0 · no additional counters.
  </div>
</div>

<script>
  (function() {
    const display = document.getElementById('tc-display');
    const incBtn = document.getElementById('tc-inc');
    const decBtn = document.getElementById('tc-dec');
    const resetBtn = document.getElementById('tc-reset');
    const addBtn = document.getElementById('tc-add');
    const countersContainer = document.getElementById('tc-counters');
    const summary = document.getElementById('tc-summary');
    
    let count = 0;
    let counters: { id: number; count: number }[] = [];
    let nextId = 1;
    
    function updateDisplay() {
      if (display) display.textContent = String(count);
      updateSummary();
    }

    function updateSummary() {
      if (!summary) return;
      const additionalTotal = counters.reduce((sum, counter) => sum + counter.count, 0);
      const highest = counters.length ? Math.max(...counters.map(counter => counter.count)) : 0;
      summary.innerHTML = counters.length
        ? `<strong>Count summary:</strong> Main count ${count} · ${counters.length} additional counter${counters.length === 1 ? '' : 's'} total ${additionalTotal} · highest ${highest}.`
        : `<strong>Count summary:</strong> Main count ${count} · no additional counters.`;
    }
    
    incBtn?.addEventListener('click', () => { count++; updateDisplay(); });
    decBtn?.addEventListener('click', () => { if (count > 0) count--; updateDisplay(); });
    resetBtn?.addEventListener('click', () => { count = 0; updateDisplay(); });
    
    function renderCounters() {
      if (!countersContainer) return;
      countersContainer.innerHTML = '';
      counters.forEach(c => {
        const div = document.createElement('div');
        div.className = 'flex items-center gap-3 p-4 rounded-xl bg-white dark:bg-surface-dark border border-gray-100 dark:border-white/5';
        div.innerHTML = `
          <span class="flex-1 font-mono text-xl font-bold text-gray-900 dark:text-white">${c.count}</span>
          <button data-id="${c.id}" class="tc-c-inc w-10 h-10 rounded-lg bg-primary-500 text-white text-lg font-bold hover:bg-primary-600 transition-colors">+</button>
          <button data-id="${c.id}" class="tc-c-dec w-10 h-10 rounded-lg bg-gray-100 dark:bg-white/10 text-gray-700 dark:text-gray-300 text-lg font-bold hover:bg-gray-200 dark:hover:bg-white/20 transition-colors">−</button>
          <button data-id="${c.id}" class="tc-c-del w-10 h-10 rounded-lg bg-red-50 dark:bg-red-900/20 text-red-500 hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors text-sm">✕</button>
        `;
        countersContainer.appendChild(div);
      });
      updateSummary();
      
      countersContainer.querySelectorAll('.tc-c-inc').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = parseInt(btn.getAttribute('data-id') || '0');
          const c = counters.find(x => x.id === id);
          if (c) { c.count++; renderCounters(); }
        });
      });
      countersContainer.querySelectorAll('.tc-c-dec').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = parseInt(btn.getAttribute('data-id') || '0');
          const c = counters.find(x => x.id === id);
          if (c && c.count > 0) { c.count--; renderCounters(); }
        });
      });
      countersContainer.querySelectorAll('.tc-c-del').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = parseInt(btn.getAttribute('data-id') || '0');
          counters = counters.filter(x => x.id !== id);
          renderCounters();
        });
      });
    }
    
    addBtn?.addEventListener('click', () => {
      counters.push({ id: nextId++, count: 0 });
      renderCounters();
    });
  })();
</script>
