<div class="max-w-2xl mx-auto" id="dynasty-trade-tool">
  <div class="grid md:grid-cols-2 gap-4 mb-6">
    <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-5">
      <div class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">You Give</div>
      <div id="dtc-side-a" class="space-y-3"></div>
      <button id="dtc-add-a" type="button" class="mt-3 w-full py-2 rounded-lg border border-dashed border-gray-300 dark:border-white/10 text-sm text-gray-500 hover:border-primary-500 hover:text-primary-500 transition-colors">
        + Add Player / Pick
      </button>
    </div>

    <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-5">
      <div class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">You Get</div>
      <div id="dtc-side-b" class="space-y-3"></div>
      <button id="dtc-add-b" type="button" class="mt-3 w-full py-2 rounded-lg border border-dashed border-gray-300 dark:border-white/10 text-sm text-gray-500 hover:border-primary-500 hover:text-primary-500 transition-colors">
        + Add Player / Pick
      </button>
    </div>
  </div>

  <div id="dtc-result" class="min-h-[10rem] rounded-2xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-6 flex items-center justify-center text-center text-sm text-gray-500 dark:text-gray-400" aria-live="polite">
    Add a value to both sides to see the live trade comparison
  </div>
  <p class="mt-4 text-xs leading-5 text-gray-500 dark:text-gray-400">Player and pick values are user-provided. The result compares the totals you enter; it is not a live ranking or projection database.</p>
</div>

<script>
  import { evaluateDynastyTrade } from '../../lib/calculatorCore.mjs';

  (function() {
    const root = document.getElementById('dynasty-trade-tool');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const sideA = root.querySelector('#dtc-side-a');
    const sideB = root.querySelector('#dtc-side-b');
    const result = root.querySelector('#dtc-result');
    const inputClass = 'w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-sm text-gray-800 dark:text-gray-200';
    const placeholder = 'Add a value to both sides to see the live trade comparison';

    function addItem(container: Element | null) {
      if (!container) return;
      const row = document.createElement('div');
      row.className = 'dtc-row grid grid-cols-[minmax(0,1fr)_5.5rem_2.25rem] gap-2 items-center';
      row.innerHTML = `<input class="dtc-name ${inputClass}" type="text" placeholder="Player or pick" aria-label="Player or pick"><input class="dtc-value ${inputClass} text-center" type="number" inputmode="decimal" min="0.01" max="1000" step="0.1" placeholder="Value" aria-label="Trade value"><button type="button" class="dtc-del w-9 h-9 rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20" aria-label="Remove player or pick">×</button>`;
      container.appendChild(row);
    }

    function sideTotal(container: Element | null) {
      let total = 0;
      let entries = 0;
      let invalid = false;
      container?.querySelectorAll<HTMLInputElement>('.dtc-value').forEach(input => {
        const raw = input.value.trim();
        if (!raw) return;
        const value = Number(raw);
        if (!Number.isFinite(value) || value <= 0) {
          invalid = true;
          return;
        }
        total += value;
        entries++;
      });
      return { total, entries, invalid };
    }

    function evaluate() {
      if (!result) return;
      const a = sideTotal(sideA);
      const b = sideTotal(sideB);
      if (a.invalid || b.invalid) {
        result.className = 'min-h-[10rem] rounded-2xl bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800/40 p-6 flex items-center justify-center text-center text-sm text-amber-800 dark:text-amber-300';
        result.textContent = 'Trade values must be greater than zero.';
        return;
      }
      if (!a.entries || !b.entries) {
        result.className = 'min-h-[10rem] rounded-2xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-6 flex items-center justify-center text-center text-sm text-gray-500 dark:text-gray-400';
        result.textContent = placeholder;
        return;
      }
      const { percentage, verdict, gapContext } = evaluateDynastyTrade(a.total, b.total);
      const color = percentage < 10 ? 'text-primary-500' : b.total > a.total ? 'text-green-500' : 'text-amber-500';
      result.className = 'min-h-[10rem] rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-6 text-center';
      result.innerHTML = `<div class="text-2xl font-bold ${color} mb-2">${verdict}</div><div class="grid grid-cols-2 gap-4 mt-4"><div class="p-3 rounded-xl bg-gray-50 dark:bg-white/5"><div class="text-xs text-gray-500 dark:text-gray-400">You Give</div><div class="text-xl font-bold text-gray-800 dark:text-white">${a.total.toFixed(1)}</div></div><div class="p-3 rounded-xl bg-gray-50 dark:bg-white/5"><div class="text-xs text-gray-500 dark:text-gray-400">You Get</div><div class="text-xl font-bold text-gray-800 dark:text-white">${b.total.toFixed(1)}</div></div></div><div class="mt-4 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300"><strong>Trade gap:</strong> ${percentage.toFixed(1)}% · ${gapContext}<span class="mt-1 block">Under 10%: numerically close · 10–20%: noticeable difference · Over 20%: strong difference</span><span class="mt-1 block text-blue-700/80 dark:text-blue-300/80">Also consider league format, roster needs, player age, and market conditions.</span></div>`;
    }

    root.querySelector('#dtc-add-a')?.addEventListener('click', () => addItem(sideA));
    root.querySelector('#dtc-add-b')?.addEventListener('click', () => addItem(sideB));
    root.addEventListener('input', event => {
      if ((event.target as HTMLElement).matches('.dtc-value')) evaluate();
    });
    root.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.dtc-del');
      if (!button) return;
      const container = button.closest('#dtc-side-a, #dtc-side-b');
      button.closest('.dtc-row')?.remove();
      if (container && !container.children.length) addItem(container);
      evaluate();
    });
    addItem(sideA);
    addItem(sideB);
  })();
</script>
