---
import FormulaToolShell from './templates/FormulaToolShell.astro';
---
<div class="vdot-tool">
  <FormulaToolShell inputTitle="Estimate VDOT from a Race Result" inputDescription="Enter a recent race distance and finish time to get VDOT and average pace estimates.">
    <div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Race distance<select class="vdot-distance mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5"><option value="1609.344">1 mile</option><option value="5000" selected>5K</option><option value="10000">10K</option><option value="21097.5">Half marathon</option><option value="42195">Marathon</option></select></label>
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Hours<input class="vdot-hours mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" min="0" max="23" step="1" value="0"></label>
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Minutes<input class="vdot-minutes mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" min="0" max="59" step="1" placeholder="20"></label>
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Seconds<input class="vdot-seconds mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" min="0" max="59" step="1" value="0"></label>
    </div>
    <div slot="reference" class="mt-5 flex justify-center gap-3"><button class="vdot-calculate min-h-11 rounded-xl bg-primary-500 px-6 py-2.5 text-sm font-semibold text-white" type="button">Calculate</button><button class="vdot-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div>
    <div slot="result" class="vdot-result"><div class="min-h-[11rem] rounded-xl border border-dashed border-gray-300 bg-gray-50/70 p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:border-white/15 dark:bg-white/[0.03]">Your estimated VDOT and average paces will appear here.</div></div>
  </FormulaToolShell>
</div>
<script>
  import { calculateVdot } from '../../lib/dailyBatchCalculators.mjs';
  const pace=(seconds:number)=>`${Math.floor(seconds/60)}:${String(Math.round(seconds%60)).padStart(2,'0')}`;
  document.querySelectorAll<HTMLElement>('.vdot-tool').forEach(root=>{if(root.dataset.ready)return;root.dataset.ready='true';const result=root.querySelector('.vdot-result') as HTMLElement;const placeholder=result.innerHTML;const val=(s:string)=>(root.querySelector(s) as HTMLInputElement).value;const render=(force=false)=>{if(!val('.vdot-minutes')&&!val('.vdot-hours')&&!force){result.innerHTML=placeholder;return;}try{const value=calculateVdot({distanceMetres:(root.querySelector('.vdot-distance') as HTMLSelectElement).value,hours:val('.vdot-hours'),minutes:val('.vdot-minutes'),seconds:val('.vdot-seconds')});result.innerHTML=`<div class="grid gap-3 sm:grid-cols-3"><div class="rounded-xl border border-primary-100 bg-primary-50 p-5 text-center dark:border-primary-800/30 dark:bg-primary-900/20"><div class="text-sm text-gray-600">Estimated VDOT</div><div class="mt-1 text-4xl font-bold text-primary-600 dark:text-primary-400">${value.vdot.toFixed(1)}</div></div><div class="rounded-xl bg-gray-50 p-5 text-center dark:bg-white/5"><div class="text-sm text-gray-500">Average pace / km</div><div class="mt-2 text-2xl font-bold">${pace(value.pacePerKmSeconds)}</div></div><div class="rounded-xl bg-gray-50 p-5 text-center dark:bg-white/5"><div class="text-sm text-gray-500">Average pace / mile</div><div class="mt-2 text-2xl font-bold">${pace(value.pacePerMileSeconds)}</div></div></div><div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300"><strong>Performance context:</strong> Higher VDOT reflects faster modeled race performance. Compare repeated results under similar conditions; this is not a lab VO₂max or health rating.</div>`;}catch(error){result.innerHTML=`<div class="min-h-[11rem] rounded-xl border border-amber-200 bg-amber-50 p-4 flex items-center justify-center text-center text-sm text-amber-800">${error instanceof Error?error.message:'Unable to estimate VDOT.'}</div>`;}};root.addEventListener('input',()=>render());root.addEventListener('change',()=>render());root.querySelector('.vdot-calculate')?.addEventListener('click',()=>render(true));root.querySelector('.vdot-reset')?.addEventListener('click',()=>{(root.querySelector('.vdot-distance') as HTMLSelectElement).value='5000';(root.querySelector('.vdot-hours') as HTMLInputElement).value='0';(root.querySelector('.vdot-minutes') as HTMLInputElement).value='';(root.querySelector('.vdot-seconds') as HTMLInputElement).value='0';result.innerHTML=placeholder;});});
</script>
