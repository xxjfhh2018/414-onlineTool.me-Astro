---
import FormulaToolShell from './templates/FormulaToolShell.astro';
---
<div class="rebar-tool">
  <FormulaToolShell inputTitle="Estimate a Rectangular Rebar Grid" inputDescription="Enter slab dimensions, maximum spacing, edge cover, layers, and waste to estimate bar counts and total length.">
    <div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Slab length (ft)<input class="rb-length mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" inputmode="decimal" min="0.1" step="0.1" placeholder="20"></label>
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Slab width (ft)<input class="rb-width mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" inputmode="decimal" min="0.1" step="0.1" placeholder="10"></label>
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Maximum spacing (in)<input class="rb-spacing mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" inputmode="decimal" min="0.1" step="0.1" value="18"></label>
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Edge cover (in)<input class="rb-cover mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" inputmode="decimal" min="0" step="0.1" value="3"></label>
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Grid layers<select class="rb-layers mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5"><option value="1">One layer</option><option value="2">Two layers</option></select></label>
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Waste allowance (%)<input class="rb-waste mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" inputmode="decimal" min="0" max="50" step="0.5" value="10"></label>
    </div>
    <div slot="reference" class="mt-5 flex justify-center"><button type="button" class="rb-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10">Reset</button></div>
    <div slot="result" class="rb-result"><div class="min-h-[11rem] rounded-xl border border-dashed border-gray-300 bg-gray-50/70 p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:border-white/15 dark:bg-white/[0.03]">Your rebar length and directional bar counts will appear here.</div></div>
  </FormulaToolShell>
</div>
<script>
  import { calculateRebarGrid } from '../../lib/dailyBatch260811.mjs';
  document.querySelectorAll<HTMLElement>('.rebar-tool').forEach(root=>{if(root.dataset.ready)return;root.dataset.ready='true';const result=root.querySelector('.rb-result') as HTMLElement;const placeholder=result.innerHTML;const input=(s:string)=>(root.querySelector(s) as HTMLInputElement).value;const warning=(m:string)=>`<div class="min-h-[11rem] rounded-xl border border-amber-200 bg-amber-50 p-4 flex items-center justify-center text-center text-sm text-amber-800 dark:border-amber-800/40 dark:bg-amber-900/10 dark:text-amber-300">${m}</div>`;function render(){if(!input('.rb-length')||!input('.rb-width')){result.innerHTML=placeholder;return;}try{const value=calculateRebarGrid({lengthFeet:input('.rb-length'),widthFeet:input('.rb-width'),spacingInches:input('.rb-spacing'),coverInches:input('.rb-cover'),wastePercent:input('.rb-waste'),layers:(root.querySelector('.rb-layers') as HTMLSelectElement).value});result.innerHTML=`<div class="grid gap-3 sm:grid-cols-3"><div class="rounded-xl border border-primary-100 bg-primary-50 p-5 text-center dark:border-primary-800/30 dark:bg-primary-900/20"><div class="text-sm text-gray-600">Rebar to purchase</div><div class="mt-1 text-4xl font-bold text-primary-600 dark:text-primary-400">${value.purchaseFeet} ft</div></div><div class="rounded-xl bg-gray-50 p-5 text-center dark:bg-white/5"><div class="text-sm text-gray-500">Lengthwise bars</div><div class="mt-2 text-2xl font-bold">${value.barsRunningLength}</div><div class="mt-1 text-xs text-gray-500">${value.clearLengthFeet.toFixed(2)} ft each</div></div><div class="rounded-xl bg-gray-50 p-5 text-center dark:bg-white/5"><div class="text-sm text-gray-500">Widthwise bars</div><div class="mt-2 text-2xl font-bold">${value.barsRunningWidth}</div><div class="mt-1 text-xs text-gray-500">${value.clearWidthFeet.toFixed(2)} ft each</div></div></div><div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300"><strong>Grid context:</strong> ${value.installedFeet.toFixed(1)} installed linear ft before waste. Structural drawings—not this estimate—control bar size, spacing, cover, laps, and localized reinforcement.</div>`;}catch(error){result.innerHTML=warning(error instanceof Error?error.message:'Unable to estimate this grid.');}}root.addEventListener('input',render);root.addEventListener('change',render);root.querySelector('.rb-reset')?.addEventListener('click',()=>{for(const [selector,value] of [['.rb-length',''],['.rb-width',''],['.rb-spacing','18'],['.rb-cover','3'],['.rb-waste','10']]) (root.querySelector(selector) as HTMLInputElement).value=value;(root.querySelector('.rb-layers') as HTMLSelectElement).value='1';result.innerHTML=placeholder;});});
</script>
