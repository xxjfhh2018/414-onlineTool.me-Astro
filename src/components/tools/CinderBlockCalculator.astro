---
import FormulaToolShell from './templates/FormulaToolShell.astro';
---
<div class="cinder-block-tool">
  <FormulaToolShell inputTitle="Estimate Cinder Blocks for a Wall" inputDescription="Enter wall dimensions, openings, and waste allowance to get a live purchase quantity.">
    <div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Wall length (ft)<input class="cinder-length mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" min="0.1" step="0.1" placeholder="20"></label>
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Wall height (ft)<input class="cinder-height mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" min="0.1" step="0.1" placeholder="8"></label>
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Openings (sq ft)<input class="cinder-openings mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" min="0" step="0.1" value="0"></label>
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Nominal block face<select class="cinder-size mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5"><option value="16x8">16 × 8 in (standard)</option><option value="12x8">12 × 8 in</option></select></label>
      <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Waste allowance (%)<input class="cinder-waste mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5" type="number" min="0" max="50" step="0.5" value="5"></label>
    </div>
    <div slot="reference" class="mt-5 flex justify-center gap-3"><button class="cinder-calculate min-h-11 rounded-xl bg-primary-500 px-6 py-2.5 text-sm font-semibold text-white" type="button">Calculate</button><button class="cinder-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div>
    <div slot="result" class="cinder-result"><div class="min-h-[11rem] rounded-xl border border-dashed border-gray-300 bg-gray-50/70 p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:border-white/15 dark:bg-white/[0.03]">Your block quantity, net area, and waste allowance will appear here.</div></div>
  </FormulaToolShell>
</div>
<script>
  import { calculateCinderBlocks } from '../../lib/dailyBatchCalculators.mjs';
  document.querySelectorAll<HTMLElement>('.cinder-block-tool').forEach(root=>{if(root.dataset.ready)return;root.dataset.ready='true';const result=root.querySelector('.cinder-result') as HTMLElement;const placeholder=result.innerHTML;const get=(s:string)=>(root.querySelector(s) as HTMLInputElement).value;const render=(force=false)=>{const length=get('.cinder-length'),height=get('.cinder-height');if((!length||!height)&&!force){result.innerHTML=placeholder;return;}try{const [bl,bh]=(root.querySelector('.cinder-size') as HTMLSelectElement).value.split('x').map(Number);const value=calculateCinderBlocks({lengthFeet:length,heightFeet:height,openingsSquareFeet:get('.cinder-openings'),blockLengthInches:bl,blockHeightInches:bh,wastePercent:get('.cinder-waste')});result.innerHTML=`<div class="grid gap-3 sm:grid-cols-3"><div class="rounded-xl border border-primary-100 bg-primary-50 p-5 text-center dark:border-primary-800/30 dark:bg-primary-900/20"><div class="text-sm text-gray-600">Blocks to purchase</div><div class="mt-1 text-4xl font-bold text-primary-600 dark:text-primary-400">${value.totalBlocks}</div></div><div class="rounded-xl bg-gray-50 p-5 text-center dark:bg-white/5"><div class="text-sm text-gray-500">Net wall area</div><div class="mt-2 text-2xl font-bold">${value.netArea.toFixed(2)} sq ft</div></div><div class="rounded-xl bg-gray-50 p-5 text-center dark:bg-white/5"><div class="text-sm text-gray-500">Blocks before waste</div><div class="mt-2 text-2xl font-bold">${Math.ceil(value.baseBlocks)}</div></div></div><div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300"><strong>Project context:</strong> ${Math.ceil(value.baseBlocks)} blocks cover the net area; ${value.totalBlocks-Math.ceil(value.baseBlocks)} additional blocks come from rounding and the selected waste allowance.</div>`;}catch(error){result.innerHTML=`<div class="min-h-[11rem] rounded-xl border border-amber-200 bg-amber-50 p-4 flex items-center justify-center text-center text-sm text-amber-800">${error instanceof Error?error.message:'Unable to calculate blocks.'}</div>`;}};root.addEventListener('input',()=>render());root.addEventListener('change',()=>render());root.querySelector('.cinder-calculate')?.addEventListener('click',()=>render(true));root.querySelector('.cinder-reset')?.addEventListener('click',()=>{(root.querySelectorAll('input') as NodeListOf<HTMLInputElement>).forEach(i=>i.value=i.classList.contains('cinder-waste')?'5':i.classList.contains('cinder-openings')?'0':'');(root.querySelector('.cinder-size') as HTMLSelectElement).value='16x8';result.innerHTML=placeholder;});});
</script>
