---
import MultiRowToolShell from './templates/MultiRowToolShell.astro';
---

<div class="max-w-4xl mx-auto" id="gpa-calculator-tool">
  <MultiRowToolShell inputTitle="Course Grades" inputDescription="Add each course, letter grade, credit value, and course level." tableLabel="GPA courses">
    <button slot="headerActions" id="gpa-add-course" type="button" class="px-4 py-2.5 rounded-xl bg-gray-100 dark:bg-white/5 text-sm font-medium text-gray-700 dark:text-gray-300">+ Add Course</button>
    <table slot="table" class="w-full min-w-[680px]">
      <thead><tr class="text-left text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400"><th class="pb-2 pr-3 font-medium">Course</th><th class="pb-2 px-3 font-medium w-28">Grade</th><th class="pb-2 px-3 font-medium w-28">Credits</th><th class="pb-2 px-3 font-medium w-40">Level</th><th class="pb-2 pl-3 w-12"><span class="sr-only">Remove</span></th></tr></thead>
      <tbody id="gpa-course-rows"></tbody>
    </table>
    <details slot="advanced" class="mt-5 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200/60 dark:border-white/10 p-4">
      <summary class="cursor-pointer text-sm font-semibold text-gray-800 dark:text-gray-200">Add prior GPA for a cumulative result</summary>
      <div class="grid sm:grid-cols-2 gap-4 mt-4">
        <div><label for="gpa-prior" class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Prior unweighted GPA</label><input id="gpa-prior" type="number" inputmode="decimal" min="0" max="4" step="0.01" placeholder="3.45" class="w-full px-3 py-2.5 rounded-lg bg-white dark:bg-surface-dark border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" /></div>
        <div><label for="gpa-prior-credits" class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Previously completed credits</label><input id="gpa-prior-credits" type="number" inputmode="decimal" min="0.01" step="0.25" placeholder="15" class="w-full px-3 py-2.5 rounded-lg bg-white dark:bg-surface-dark border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" /></div>
      </div>
    </details>
    <div slot="result" id="gpa-result"><div class="min-h-[9rem] rounded-xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:text-gray-400">Your weighted and unweighted GPA will appear here</div></div>
    <p slot="footer" class="mt-4 text-xs leading-5 text-gray-500 dark:text-gray-400">Default scale: A/A+ = 4.0, A− = 3.7, B+ = 3.3, and so on. Honors adds 0.5 and AP/IB adds 1.0 for the weighted estimate. Schools may use different scales or caps.</p>
  </MultiRowToolShell>
</div>

<script>
  import { GPA_GRADE_POINTS, calculateGpa } from '../../lib/gpaCalculator.mjs';

  (function () {
    const root = document.getElementById('gpa-calculator-tool');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const rows = root.querySelector('#gpa-course-rows');
    const result = root.querySelector('#gpa-result') as HTMLElement;
    const inputClass = 'w-full px-3 py-2.5 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-sm text-gray-800 dark:text-gray-200';
    const resultPlaceholder = result.innerHTML;
    const warning = (message: string) => `<div class="min-h-[9rem] rounded-xl bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800/40 p-4 flex items-center justify-center text-center text-sm text-amber-800 dark:text-amber-300">${message}</div>`;

    function addRow(name = '') {
      const row = document.createElement('tr');
      row.className = 'gpa-row border-t border-gray-100 dark:border-white/5';
      const gradeOptions = ['', ...Object.keys(GPA_GRADE_POINTS)].map(value => `<option value="${value}">${value || 'Select'}</option>`).join('');
      row.innerHTML = `<td class="py-2.5 pr-3"><input aria-label="Course name" class="gpa-name ${inputClass}" type="text" placeholder="Course name" value="${name}"></td><td class="py-2.5 px-3"><select aria-label="Letter grade" class="gpa-grade ${inputClass}">${gradeOptions}</select></td><td class="py-2.5 px-3"><input aria-label="Course credits" class="gpa-credits ${inputClass}" type="number" inputmode="decimal" min="0.01" step="0.25" value="1"></td><td class="py-2.5 px-3"><select aria-label="Course level" class="gpa-level ${inputClass}"><option value="regular">Regular</option><option value="honors">Honors (+0.5)</option><option value="ap">AP / IB (+1.0)</option></select></td><td class="py-2.5 pl-3"><button type="button" class="gpa-remove w-9 h-9 rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20" aria-label="Remove course">×</button></td>`;
      rows?.appendChild(row);
    }

    function calculate() {
      try {
        const calculated = calculateGpa([...root.querySelectorAll('.gpa-row')].map(row => ({ grade: (row.querySelector('.gpa-grade') as HTMLSelectElement).value, credits: (row.querySelector('.gpa-credits') as HTMLInputElement).value.trim(), level: (row.querySelector('.gpa-level') as HTMLSelectElement).value })), { gpa: (root.querySelector('#gpa-prior') as HTMLInputElement).value.trim(), credits: (root.querySelector('#gpa-prior-credits') as HTMLInputElement).value.trim() });
        if (!calculated) { result.innerHTML = resultPlaceholder; return; }
        const card = (label: string, value: number, detail: string) => `<div class="rounded-xl bg-primary-50 dark:bg-primary-900/20 border border-primary-100 dark:border-primary-800/30 p-5 text-center"><div class="text-sm text-gray-600 dark:text-gray-400">${label}</div><div class="mt-1 text-3xl font-bold text-primary-600 dark:text-primary-400">${value.toFixed(3)}</div><div class="mt-2 text-xs text-gray-500 dark:text-gray-400">${detail}</div></div>`;
        result.innerHTML = `<div class="grid ${calculated.cumulativeGpa === null ? 'sm:grid-cols-2' : 'sm:grid-cols-3'} gap-3">${card('Unweighted GPA', calculated.unweightedGpa, `${calculated.creditsTotal.toFixed(2)} current credits`)}${card('Weighted GPA', calculated.weightedGpa, 'Default honors/AP bonuses applied')}${calculated.cumulativeGpa === null ? '' : card('Cumulative GPA', calculated.cumulativeGpa, `${calculated.cumulativeCredits.toFixed(2)} total credits`)}</div>`;
      } catch (error) { result.innerHTML = warning(error instanceof Error ? error.message : 'These courses could not be calculated.'); }
    }

    root.querySelector('#gpa-add-course')?.addEventListener('click', () => addRow());
    root.addEventListener('click', event => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.gpa-remove'); if (!button) return; button.closest('tr')?.remove(); if (!rows?.children.length) addRow(); calculate(); });
    const handleLiveUpdate = (event: Event) => { if ((event.target as HTMLElement).matches('.gpa-grade, .gpa-credits, .gpa-level, #gpa-prior, #gpa-prior-credits')) calculate(); };
    root.addEventListener('input', handleLiveUpdate); root.addEventListener('change', handleLiveUpdate);
    addRow('English'); addRow('Math'); addRow('Science'); addRow('History');
  })();
</script>
