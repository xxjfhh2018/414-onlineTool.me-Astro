---
import FormulaToolShell from './templates/FormulaToolShell.astro';
const { course } = Astro.props;
const field = 'mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5';
const placeholder = 'min-h-[11rem] rounded-xl border border-dashed border-gray-300 bg-gray-50/70 p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:border-white/15 dark:bg-white/[0.03]';
---

{course === 'cross-stitch-calculator' && <div class="cross-stitch-tool"><FormulaToolShell inputTitle="Calculate Cross Stitch Fabric Size" inputDescription="Enter chart stitches, fabric count, stitching method, and finishing allowance to get design and cut dimensions.">
  <div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <label class="text-sm font-medium">Pattern width (stitches)<input class:list={[field,'cs-width']} type="number" min="1" step="1" inputmode="numeric" placeholder="140" /></label>
    <label class="text-sm font-medium">Pattern height (stitches)<input class:list={[field,'cs-height']} type="number" min="1" step="1" inputmode="numeric" placeholder="98" /></label>
    <label class="text-sm font-medium">Fabric count (threads/in)<input class:list={[field,'cs-count']} type="number" min="1" step="1" inputmode="numeric" value="14" /></label>
    <label class="text-sm font-medium">Stitch over<select class:list={[field,'cs-over']}><option value="1">1 fabric thread</option><option value="2">2 fabric threads</option></select></label>
    <label class="text-sm font-medium">Allowance per side (in)<input class:list={[field,'cs-allowance']} type="number" min="0" max="12" step="0.25" inputmode="decimal" value="3" /></label>
  </div><div slot="result" class="cs-result"><div class={placeholder}>Your finished design and fabric cut sizes will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="cs-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div>
</FormulaToolShell></div>}

{course === 'dunk-calculator' && <div class="dunk-tool"><FormulaToolShell inputTitle="Estimate the Vertical Needed to Dunk" inputDescription="Enter standing reach, current vertical jump, and target hand clearance above a regulation rim.">
  <div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <label class="text-sm font-medium">Units<select class:list={[field,'dk-units']}><option value="imperial">Inches</option><option value="metric">Centimetres</option></select></label>
    <label class="text-sm font-medium">Standing reach <span class="dk-unit">(in)</span><input class:list={[field,'dk-reach']} type="number" min="1" step="0.1" inputmode="decimal" placeholder="96" /></label>
    <label class="text-sm font-medium">Current vertical <span class="dk-unit">(in)</span> <span class="text-gray-400">optional</span><input class:list={[field,'dk-current']} type="number" min="0" step="0.1" inputmode="decimal" placeholder="24" /></label>
    <label class="text-sm font-medium">Hand clearance above rim <span class="dk-unit">(in)</span><input class:list={[field,'dk-clearance']} type="number" min="0" step="0.1" inputmode="decimal" value="6" /></label>
  </div><div slot="result" class="dk-result"><div class={placeholder}>Your required vertical jump and progress gap will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="dk-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div>
</FormulaToolShell></div>}

{course === 'snowboard-size-calculator' && <div class="snowboard-tool"><FormulaToolShell inputTitle="Find a Snowboard Starting Range" inputDescription="Enter weight, height, US boot size, and preferred terrain to get a comparison range before checking a specific board chart.">
  <div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <label class="text-sm font-medium">Units<select class:list={[field,'sb-units']}><option value="metric">kg / cm</option><option value="us">lb / in</option></select></label>
    <label class="text-sm font-medium">Rider weight <span class="sb-weight-unit">(kg)</span><input class:list={[field,'sb-weight']} type="number" min="25" step="0.1" inputmode="decimal" placeholder="72" /></label>
    <label class="text-sm font-medium">Rider height <span class="sb-height-unit">(cm)</span><input class:list={[field,'sb-height']} type="number" min="1" step="0.1" inputmode="decimal" placeholder="178" /></label>
    <label class="text-sm font-medium">US snowboard boot size<input class:list={[field,'sb-boot']} type="number" min="1" max="18" step="0.5" inputmode="decimal" placeholder="9" /></label>
    <label class="text-sm font-medium">Primary terrain<select class:list={[field,'sb-terrain']}><option value="all-mountain">All mountain</option><option value="park">Park / freestyle</option><option value="powder">Powder / freeride</option></select></label>
  </div><div slot="result" class="sb-result"><div class={placeholder}>Your starting length range and width guidance will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="sb-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div>
</FormulaToolShell></div>}

{course === 'calculator-bricks' && <div class="brick-tool"><FormulaToolShell inputTitle="Estimate Bricks for a Wall" inputDescription="Enter wall area, openings, brick face dimensions, mortar joint, and waste to get a rounded purchase quantity.">
  <div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <label class="text-sm font-medium">Wall length (ft)<input class:list={[field,'br-length']} type="number" min="0.1" step="0.1" placeholder="20" /></label><label class="text-sm font-medium">Wall height (ft)<input class:list={[field,'br-height']} type="number" min="0.1" step="0.1" placeholder="8" /></label><label class="text-sm font-medium">Openings (sq ft)<input class:list={[field,'br-openings']} type="number" min="0" step="0.1" value="0" /></label>
    <label class="text-sm font-medium">Brick face length (in)<input class:list={[field,'br-brick-length']} type="number" min="0.1" step="0.125" value="7.625" /></label><label class="text-sm font-medium">Brick face height (in)<input class:list={[field,'br-brick-height']} type="number" min="0.1" step="0.125" value="2.25" /></label><label class="text-sm font-medium">Mortar joint (in)<input class:list={[field,'br-joint']} type="number" min="0" step="0.125" value="0.375" /></label><label class="text-sm font-medium">Waste allowance (%)<input class:list={[field,'br-waste']} type="number" min="0" max="30" step="0.5" value="5" /></label>
  </div><div slot="result" class="br-result"><div class={placeholder}>Your brick purchase quantity and net wall area will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="br-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div>
</FormulaToolShell></div>}

{course === 'furnace-size-calculator' && <div class="furnace-tool"><FormulaToolShell inputTitle="Get a Preliminary Furnace Capacity Range" inputDescription="Enter conditioned area, climate severity, envelope quality, and AFUE to get a rough input-capacity range for early planning.">
  <div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <label class="text-sm font-medium">Conditioned area (sq ft)<input class:list={[field,'fu-area']} type="number" min="100" max="15000" step="10" inputmode="numeric" placeholder="2000" /></label><label class="text-sm font-medium">Winter climate<select class:list={[field,'fu-climate']}><option value="mild">Mild</option><option value="moderate" selected>Moderate</option><option value="cold">Cold</option><option value="very-cold">Very cold</option></select></label><label class="text-sm font-medium">Envelope / insulation<select class:list={[field,'fu-insulation']}><option value="efficient">Efficient / tight</option><option value="average" selected>Average</option><option value="limited">Limited / leaky</option></select></label><label class="text-sm font-medium">Furnace AFUE (%)<input class:list={[field,'fu-afue']} type="number" min="60" max="100" step="0.1" value="90" /></label>
  </div><div slot="result" class="fu-result"><div class={placeholder}>Your preliminary input-capacity range and estimated output load will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class="fu-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10" type="button">Reset</button></div>
</FormulaToolShell></div>}

<script>
  import { calculateBricks, calculateCrossStitch, calculateDunk, calculateFurnaceSize, calculateSnowboardSize } from '../../lib/dailyBatch260812.mjs';
  const get=(root:HTMLElement,s:string)=>(root.querySelector(s) as HTMLInputElement|HTMLSelectElement).value;
  const warning=(message:string)=>`<div class="min-h-[11rem] rounded-xl border border-amber-200 bg-amber-50 p-4 flex items-center justify-center text-center text-sm text-amber-800 dark:border-amber-800/40 dark:bg-amber-900/10 dark:text-amber-300">${message}</div>`;
  const card=(label:string,value:string,detail:string,anchor:string)=>`<div class="min-h-[11rem] rounded-xl border border-primary-100 bg-primary-50 p-5 text-center dark:border-primary-800/30 dark:bg-primary-900/20"><div class="text-sm text-gray-600 dark:text-gray-300">${label}</div><div class="mt-2 text-4xl font-bold text-primary-600 dark:text-primary-400">${value}</div><div class="mt-2 text-sm text-gray-500">${detail}</div></div><div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300">${anchor}</div>`;
  document.querySelectorAll<HTMLElement>('.cross-stitch-tool').forEach(root=>{const result=root.querySelector('.cs-result') as HTMLElement,initial=result.innerHTML;const render=()=>{if(!get(root,'.cs-width')||!get(root,'.cs-height')){result.innerHTML=initial;return;}try{const v=calculateCrossStitch({widthStitches:get(root,'.cs-width'),heightStitches:get(root,'.cs-height'),fabricCount:get(root,'.cs-count'),threadsOver:get(root,'.cs-over'),allowancePerSide:get(root,'.cs-allowance')});result.innerHTML=card('Fabric cut size',`${v.cutWidthInches.toFixed(2)} × ${v.cutHeightInches.toFixed(2)} in`,`Finished design: ${v.designWidthInches.toFixed(2)} × ${v.designHeightInches.toFixed(2)} in · ${v.totalStitches.toLocaleString()} chart squares`,'<strong>Size context:</strong> Cut size includes the selected allowance on all four sides; framing and finishing methods may require more.');}catch(e){result.innerHTML=warning(e instanceof Error?e.message:'Check the pattern inputs.');}};root.addEventListener('input',render);root.addEventListener('change',render);root.querySelector('.cs-reset')?.addEventListener('click',()=>{(root.querySelector('.cs-width') as HTMLInputElement).value='';(root.querySelector('.cs-height') as HTMLInputElement).value='';(root.querySelector('.cs-count') as HTMLInputElement).value='14';(root.querySelector('.cs-over') as HTMLSelectElement).value='1';(root.querySelector('.cs-allowance') as HTMLInputElement).value='3';render();});});
  document.querySelectorAll<HTMLElement>('.dunk-tool').forEach(root=>{const result=root.querySelector('.dk-result') as HTMLElement,initial=result.innerHTML;const sync=()=>{const metric=get(root,'.dk-units')==='metric';root.querySelectorAll<HTMLElement>('.dk-unit').forEach(n=>n.textContent=metric?'(cm)':'(in)');(root.querySelector('.dk-clearance') as HTMLInputElement).value=metric?'15.2':'6';};const render=()=>{if(!get(root,'.dk-reach')){result.innerHTML=initial;return;}try{const v=calculateDunk({unitSystem:get(root,'.dk-units'),standingReach:get(root,'.dk-reach'),currentVertical:get(root,'.dk-current'),clearance:get(root,'.dk-clearance')});const gap=v.gap==null?'Add current vertical to see your gap.':v.gap<=0?`Current jump clears the target by ${Math.abs(v.gap).toFixed(1)} ${v.unit}.`:`Progress gap: ${v.gap.toFixed(1)} ${v.unit}.`;result.innerHTML=card('Vertical needed',`${v.requiredVertical.toFixed(1)} ${v.unit}`,gap,'<strong>Performance context:</strong> This is reach geometry only. Ball control, approach, timing, hand size, fatigue, and safety also affect an actual dunk.');}catch(e){result.innerHTML=warning(e instanceof Error?e.message:'Check the reach inputs.');}};root.addEventListener('input',render);root.addEventListener('change',e=>{if((e.target as Element).matches('.dk-units')){(root.querySelector('.dk-reach') as HTMLInputElement).value='';(root.querySelector('.dk-current') as HTMLInputElement).value='';sync();}render();});root.querySelector('.dk-reset')?.addEventListener('click',()=>{(root.querySelector('.dk-units') as HTMLSelectElement).value='imperial';(root.querySelector('.dk-reach') as HTMLInputElement).value='';(root.querySelector('.dk-current') as HTMLInputElement).value='';sync();render();});});
  document.querySelectorAll<HTMLElement>('.snowboard-tool').forEach(root=>{const result=root.querySelector('.sb-result') as HTMLElement,initial=result.innerHTML;const sync=()=>{const us=get(root,'.sb-units')==='us';(root.querySelector('.sb-weight-unit') as HTMLElement).textContent=us?'(lb)':'(kg)';(root.querySelector('.sb-height-unit') as HTMLElement).textContent=us?'(in)':'(cm)';};const render=()=>{if(!get(root,'.sb-weight')||!get(root,'.sb-height')||!get(root,'.sb-boot')){result.innerHTML=initial;return;}try{const v=calculateSnowboardSize({unitSystem:get(root,'.sb-units'),weight:get(root,'.sb-weight'),height:get(root,'.sb-height'),bootSizeUS:get(root,'.sb-boot'),terrain:get(root,'.sb-terrain')});result.innerHTML=card('Starting board-length range',`${v.minCm}–${v.maxCm} cm`,`Midpoint: ${v.midpointCm} cm · ${v.widthAdvice}`,'<strong>Fit context:</strong> Compare this range with the exact manufacturer weight range and waist width for every candidate board; model sizing overrides this estimate.');}catch(e){result.innerHTML=warning(e instanceof Error?e.message:'Check rider measurements.');}};root.addEventListener('input',render);root.addEventListener('change',e=>{if((e.target as Element).matches('.sb-units')){(root.querySelector('.sb-weight') as HTMLInputElement).value='';(root.querySelector('.sb-height') as HTMLInputElement).value='';}sync();render();});root.querySelector('.sb-reset')?.addEventListener('click',()=>{(root.querySelector('.sb-units') as HTMLSelectElement).value='metric';for(const s of ['.sb-weight','.sb-height','.sb-boot']) (root.querySelector(s) as HTMLInputElement).value='';(root.querySelector('.sb-terrain') as HTMLSelectElement).value='all-mountain';sync();render();});sync();});
  document.querySelectorAll<HTMLElement>('.brick-tool').forEach(root=>{const result=root.querySelector('.br-result') as HTMLElement,initial=result.innerHTML;const render=()=>{if(!get(root,'.br-length')||!get(root,'.br-height')){result.innerHTML=initial;return;}try{const v=calculateBricks({wallLengthFeet:get(root,'.br-length'),wallHeightFeet:get(root,'.br-height'),openingsSqFeet:get(root,'.br-openings'),brickLengthInches:get(root,'.br-brick-length'),brickHeightInches:get(root,'.br-brick-height'),jointInches:get(root,'.br-joint'),wastePercent:get(root,'.br-waste')});result.innerHTML=card('Bricks to purchase',v.purchaseBricks.toLocaleString(),`Net wall: ${v.netArea.toFixed(1)} sq ft · ${v.bricksPerSqFoot.toFixed(2)} bricks/sq ft before waste`,`<strong>Project context:</strong> Base estimate ${Math.ceil(v.baseBricks).toLocaleString()} bricks; purchase total includes the selected waste and rounds up.`);}catch(e){result.innerHTML=warning(e instanceof Error?e.message:'Check wall inputs.');}};root.addEventListener('input',render);root.querySelector('.br-reset')?.addEventListener('click',()=>{for(const [s,v] of [['.br-length',''],['.br-height',''],['.br-openings','0'],['.br-brick-length','7.625'],['.br-brick-height','2.25'],['.br-joint','0.375'],['.br-waste','5']]) (root.querySelector(s) as HTMLInputElement).value=v;render();});});
  document.querySelectorAll<HTMLElement>('.furnace-tool').forEach(root=>{const result=root.querySelector('.fu-result') as HTMLElement,initial=result.innerHTML;const fmt=(n:number)=>Math.round(n/1000)*1000;const render=()=>{if(!get(root,'.fu-area')){result.innerHTML=initial;return;}try{const v=calculateFurnaceSize({areaSqFeet:get(root,'.fu-area'),climate:get(root,'.fu-climate'),insulation:get(root,'.fu-insulation'),afuePercent:get(root,'.fu-afue')});result.innerHTML=card('Preliminary furnace input range',`${fmt(v.lowInputBtu).toLocaleString()}–${fmt(v.highInputBtu).toLocaleString()} BTU/h`,`Midpoint input: ${fmt(v.inputBtu).toLocaleString()} BTU/h · estimated output load: ${fmt(v.outputBtu).toLocaleString()} BTU/h`,'<strong>Sizing context:</strong> This broad rule-of-thumb range is not Manual J or Manual S. Do not purchase equipment from this result alone.');}catch(e){result.innerHTML=warning(e instanceof Error?e.message:'Check sizing inputs.');}};root.addEventListener('input',render);root.addEventListener('change',render);root.querySelector('.fu-reset')?.addEventListener('click',()=>{(root.querySelector('.fu-area') as HTMLInputElement).value='';(root.querySelector('.fu-climate') as HTMLSelectElement).value='moderate';(root.querySelector('.fu-insulation') as HTMLSelectElement).value='average';(root.querySelector('.fu-afue') as HTMLInputElement).value='90';render();});});
</script>
