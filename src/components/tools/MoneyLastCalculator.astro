<div class="max-w-4xl mx-auto" id="money-last-tool">
  <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-4 sm:p-6">
    <div class="mb-5"><h2 class="text-lg font-semibold text-gray-900 dark:text-white">Estimate How Long Your Money Will Last</h2><p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">Planning withdrawals or testing a retirement budget? Enter savings, monthly cash flow, expected return, and inflation.</p></div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div><label for="ml-balance" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Starting savings ($)</label><input id="ml-balance" type="number" inputmode="decimal" min="0.01" max="1000000000" step="100" placeholder="250000" class="ml-input w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" /></div>
      <div><label for="ml-spending" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Monthly spending ($)</label><input id="ml-spending" type="number" inputmode="decimal" min="0" max="10000000" step="10" placeholder="3000" class="ml-input w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" /></div>
      <div><label for="ml-income" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Monthly income ($)</label><input id="ml-income" type="number" inputmode="decimal" min="0" max="10000000" step="10" value="0" class="ml-input w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" /></div>
      <div><label for="ml-return" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Annual return (%)</label><input id="ml-return" type="number" inputmode="decimal" min="-100" max="100" step="0.1" value="3" class="ml-input w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" /></div>
      <div><label for="ml-inflation" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Annual expense inflation (%)</label><input id="ml-inflation" type="number" inputmode="decimal" min="-20" max="100" step="0.1" value="2.5" class="ml-input w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" /></div>
      <div><label for="ml-timing" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Monthly cash-flow timing</label><select id="ml-timing" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200"><option value="end">End of month</option><option value="start">Start of month</option></select></div>
    </div>
    <div id="ml-result" class="mt-5 min-h-[12rem]" aria-live="polite"><div class="min-h-[12rem] rounded-xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-5 flex flex-col items-center justify-center text-center"><div class="text-sm font-medium text-gray-700 dark:text-gray-300">Your savings duration will appear here</div><div class="mt-1 text-xs text-gray-500 dark:text-gray-400">Enter starting savings and monthly spending to calculate automatically.</div></div></div>
  </div>
  <p class="mt-4 text-xs leading-5 text-gray-500 dark:text-gray-400">Planning model only. Returns are treated as smooth monthly growth, while real markets, taxes, fees, emergencies, and spending vary. It is not retirement or investment advice.</p>
</div>
<script>
  import { calculateMoneyDuration } from '../../lib/calculatorCore.mjs';
  (function(){
    const root=document.getElementById('money-last-tool');if(!root||root.dataset.ready==='true')return;root.dataset.ready='true';const ids=['balance','spending','income','return','inflation'];const input=Object.fromEntries(ids.map(id=>[id,root.querySelector('#ml-'+id) as HTMLInputElement]));const timing=root.querySelector('#ml-timing') as HTMLSelectElement,result=root.querySelector('#ml-result') as HTMLElement,placeholder=result.innerHTML;
    function calc(){if(!input.balance.value||!input.spending.value){result.innerHTML=placeholder;return;}const values=Object.fromEntries(ids.map(id=>[id,Number(input[id].value||0)]));if(!Object.values(values).every(Number.isFinite)||values.balance<=0||values.balance>1e9||values.spending<0||values.income<0||values.return<-100||values.return>100||values.inflation<-20||values.inflation>100){result.innerHTML='<div class="min-h-[12rem] rounded-xl border border-amber-200 dark:border-amber-800/40 bg-amber-50 dark:bg-amber-900/10 p-5 flex items-center justify-center text-center text-sm text-amber-800 dark:text-amber-300">Enter valid positive savings, nonnegative spending and income, return from −100% to 100%, and inflation from −20% to 100%.</div>';return;}const projection=calculateMoneyDuration({startingBalance:values.balance,monthlySpending:values.spending,monthlyIncome:values.income,annualReturnPercent:values.return,annualInflationPercent:values.inflation,timing:timing.value});const {months,monthlyReturn,monthlyInflation}=projection;const coverage=values.spending>0?values.income/values.spending*100:100,monthlyGap=values.spending-values.income,comparison=`Income covers ${coverage.toFixed(1)}% of entered monthly spending · starting monthly ${monthlyGap>=0?'withdrawal':'surplus'}: $${Math.abs(monthlyGap).toFixed(2)}.`;if(projection.status==='no-depletion'){result.innerHTML=`<div class="min-h-[12rem] rounded-xl bg-emerald-50 dark:bg-emerald-900/10 border border-emerald-200 dark:border-emerald-800/40 p-5 text-center"><div class="text-2xl font-bold text-emerald-700 dark:text-emerald-300">No depletion in this model</div><p class="mt-2 text-sm text-emerald-700 dark:text-emerald-300">Monthly income covers spending, return is nonnegative, and expenses do not rise. Under these assumptions the balance does not run out.</p><div class="mt-4 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-xs leading-5 text-blue-800"><strong>Cash-flow comparison:</strong> ${comparison}</div></div>`;return;}if(projection.status==='limit'){result.innerHTML=`<div class="min-h-[12rem] rounded-xl bg-primary-50 dark:bg-primary-900/20 border border-primary-100 dark:border-primary-800/30 p-5 text-center"><div class="text-3xl font-bold text-primary-600 dark:text-primary-400">100+ years</div><p class="mt-2 text-sm text-gray-600 dark:text-gray-400">The balance remained positive through the calculator’s 100-year projection limit.</p><div class="mt-4 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300"><strong>Cash-flow comparison:</strong> ${comparison}</div></div>`;return;}const years=Math.floor(months/12),remaining=months%12;result.innerHTML=`<div class="min-h-[12rem] rounded-xl bg-primary-50 dark:bg-primary-900/20 border border-primary-100 dark:border-primary-800/30 p-5 text-center"><div class="text-sm text-gray-600 dark:text-gray-400">Estimated savings duration</div><div class="mt-1 text-3xl font-bold text-primary-600 dark:text-primary-400">${years} years ${remaining} months</div><p class="mt-3 text-sm text-gray-700 dark:text-gray-300">${months} monthly periods using a ${(monthlyReturn*100).toFixed(3)}% monthly return and ${(monthlyInflation*100).toFixed(3)}% monthly expense increase.</p><div class="mt-4 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300"><strong>Cash-flow comparison:</strong> ${comparison}</div></div>`;}
    root.addEventListener('input',calc);root.addEventListener('change',calc);
  })();
</script>
