---
import FormulaToolShell from './templates/FormulaToolShell.astro';
import { ffmiCalculatorSpecification } from '../../data/calculators/ffmiCalculator';

const weightDefinition = ffmiCalculatorSpecification.inputs.find(input => input.id === 'weight')!;
const heightDefinition = ffmiCalculatorSpecification.inputs.find(input => input.id === 'height')!;
const bodyFatDefinition = ffmiCalculatorSpecification.inputs.find(input => input.id === 'bodyFat')!;
---

<div id="ffmi-calculator-tool">
  <FormulaToolShell
    inputTitle="Calculate Your FFMI"
    inputDescription="Enter weight, height, and an estimated body-fat percentage. Results update as you type."
  >
    <div slot="inputs" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div>
        <label for="ffmi-units" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Unit system</label>
        <select id="ffmi-units" class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200">
          <option value="metric">Metric</option><option value="us">US customary</option>
        </select>
      </div>
      <div>
        <label for="ffmi-weight" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Weight (<span data-weight-unit>kg</span>)</label>
        <input id="ffmi-weight" type="number" inputmode="decimal" min={weightDefinition.min} max={weightDefinition.max} step={weightDefinition.step} placeholder={weightDefinition.placeholder} class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" />
      </div>
      <div>
        <label for="ffmi-height" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Height (<span data-height-unit>cm</span>)</label>
        <input id="ffmi-height" type="number" inputmode="decimal" min={heightDefinition.min} max={heightDefinition.max} step={heightDefinition.step} placeholder={heightDefinition.placeholder} class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" />
      </div>
      <div>
        <label for="ffmi-fat" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Body fat (%)</label>
        <input id="ffmi-fat" type="number" inputmode="decimal" min={bodyFatDefinition.min} max={bodyFatDefinition.max} step={bodyFatDefinition.step} placeholder={bodyFatDefinition.placeholder} class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" />
      </div>
    </div>
    <div slot="result" id="ffmi-result">
      <div class="min-h-[11rem] rounded-xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-5 flex flex-col items-center justify-center text-center">
        <div class="text-sm font-medium text-gray-700 dark:text-gray-300">Your FFMI result will appear here</div>
        <div class="mt-1 text-xs text-gray-500 dark:text-gray-400">Complete all three measurements to calculate automatically.</div>
      </div>
    </div>
    <p slot="footer" class="mt-4 text-xs leading-5 text-gray-500 dark:text-gray-400">FFMI depends strongly on body-fat measurement accuracy. The optional height normalization follows the male-athlete model reported by Kouri et al. and is not a diagnosis or proof of drug use. <a class="text-primary-600 dark:text-primary-400 underline" href="https://pubmed.ncbi.nlm.nih.gov/7496846/" target="_blank" rel="noopener">Review the original study</a>.</p>
  </FormulaToolShell>
</div>

<script>
  import { FFMI_CONSTANTS, FFMI_LIMITS, calculateFfmi } from '../../lib/ffmiCalculator.mjs';

  (function () {
    const root = document.getElementById('ffmi-calculator-tool');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const units = root.querySelector('#ffmi-units') as HTMLSelectElement;
    const weight = root.querySelector('#ffmi-weight') as HTMLInputElement;
    const height = root.querySelector('#ffmi-height') as HTMLInputElement;
    const fat = root.querySelector('#ffmi-fat') as HTMLInputElement;
    const result = root.querySelector('#ffmi-result') as HTMLElement;
    const placeholder = result.innerHTML;
    const warning = (message: string) => `<div class="min-h-[11rem] rounded-xl border border-amber-200 dark:border-amber-800/40 bg-amber-50 dark:bg-amber-900/10 p-5 flex items-center justify-center text-center text-sm text-amber-800 dark:text-amber-300">${message}</div>`;

    function updateUnits(convert = false) {
      const metric = units.value === 'metric';
      root.querySelector('[data-weight-unit]')!.textContent = metric ? 'kg' : 'lb';
      root.querySelector('[data-height-unit]')!.textContent = metric ? 'cm' : 'in';
      const limits = metric ? FFMI_LIMITS.metric : FFMI_LIMITS.us;
      weight.max = String(limits.maxWeight);
      height.min = String(limits.minHeight);
      height.max = String(limits.maxHeight);
      weight.placeholder = metric ? '82' : '181';
      height.placeholder = metric ? '180' : '70.9';
      if (convert && weight.value && height.value) {
        const oldWeight = Number(weight.value); const oldHeight = Number(height.value);
        weight.value = (metric ? oldWeight / FFMI_CONSTANTS.poundsPerKilogram : oldWeight * FFMI_CONSTANTS.poundsPerKilogram).toFixed(1);
        height.value = (metric ? oldHeight * FFMI_CONSTANTS.centimetresPerInch : oldHeight / FFMI_CONSTANTS.centimetresPerInch).toFixed(1);
      }
    }

    function calculate() {
      if (!weight.value || !height.value || !fat.value) { result.innerHTML = placeholder; return; }
      const enteredWeight = Number(weight.value); const enteredHeight = Number(height.value); const bodyFat = Number(fat.value);
      const metric = units.value === 'metric';
      const limits = metric ? FFMI_LIMITS.metric : FFMI_LIMITS.us;
      const { maxWeight, minHeight, maxHeight } = limits;
      if (![enteredWeight, enteredHeight, bodyFat].every(Number.isFinite) || enteredWeight <= 0 || enteredWeight > maxWeight || enteredHeight < minHeight || enteredHeight > maxHeight || bodyFat < 0 || bodyFat > 75) {
        result.innerHTML = warning(`Enter a positive weight up to ${maxWeight} ${metric ? 'kg' : 'lb'}, height from ${minHeight} to ${maxHeight} ${metric ? 'cm' : 'in'}, and body fat from 0% to 75%.`); return;
      }
      const calculated = calculateFfmi({ unitSystem: metric ? 'metric' : 'us', weight: enteredWeight, height: enteredHeight, bodyFat });
      const { leanKg, ffmi, normalizedFfmi: normalized, normalizationDifference } = calculated;
      const normalizationText = Math.abs(normalizationDifference) < 0.005
        ? 'Height normalization does not change this result at the displayed precision.'
        : `Height normalization changes this result by ${normalizationDifference > 0 ? '+' : ''}${normalizationDifference.toFixed(2)} FFMI points.`;
      const leanDisplay = metric ? `${leanKg.toFixed(1)} kg` : `${(leanKg * FFMI_CONSTANTS.poundsPerKilogram).toFixed(1)} lb`;
      result.innerHTML = `<div class="min-h-[11rem] rounded-xl bg-primary-50 dark:bg-primary-900/20 border border-primary-100 dark:border-primary-800/30 p-5">
        <div class="grid sm:grid-cols-3 gap-4 text-center"><div><div class="text-sm text-gray-600 dark:text-gray-400">FFMI</div><div class="mt-1 text-3xl font-bold text-primary-600 dark:text-primary-400">${ffmi.toFixed(2)}</div></div><div><div class="text-sm text-gray-600 dark:text-gray-400">Lean mass</div><div class="mt-1 text-xl font-semibold text-gray-900 dark:text-white">${leanDisplay}</div></div><div><div class="text-sm text-gray-600 dark:text-gray-400">Height-normalized FFMI</div><div class="mt-1 text-xl font-semibold text-gray-900 dark:text-white">${normalized.toFixed(2)}</div></div></div>
        <p class="mt-4 text-center text-xs text-gray-500 dark:text-gray-400">Normalized FFMI = FFMI + 6.3 × (1.80 − height in metres). Values are rounded to two decimals.</p><div class="mt-4 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300"><strong>Comparison context:</strong> ${normalizationText}<span class="mt-1 block">For personal progress, keep the body-fat method and measurement conditions consistent; this research adjustment is not a health category.</span></div></div>`;
    }
    units.addEventListener('change', () => { updateUnits(true); calculate(); });
    root.addEventListener('input', calculate);
    updateUnits();
  })();
</script>
