---
interface Props {
  inputTitle: string;
  inputDescription: string;
  resultLabel?: string;
}

const { inputTitle, inputDescription, resultLabel = 'Planning estimate' } = Astro.props;
---

<div class="max-w-4xl mx-auto overflow-hidden rounded-2xl border border-gray-200/60 bg-white dark:border-white/10 dark:bg-surface-dark">
  <header class="border-b border-gray-100 p-4 dark:border-white/5 sm:p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">{inputTitle}</h2>
        <p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">{inputDescription}</p>
      </div>
      <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800 dark:bg-amber-900/20 dark:text-amber-200">{resultLabel}</span>
    </div>
    <div class="mt-4 grid gap-3 rounded-xl bg-gray-50 p-3 text-xs text-gray-600 dark:bg-white/5 dark:text-gray-300 sm:grid-cols-[1fr_auto] sm:items-end">
      <slot name="version" />
      <slot name="source" />
    </div>
  </header>

  <div class="p-4 sm:p-6">
    <slot name="inputs" />
    {Astro.slots.has('cutoffSummary') && <div class="mt-4"><slot name="cutoffSummary" /></div>}
    {Astro.slots.has('advanced') && <slot name="advanced" />}
    {Astro.slots.has('controls') && <div class="mt-5"><slot name="controls" /></div>}
    <div class="mt-5 min-h-[9rem]" aria-live="polite" aria-atomic="false"><slot name="result" /></div>
  </div>
</div>

{Astro.slots.has('footer') && <slot name="footer" />}
