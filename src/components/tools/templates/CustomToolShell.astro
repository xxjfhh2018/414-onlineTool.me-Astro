---
interface Props {
  title: string;
  description: string;
  maxWidthClass?: string;
}

const { title, description, maxWidthClass = 'max-w-md' } = Astro.props;
---

<div class:list={[maxWidthClass, 'mx-auto text-center']}>
  <div class="rounded-3xl border border-gray-200/60 bg-white p-5 dark:border-white/10 dark:bg-surface-dark sm:p-8">
    <header class="mb-6">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">{title}</h2>
      <p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">{description}</p>
    </header>

    <div aria-live="polite" aria-atomic="true"><slot name="primary" /></div>
    {Astro.slots.has('visualization') && <slot name="visualization" />}
    {Astro.slots.has('feedback') && <slot name="feedback" />}
    <div class="mt-6"><slot name="controls" /></div>
    {Astro.slots.has('settings') && <slot name="settings" />}
    {Astro.slots.has('secondary') && <slot name="secondary" />}
  </div>
  {Astro.slots.has('footer') && <slot name="footer" />}
</div>
