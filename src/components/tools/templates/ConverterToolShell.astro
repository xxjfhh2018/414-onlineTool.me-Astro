---
interface Props {
  inputTitle?: string;
  resultTitle?: string;
  resultDescription?: string;
}

const {
  inputTitle = 'Enter Conversion Details',
  resultTitle = 'Conversion Result',
  resultDescription = 'Complete the required fields to see the converted value.',
} = Astro.props;
---

<div class="overflow-hidden rounded-2xl border border-gray-200/60 bg-white shadow-sm dark:border-white/10 dark:bg-surface-dark">
  <div class="grid lg:grid-cols-[1.05fr_0.95fr]">
    <section class="border-b border-gray-100 p-5 dark:border-white/5 sm:p-7 lg:border-b-0 lg:border-r" aria-labelledby="converter-input-title">
      <h2 id="converter-input-title" class="text-lg font-bold text-gray-900 dark:text-white">{inputTitle}</h2>
      <div class="mt-5">
        <slot name="inputs" />
      </div>
      <div class="mt-6">
        <slot name="controls" />
      </div>
    </section>

    <section class="min-h-[28rem] bg-gray-50/70 p-5 dark:bg-white/[0.025] sm:p-7" aria-labelledby="converter-result-title">
      <h2 id="converter-result-title" class="text-lg font-bold text-gray-900 dark:text-white">{resultTitle}</h2>
      <p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">{resultDescription}</p>
      <div class="mt-5" aria-live="polite" aria-atomic="false">
        <slot name="result" />
      </div>
    </section>
  </div>

  <div class="border-t border-gray-100 px-5 py-4 dark:border-white/5 sm:px-7">
    <slot name="footer" />
  </div>
</div>
