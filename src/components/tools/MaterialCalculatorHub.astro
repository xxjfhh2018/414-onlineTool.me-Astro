<div class="max-w-4xl mx-auto">
  <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-5 sm:p-7">
    <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Choose a Material Calculator</h2>
    <p class="mt-2 text-sm leading-6 text-gray-500 dark:text-gray-400">Select the material used in your project. Each calculator estimates volume and adds material-specific weight or bag quantities.</p>
    <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {[
        ['asphalt-calculator', 'Asphalt Calculator', 'Estimate paving volume and tons.'],
        ['sand-calculator', 'Sand Calculator', 'Estimate sand volume and weight.'],
        ['gravel-calculator', 'Gravel Calculator', 'Estimate gravel yards and tons.'],
        ['topsoil-calculator', 'Topsoil Calculator', 'Estimate soil for lawns and gardens.'],
        ['concrete-calculator', 'Concrete Calculator', 'Estimate concrete yards and bags.'],
      ].map(([slug, title, description]) => (
        <a href={`/${slug}/`} class="rounded-xl border border-gray-200 dark:border-white/10 bg-gray-50/70 dark:bg-white/[0.03] p-4 hover:border-primary-400 dark:hover:border-primary-700 transition-colors">
          <h3 class="font-semibold text-gray-900 dark:text-white">{title}</h3>
          <p class="mt-1 text-sm leading-5 text-gray-500 dark:text-gray-400">{description}</p>
        </a>
      ))}
    </div>
  </div>
</div>

