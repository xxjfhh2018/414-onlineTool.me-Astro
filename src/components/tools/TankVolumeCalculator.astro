---
import FormulaToolShell from './templates/FormulaToolShell.astro';
---
<div class="tank-tool">
  <FormulaToolShell inputTitle="Estimate Tank Capacity and Fill Volume" inputDescription="Choose a rectangular or vertical cylindrical tank, enter its inside dimensions and fill level, and get capacity plus liquid volume.">
    <div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <label class="text-sm font-medium">Tank shape<select class="tv-shape field"><option value="rectangular">Rectangular</option><option value="vertical-cylinder">Vertical cylinder</option></select></label>
      <label class="text-sm font-medium">Units<select class="tv-units field"><option value="us">Feet / US gallons</option><option value="metric">Metres / litres</option></select></label>
      <label class="text-sm font-medium">Fill level (%)<input class="tv-fill field" type="number" inputmode="decimal" min="0" max="100" step="1" value="100"></label>
      <label class="tv-rect text-sm font-medium">Inside length <span class="tv-unit">(ft)</span><input class="tv-length field" type="number" inputmode="decimal" min="0" step="any" placeholder="8"></label>
      <label class="tv-rect text-sm font-medium">Inside width <span class="tv-unit">(ft)</span><input class="tv-width field" type="number" inputmode="decimal" min="0" step="any" placeholder="4"></label>
      <label class="tv-cylinder hidden text-sm font-medium">Inside diameter <span class="tv-unit">(ft)</span><input class="tv-diameter field" type="number" inputmode="decimal" min="0" step="any" placeholder="4"></label>
      <label class="text-sm font-medium">Inside height <span class="tv-unit">(ft)</span><input class="tv-height field" type="number" inputmode="decimal" min="0" step="any" placeholder="3"></label>
    </div>
    <div slot="result" class="tv-result"><div class="min-h-[11rem] rounded-xl border border-dashed border-gray-300 bg-gray-50/70 p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:border-white/15 dark:bg-white/[0.03]">Tank capacity and current liquid volume will appear here.</div></div>
    <div slot="reference" class="mt-5 flex justify-center"><button type="button" class="tv-reset min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10">Reset</button></div>
  </FormulaToolShell>
</div>
<style>.tank-tool .field{margin-top:.5rem;width:100%;border:1px solid rgb(229 231 235);border-radius:.75rem;background:rgb(249 250 251);padding:.75rem 1rem}.dark .tank-tool .field{border-color:rgb(255 255 255/.1);background:rgb(255 255 255/.05)}</style>
<script>
  import { calculateTankVolume } from '../../lib/dailyBatch260811.mjs';
  document.querySelectorAll<HTMLElement>('.tank-tool').forEach(root=>{if(root.dataset.ready)return;root.dataset.ready='true';const result=root.querySelector('.tv-result') as HTMLElement;const placeholder=result.innerHTML;const el=(s:string)=>root.querySelector(s) as HTMLInputElement|HTMLSelectElement;function sync(){const cylinder=el('.tv-shape').value==='vertical-cylinder';root.querySelectorAll<HTMLElement>('.tv-rect').forEach(node=>node.classList.toggle('hidden',cylinder));root.querySelectorAll<HTMLElement>('.tv-cylinder').forEach(node=>node.classList.toggle('hidden',!cylinder));const unit=el('.tv-units').value==='us'?'(ft)':'(m)';root.querySelectorAll<HTMLElement>('.tv-unit').forEach(node=>node.textContent=unit);}function render(){sync();const shape=el('.tv-shape').value;const required=shape==='rectangular'?['.tv-length','.tv-width','.tv-height']:['.tv-diameter','.tv-height'];if(required.some(s=>!el(s).value)){result.innerHTML=placeholder;return;}try{const value=calculateTankVolume({shape,unitSystem:el('.tv-units').value,length:el('.tv-length').value,width:el('.tv-width').value,height:el('.tv-height').value,diameter:el('.tv-diameter').value,fillPercent:el('.tv-fill').value});const headroom=value.capacityDisplay-value.liquidDisplay;result.innerHTML=`<div class="grid gap-3 sm:grid-cols-2"><div class="rounded-xl border border-primary-100 bg-primary-50 p-5 text-center dark:border-primary-800/30 dark:bg-primary-900/20"><div class="text-sm text-gray-600">Tank capacity</div><div class="mt-1 text-3xl font-bold text-primary-600 dark:text-primary-400">${value.capacityDisplay.toLocaleString(undefined,{maximumFractionDigits:2})} ${value.displayUnit}</div></div><div class="rounded-xl bg-gray-50 p-5 text-center dark:bg-white/5"><div class="text-sm text-gray-500">Liquid at ${value.fillPercent}%</div><div class="mt-1 text-3xl font-bold">${value.liquidDisplay.toLocaleString(undefined,{maximumFractionDigits:2})} ${value.displayUnit}</div><div class="mt-1 text-xs text-gray-500">${value.liquidCubic.toFixed(3)} ${value.cubicUnit}</div></div></div><div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10"><strong>Capacity context:</strong> ${value.fillPercent}% full leaves about ${headroom.toLocaleString(undefined,{maximumFractionDigits:2})} ${value.displayUnit} of theoretical headroom.</div>`;}catch(error){result.innerHTML=`<div class="min-h-[11rem] rounded-xl border border-amber-200 bg-amber-50 p-4 flex items-center justify-center text-sm text-amber-800 dark:border-amber-800/40 dark:bg-amber-900/10 dark:text-amber-300">${error instanceof Error?error.message:'Check the tank dimensions.'}</div>`;}}root.addEventListener('input',render);root.addEventListener('change',render);root.querySelector('.tv-reset')?.addEventListener('click',()=>{el('.tv-shape').value='rectangular';el('.tv-units').value='us';el('.tv-fill').value='100';for(const s of ['.tv-length','.tv-width','.tv-height','.tv-diameter']) el(s).value='';render();});sync();});
</script>
