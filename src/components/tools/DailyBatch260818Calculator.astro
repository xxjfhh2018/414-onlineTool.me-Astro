---
import FormulaToolShell from './templates/FormulaToolShell.astro';
const { course } = Astro.props;
const field = 'mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5';
const placeholder = 'min-h-[11rem] rounded-xl border border-dashed border-gray-300 bg-gray-50/70 p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:border-white/15 dark:bg-white/[0.03]';
const resetClass = 'min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10';
---

{course === 'mcat-score-calculator' && <div class="mcat-tool"><FormulaToolShell inputTitle="Add Your Scaled MCAT Section Scores" inputDescription="Enter the four AAMC scaled section scores (118–132 each) to calculate the official total-score arithmetic instantly."><div slot="inputs" class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-medium">Chemical and Physical Foundations<input class:list={[field,'mcat-cp']} type="number" min="118" max="132" step="1" inputmode="numeric" placeholder="125" /></label><label class="text-sm font-medium">Critical Analysis and Reasoning<input class:list={[field,'mcat-cars']} type="number" min="118" max="132" step="1" inputmode="numeric" placeholder="125" /></label><label class="text-sm font-medium">Biological and Biochemical Foundations<input class:list={[field,'mcat-bb']} type="number" min="118" max="132" step="1" inputmode="numeric" placeholder="125" /></label><label class="text-sm font-medium">Psychological, Social, and Biological Foundations<input class:list={[field,'mcat-ps']} type="number" min="118" max="132" step="1" inputmode="numeric" placeholder="125" /></label></div><div slot="result" class="mcat-result"><div class={placeholder}>Your 472–528 total and section comparison will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class:list={[resetClass,'mcat-reset']} type="button">Reset</button></div></FormulaToolShell></div>}

{course === 'hydrates-calculator' && <div class="hydrate-tool"><FormulaToolShell inputTitle="Calculate Hydrate Composition" inputDescription="Enter the anhydrous salt molar mass and hydration number; add a sample mass if you also need grams of water and salt."><div slot="inputs" class="grid gap-4 sm:grid-cols-3"><label class="text-sm font-medium">Anhydrous molar mass (g/mol)<input class:list={[field,'hyd-anhydrous']} type="number" min="0.001" max="10000" step="any" inputmode="decimal" placeholder="159.609" /></label><label class="text-sm font-medium">Water molecules (n)<input class:list={[field,'hyd-water']} type="number" min="1" max="100" step="1" inputmode="numeric" placeholder="5" /></label><label class="text-sm font-medium">Sample mass (g) <span class="text-gray-400">optional</span><input class:list={[field,'hyd-sample']} type="number" min="0.001" max="1000000" step="any" inputmode="decimal" placeholder="25" /></label></div><div slot="result" class="hydrate-result"><div class={placeholder}>Hydrate molar mass, water percentage, and optional sample composition will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class:list={[resetClass,'hydrate-reset']} type="button">Reset</button></div></FormulaToolShell></div>}

<script>
import { calculateHydrate, calculateMcatScore } from '../../lib/dailyBatch260818.mjs';
const get = (root:HTMLElement, selector:string) => (root.querySelector(selector) as HTMLInputElement).value;
const escapeHtml = (value:unknown) => String(value).replace(/[&<>"']/g, character => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[character] as string));
const number = (value:number, digits=3) => value.toLocaleString(undefined,{maximumFractionDigits:digits});
const warning = (message:string) => `<div class="min-h-[11rem] rounded-xl border border-amber-200 bg-amber-50 p-4 flex items-center justify-center text-center text-sm text-amber-800 dark:border-amber-800/40 dark:bg-amber-900/10 dark:text-amber-300">${escapeHtml(message)}</div>`;
const card = (label:string,value:string,detail:string,anchor:string) => `<div class="min-h-[11rem] rounded-xl border border-primary-100 bg-primary-50 p-5 text-center dark:border-primary-800/30 dark:bg-primary-900/20"><div class="text-sm text-gray-600 dark:text-gray-300">${label}</div><div class="mt-2 text-4xl font-bold text-primary-600 dark:text-primary-400">${value}</div><div class="mt-3 text-sm leading-6 text-gray-500">${detail}</div></div><div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300">${anchor}</div>`;

document.querySelectorAll<HTMLElement>('.mcat-tool').forEach(root=>{const output=root.querySelector('.mcat-result') as HTMLElement,initial=output.innerHTML,selectors=['.mcat-cp','.mcat-cars','.mcat-bb','.mcat-ps'],labels=['Chem/Phys','CARS','Bio/Biochem','Psych/Soc'];const render=()=>{if(selectors.some(selector=>!get(root,selector))){output.innerHTML=initial;return;}try{const result=calculateMcatScore({chemPhys:get(root,selectors[0]),cars:get(root,selectors[1]),bioBiochem:get(root,selectors[2]),psychSoc:get(root,selectors[3])});const sectionText=result.sections.map((score,index)=>`${labels[index]}: <strong>${score}</strong>`).join(' · ');const spread=Math.max(...result.sections)-Math.min(...result.sections);output.innerHTML=card('Total MCAT score',String(result.total),`${sectionText}<br>Section average: ${number(result.sectionAverage,2)} · strongest-to-weakest spread: ${spread}`,'<strong>Score context:</strong> The AAMC total range is 472–528. This tool adds scaled scores only; it does not convert raw correct answers or estimate admission chances.');}catch(error){output.innerHTML=warning(error instanceof Error?error.message:'Check the four section scores.')}};root.addEventListener('input',render);root.querySelector('.mcat-reset')?.addEventListener('click',()=>{selectors.forEach(selector=>(root.querySelector(selector)as HTMLInputElement).value='');render()});});

document.querySelectorAll<HTMLElement>('.hydrate-tool').forEach(root=>{const output=root.querySelector('.hydrate-result') as HTMLElement,initial=output.innerHTML;const render=()=>{if(!get(root,'.hyd-anhydrous')||!get(root,'.hyd-water')){output.innerHTML=initial;return;}try{const result=calculateHydrate({anhydrousMolarMass:get(root,'.hyd-anhydrous'),waterMolecules:get(root,'.hyd-water'),sampleMass:get(root,'.hyd-sample')});const sample=result.sampleWaterMass===null?'Add sample mass to estimate grams of water and anhydrous salt.':`In the sample: ${number(result.sampleWaterMass)} g water · ${number(result.sampleAnhydrousMass as number)} g anhydrous salt`;output.innerHTML=card('Theoretical water by mass',`${number(result.percentWater)}%`,`Hydrate molar mass: ${number(result.hydrateMolarMass)} g/mol · water contribution: ${number(result.waterMassPerMole)} g/mol<br>${sample}`,'<strong>Composition context:</strong> Water % + anhydrous salt % = 100%. This is a theoretical formula result based on the entered anhydrous molar mass and hydration number.');}catch(error){output.innerHTML=warning(error instanceof Error?error.message:'Check the hydrate inputs.')}};root.addEventListener('input',render);root.querySelector('.hydrate-reset')?.addEventListener('click',()=>{['.hyd-anhydrous','.hyd-water','.hyd-sample'].forEach(selector=>(root.querySelector(selector)as HTMLInputElement).value='');render()});});
</script>
