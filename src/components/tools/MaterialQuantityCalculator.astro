---
interface Props { course?: string; }
const { course = 'gravel-calculator' } = Astro.props;

const configs: Record<string, {
  name: string;
  density: number;
  primary: 'tons' | 'yards';
  resultLabel: string;
  note: string;
}> = {
  'asphalt-calculator': {
    name: 'Asphalt', density: 145, primary: 'tons', resultLabel: 'Estimated Asphalt Required',
    note: 'The default density is 145 lb/ft³. Asphalt mix density and field compaction can change the delivered tonnage.'
  },
  'sand-calculator': {
    name: 'Sand', density: 100, primary: 'yards', resultLabel: 'Estimated Sand Volume',
    note: 'The default density is 100 lb/ft³. Moisture, grain size, and compaction can change actual weight.'
  },
  'gravel-calculator': {
    name: 'Gravel', density: 105, primary: 'yards', resultLabel: 'Estimated Gravel Volume',
    note: 'The default density is 105 lb/ft³. Stone size, moisture, and compaction can change actual weight.'
  },
  'topsoil-calculator': {
    name: 'Topsoil', density: 75, primary: 'yards', resultLabel: 'Estimated Topsoil Volume',
    note: 'The default density is 75 lb/ft³. Screened, wet, and compacted soils can have very different weights.'
  },
  'concrete-calculator': {
    name: 'Concrete', density: 145, primary: 'yards', resultLabel: 'Estimated Concrete Volume',
    note: 'The estimate includes the selected waste allowance. Confirm order minimums, truck capacity, and bag yield with the supplier.'
  },
};

const config = configs[course] || configs['gravel-calculator'];
const isConcrete = course === 'concrete-calculator';
---

<div class="max-w-3xl mx-auto material-quantity-tool" data-tool={course} data-density={config.density} data-primary={config.primary} data-result-label={config.resultLabel} data-material={config.name} data-concrete={String(isConcrete)}>
  <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-5 sm:p-6">
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Area Shape</label>
        <select class="mq-shape w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200">
          <option value="rectangle">Rectangle</option>
          <option value="circle">Circle</option>
        </select>
      </div>
      <div class="mq-length-field">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Length (ft)</label>
        <input class="mq-length w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" type="number" inputmode="decimal" min="0.01" step="0.01" placeholder="20" />
      </div>
      <div class="mq-width-field">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Width (ft)</label>
        <input class="mq-width w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" type="number" inputmode="decimal" min="0.01" step="0.01" placeholder="10" />
      </div>
      <div class="mq-diameter-field hidden">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Diameter (ft)</label>
        <input class="mq-diameter w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" type="number" inputmode="decimal" min="0.01" step="0.01" placeholder="12" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Depth / Thickness (in)</label>
        <input class="mq-depth w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" type="number" inputmode="decimal" min="0.01" step="0.01" placeholder={isConcrete ? '4' : '3'} />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Waste Allowance (%)</label>
        <input class="mq-waste w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none focus:border-primary-500 text-gray-800 dark:text-gray-200" type="number" inputmode="decimal" min="0" max="100" step="1" value="10" />
      </div>
    </div>

    <details class="mt-5 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200/60 dark:border-white/10 p-4">
      <summary class="cursor-pointer text-sm font-semibold text-gray-800 dark:text-gray-200">Advanced material settings</summary>
      <div class="grid sm:grid-cols-2 gap-4 mt-4">
        {!isConcrete && (
          <div>
            <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Material Density (lb/ft³)</label>
            <input class="mq-density w-full px-3 py-2.5 rounded-lg bg-white dark:bg-surface-dark border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" type="number" inputmode="decimal" min="0.01" step="0.1" value={config.density} />
          </div>
        )}
        {isConcrete ? (
          <div>
            <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Bag Size</label>
            <select class="mq-bag-size w-full px-3 py-2.5 rounded-lg bg-white dark:bg-surface-dark border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200">
              <option value="0.3">40 lb bag (about 0.30 ft³)</option>
              <option value="0.45">60 lb bag (about 0.45 ft³)</option>
              <option value="0.6" selected>80 lb bag (about 0.60 ft³)</option>
            </select>
          </div>
        ) : (
          <div>
            <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Price per Ton (optional)</label>
            <input class="mq-price w-full px-3 py-2.5 rounded-lg bg-white dark:bg-surface-dark border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" type="number" inputmode="decimal" min="0" step="0.01" placeholder="0.00" />
          </div>
        )}
        {isConcrete && (
          <div>
            <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Ready-mix Price per yd³ (optional)</label>
            <input class="mq-price w-full px-3 py-2.5 rounded-lg bg-white dark:bg-surface-dark border border-gray-200 dark:border-white/10 text-gray-800 dark:text-gray-200" type="number" inputmode="decimal" min="0" step="0.01" placeholder="0.00" />
          </div>
        )}
      </div>
    </details>

    <div class="mt-5 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-200/60 dark:border-white/10 px-4 py-3 text-sm text-gray-600 dark:text-gray-400">
      {isConcrete ? 'Current settings: 10% waste · 80 lb bag yield available in Advanced settings.' : `Current default density: ${config.density} lb/ft³ · editable in Advanced settings.`}
    </div>

    <div class="mq-result mt-5 min-h-[12rem] rounded-xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:text-gray-400" aria-live="polite">
      Enter the project dimensions to see the material estimate
    </div>
  </div>
  <p class="mt-4 text-xs leading-5 text-gray-500 dark:text-gray-400">{config.note}</p>
</div>

<script>
  (function () {
    document.querySelectorAll<HTMLElement>('.material-quantity-tool').forEach(root => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';
      const getInput = (selector: string) => root.querySelector<HTMLInputElement>(selector);
      const shape = root.querySelector<HTMLSelectElement>('.mq-shape');
      const length = getInput('.mq-length');
      const width = getInput('.mq-width');
      const diameter = getInput('.mq-diameter');
      const depth = getInput('.mq-depth');
      const waste = getInput('.mq-waste');
      const densityInput = getInput('.mq-density');
      const price = getInput('.mq-price');
      const bagSize = root.querySelector<HTMLSelectElement>('.mq-bag-size');
      const result = root.querySelector<HTMLElement>('.mq-result');
      const isConcrete = root.dataset.concrete === 'true';
      const placeholder = 'Enter the project dimensions to see the material estimate';

      function setPlaceholder() {
        if (!result) return;
        result.className = 'mq-result mt-5 min-h-[12rem] rounded-xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:text-gray-400';
        result.textContent = placeholder;
      }

      function setError(message: string) {
        if (!result) return;
        result.className = 'mq-result mt-5 min-h-[12rem] rounded-xl bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800/40 p-5 flex items-center justify-center text-center text-sm text-amber-800 dark:text-amber-300';
        result.textContent = message;
      }

      function calculate() {
        if (!result || !shape) return;
        const circular = shape.value === 'circle';
        const required = circular ? [diameter?.value, depth?.value] : [length?.value, width?.value, depth?.value];
        if (required.some(value => !value)) {
          setPlaceholder();
          return;
        }
        const lengthValue = Number(length?.value);
        const widthValue = Number(width?.value);
        const diameterValue = Number(diameter?.value);
        const depthValue = Number(depth?.value);
        const wasteValue = Number(waste?.value || 0);
        const density = Number(densityInput?.value || root.dataset.density);
        const dimensionsValid = circular
          ? Number.isFinite(diameterValue) && diameterValue > 0
          : Number.isFinite(lengthValue) && lengthValue > 0 && Number.isFinite(widthValue) && widthValue > 0;
        if (!dimensionsValid || !Number.isFinite(depthValue) || depthValue <= 0 || !Number.isFinite(wasteValue) || wasteValue < 0 || wasteValue > 100 || !Number.isFinite(density) || density <= 0) {
          setError('Dimensions, depth, and density must be greater than zero. Waste allowance must be between 0% and 100%.');
          return;
        }
        const areaSqFt = circular ? Math.PI * Math.pow(diameterValue / 2, 2) : lengthValue * widthValue;
        const rawCubicFeet = areaSqFt * (depthValue / 12);
        const adjustedCubicFeet = rawCubicFeet * (1 + wasteValue / 100);
        const cubicYards = adjustedCubicFeet / 27;
        const cubicMeters = adjustedCubicFeet * 0.0283168466;
        const pounds = adjustedCubicFeet * density;
        const tons = pounds / 2000;
        const primaryValue = root.dataset.primary === 'tons' ? `${tons.toFixed(2)} tons` : `${cubicYards.toFixed(2)} yd³`;
        const costValue = Number(price?.value);
        const estimatedCost = Number.isFinite(costValue) && costValue > 0
          ? (isConcrete ? cubicYards * costValue : tons * costValue)
          : null;
        const bagYield = Number(bagSize?.value || 0.6);
        const bags = Math.ceil(adjustedCubicFeet / bagYield);
        result.className = 'mq-result mt-5 min-h-[12rem] rounded-xl bg-primary-50 dark:bg-primary-900/20 border border-primary-100 dark:border-primary-800/30 p-5 text-center';
        result.innerHTML = `<div class="text-sm text-gray-600 dark:text-gray-400">${root.dataset.resultLabel}</div><div class="mt-1 text-3xl font-bold text-primary-600 dark:text-primary-400">${primaryValue}</div><div class="mt-4 grid grid-cols-2 ${isConcrete ? 'sm:grid-cols-3' : 'sm:grid-cols-5'} gap-2 text-sm">${isConcrete ? '' : `<div class="rounded-lg bg-white/70 dark:bg-white/5 p-3"><div class="text-xs text-gray-500 dark:text-gray-400">Cubic Yards</div><div class="mt-1 font-semibold text-gray-900 dark:text-white">${cubicYards.toFixed(2)} yd³</div></div>`}<div class="rounded-lg bg-white/70 dark:bg-white/5 p-3"><div class="text-xs text-gray-500 dark:text-gray-400">Cubic Feet</div><div class="mt-1 font-semibold text-gray-900 dark:text-white">${adjustedCubicFeet.toFixed(2)} ft³</div></div><div class="rounded-lg bg-white/70 dark:bg-white/5 p-3"><div class="text-xs text-gray-500 dark:text-gray-400">Cubic Meters</div><div class="mt-1 font-semibold text-gray-900 dark:text-white">${cubicMeters.toFixed(2)} m³</div></div>${isConcrete ? `<div class="rounded-lg bg-white/70 dark:bg-white/5 p-3"><div class="text-xs text-gray-500 dark:text-gray-400">Bags Required</div><div class="mt-1 font-semibold text-gray-900 dark:text-white">${bags} bags</div></div>` : `<div class="rounded-lg bg-white/70 dark:bg-white/5 p-3"><div class="text-xs text-gray-500 dark:text-gray-400">Weight</div><div class="mt-1 font-semibold text-gray-900 dark:text-white">${tons.toFixed(2)} tons</div></div><div class="rounded-lg bg-white/70 dark:bg-white/5 p-3"><div class="text-xs text-gray-500 dark:text-gray-400">Pounds</div><div class="mt-1 font-semibold text-gray-900 dark:text-white">${Math.round(pounds).toLocaleString()} lb</div></div>`}</div><div class="mt-3 text-xs text-gray-500 dark:text-gray-400">Includes ${wasteValue.toFixed(0)}% waste allowance${estimatedCost === null ? '' : ` · estimated material cost: $${estimatedCost.toFixed(2)}`}</div>`;
      }

      function updateShape() {
        const circular = shape?.value === 'circle';
        root.querySelector('.mq-length-field')?.classList.toggle('hidden', circular);
        root.querySelector('.mq-width-field')?.classList.toggle('hidden', circular);
        root.querySelector('.mq-diameter-field')?.classList.toggle('hidden', !circular);
        calculate();
      }

      root.addEventListener('input', event => {
        if ((event.target as HTMLElement).matches('input, select')) calculate();
      });
      root.addEventListener('change', event => {
        if ((event.target as HTMLElement).matches('.mq-shape')) updateShape();
        else if ((event.target as HTMLElement).matches('input, select')) calculate();
      });
    });
  })();
</script>
