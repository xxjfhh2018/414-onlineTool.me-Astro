---
import FormulaToolShell from './templates/FormulaToolShell.astro';
const { course } = Astro.props;
const field = 'mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-white/10 dark:bg-white/5';
const placeholder = 'min-h-[11rem] rounded-xl border border-dashed border-gray-300 bg-gray-50/70 p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:border-white/15 dark:bg-white/[0.03]';
const resetClass = 'min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold dark:border-white/10';
---

{course === 'sig-fig-calculator' && <div class="sf-tool"><FormulaToolShell inputTitle="Round a Number to Significant Figures" inputDescription="Enter a decimal or scientific-notation value and choose how many significant figures to keep."><div slot="inputs" class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-medium">Number to round<input class:list={[field,'sf-value']} type="text" inputmode="decimal" placeholder="0.004565" /></label><label class="text-sm font-medium">Significant figures<input class:list={[field,'sf-count']} type="number" min="1" max="15" step="1" inputmode="numeric" placeholder="3" /></label></div><div slot="result" class="sf-result"><div class={placeholder}>The rounded decimal, scientific notation, and detected input precision will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class:list={[resetClass,'sf-reset']} type="button">Reset</button></div></FormulaToolShell></div>}

{course === 'binomial-distribution-calculator' && <div class="bd-tool"><FormulaToolShell inputTitle="Calculate a Binomial Probability" inputDescription="Enter trials, successes, and a fixed success probability, then choose exact, at-most, or at-least probability."><div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><label class="text-sm font-medium">Independent trials (n)<input class:list={[field,'bd-n']} type="number" min="1" max="1000" step="1" inputmode="numeric" placeholder="10" /></label><label class="text-sm font-medium">Successes (x)<input class:list={[field,'bd-x']} type="number" min="0" max="1000" step="1" inputmode="numeric" placeholder="3" /></label><label class="text-sm font-medium">Success probability (%)<input class:list={[field,'bd-p']} type="number" min="0" max="100" step="0.01" inputmode="decimal" placeholder="50" /></label><label class="text-sm font-medium">Probability event<select class:list={[field,'bd-event']}><option value="exact">Exactly x</option><option value="at-most">At most x</option><option value="at-least">At least x</option></select></label></div><div slot="result" class="bd-result"><div class={placeholder}>The selected probability, exact probability, cumulative probabilities, mean, and standard deviation will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class:list={[resetClass,'bd-reset']} type="button">Reset</button></div></FormulaToolShell></div>}

{course === 'percentage-calculator' && <div class="pc-tool"><FormulaToolShell inputTitle="Calculate a Percentage" inputDescription="Choose a percentage question, enter the two values, and review the result and difference instantly."><div slot="inputs" class="grid gap-4 sm:grid-cols-3"><label class="text-sm font-medium">Calculation<select class:list={[field,'pc-mode']}><option value="of">What is A% of B?</option><option value="what-percent">A is what percent of B?</option><option value="change">Percentage change from A to B</option></select></label><label class="text-sm font-medium"><span class="pc-first-label">Percentage A (%)</span><input class:list={[field,'pc-first']} type="number" step="any" inputmode="decimal" placeholder="20" /></label><label class="text-sm font-medium"><span class="pc-second-label">Value B</span><input class:list={[field,'pc-second']} type="number" step="any" inputmode="decimal" placeholder="150" /></label></div><div slot="result" class="pc-result"><div class={placeholder}>The percentage result and calculation context will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class:list={[resetClass,'pc-reset']} type="button">Reset</button></div></FormulaToolShell></div>}

{course === 'binomial-calculator' && <div class="bn-tool"><FormulaToolShell inputTitle="Expand a Binomial" inputDescription="Enter a, b, and n to expand (ax + b)^n; optionally enter k to inspect one theorem coefficient."><div slot="inputs" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><label class="text-sm font-medium">x coefficient (a)<input class:list={[field,'bn-a']} type="number" min="-1000000" max="1000000" step="any" inputmode="decimal" placeholder="2" /></label><label class="text-sm font-medium">Constant (b)<input class:list={[field,'bn-b']} type="number" min="-1000000" max="1000000" step="any" inputmode="decimal" placeholder="3" /></label><label class="text-sm font-medium">Exponent (n)<input class:list={[field,'bn-n']} type="number" min="0" max="20" step="1" inputmode="numeric" placeholder="3" /></label><label class="text-sm font-medium">Term index k <span class="text-gray-400">optional</span><input class:list={[field,'bn-k']} type="number" min="0" max="20" step="1" inputmode="numeric" placeholder="1" /></label></div><div slot="result" class="bn-result"><div class={placeholder}>The expanded polynomial, term count, and optional k coefficient will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class:list={[resetClass,'bn-reset']} type="button">Reset</button></div></FormulaToolShell></div>}

{course === 'statistics-calculator' && <div class="st-tool"><FormulaToolShell inputTitle="Summarize a Number List" inputDescription="Paste numbers separated by commas, spaces, semicolons, or new lines to get descriptive statistics."><div slot="inputs"><label class="text-sm font-medium">Data values<textarea class:list={[field,'st-values','min-h-32']} placeholder="2, 4, 4, 6, 8"></textarea></label></div><div slot="result" class="st-result"><div class={placeholder}>Count, sum, mean, median, mode, range, quartiles, variance, and standard deviation will appear here.</div></div><div slot="reference" class="mt-5 flex justify-center"><button class:list={[resetClass,'st-reset']} type="button">Reset</button></div></FormulaToolShell></div>}

<script>
import { calculateBinomialDistribution, calculatePercentage, calculateStatistics, expandBinomial, roundToSignificantFigures } from '../../lib/dailyBatch260815.mjs';
const get = (root:HTMLElement, selector:string) => (root.querySelector(selector) as HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement).value;
const escapeHtml = (value:unknown) => String(value).replace(/[&<>"']/g, character => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[character] as string));
const number = (value:number, maximumFractionDigits=8) => value.toLocaleString(undefined,{maximumFractionDigits});
const percent = (value:number) => `${(value * 100).toLocaleString(undefined,{maximumFractionDigits:8})}%`;
const warning = (message:string) => `<div class="min-h-[11rem] rounded-xl border border-amber-200 bg-amber-50 p-4 flex items-center justify-center text-center text-sm text-amber-800 dark:border-amber-800/40 dark:bg-amber-900/10 dark:text-amber-300">${escapeHtml(message)}</div>`;
const card = (label:string, value:string, detail:string, anchor:string) => `<div class="min-h-[11rem] rounded-xl border border-primary-100 bg-primary-50 p-5 text-center dark:border-primary-800/30 dark:bg-primary-900/20"><div class="text-sm text-gray-600 dark:text-gray-300">${escapeHtml(label)}</div><div class="mt-2 break-words text-3xl font-bold text-primary-600 dark:text-primary-400">${escapeHtml(value)}</div><div class="mt-3 text-sm leading-6 text-gray-500">${detail}</div></div><div class="mt-3 rounded-xl border border-blue-100 bg-blue-50/70 px-4 py-3 text-center text-xs leading-5 text-blue-800 dark:border-blue-800/30 dark:bg-blue-900/10 dark:text-blue-300">${anchor}</div>`;

document.querySelectorAll<HTMLElement>('.sf-tool').forEach(root => { const output=root.querySelector('.sf-result') as HTMLElement, initial=output.innerHTML; const render=()=>{if(!get(root,'.sf-value')||!get(root,'.sf-count')){output.innerHTML=initial;return;}try{const result=roundToSignificantFigures({value:get(root,'.sf-value'),significantFigures:get(root,'.sf-count')});output.innerHTML=card('Rounded value',result.rounded,`Scientific notation: <strong>${escapeHtml(result.scientific)}</strong><br>Entered value shows ${result.inputSignificantFigures} significant figure${result.inputSignificantFigures===1?'':'s'}.`,'<strong>Rounding context:</strong> Exact halfway cases use the NIST half-even rule, which avoids always rounding 5 upward.');}catch(error){output.innerHTML=warning(error instanceof Error?error.message:'Check the number and precision.')}};root.addEventListener('input',render);root.querySelector('.sf-reset')?.addEventListener('click',()=>{for(const selector of['.sf-value','.sf-count'])(root.querySelector(selector)as HTMLInputElement).value='';render()}); });

document.querySelectorAll<HTMLElement>('.bd-tool').forEach(root => { const output=root.querySelector('.bd-result') as HTMLElement, initial=output.innerHTML; const render=()=>{if(['.bd-n','.bd-x','.bd-p'].some(selector=>get(root,selector)==='')){output.innerHTML=initial;return;}try{const result=calculateBinomialDistribution({trials:get(root,'.bd-n'),successes:get(root,'.bd-x'),probabilityPercent:get(root,'.bd-p'),event:get(root,'.bd-event')});const labels={exact:'Exactly x','at-most':'At most x','at-least':'At least x'};output.innerHTML=card(labels[result.event],percent(result.selected),`Exact: ${percent(result.exact)} · At most: ${percent(result.atMost)} · At least: ${percent(result.atLeast)}<br>Mean: ${number(result.mean)} · Standard deviation: ${number(result.standardDeviation)}`,'<strong>Model context:</strong> Use this only when trials are independent, each trial has two outcomes, and the success probability stays fixed.');}catch(error){output.innerHTML=warning(error instanceof Error?error.message:'Check the probability inputs.')}};root.addEventListener('input',render);root.addEventListener('change',render);root.querySelector('.bd-reset')?.addEventListener('click',()=>{for(const selector of['.bd-n','.bd-x','.bd-p'])(root.querySelector(selector)as HTMLInputElement).value='';(root.querySelector('.bd-event')as HTMLSelectElement).value='exact';render()}); });

document.querySelectorAll<HTMLElement>('.pc-tool').forEach(root => { const output=root.querySelector('.pc-result') as HTMLElement, initial=output.innerHTML; const sync=()=>{const mode=get(root,'.pc-mode');(root.querySelector('.pc-first-label')as HTMLElement).textContent=mode==='of'?'Percentage A (%)':mode==='what-percent'?'Part A':'Starting value A';(root.querySelector('.pc-second-label')as HTMLElement).textContent=mode==='of'?'Value B':mode==='what-percent'?'Comparison value B':'Ending value B';}; const render=()=>{sync();if(['.pc-first','.pc-second'].some(selector=>get(root,selector)==='')){output.innerHTML=initial;return;}try{const result=calculatePercentage({mode:get(root,'.pc-mode'),first:get(root,'.pc-first'),second:get(root,'.pc-second')});const isPercent=result.mode!=='of';const main=isPercent?`${number(result.result)}%`:number(result.result);const detail=result.mode==='of'?`${escapeHtml(get(root,'.pc-first'))}% of ${escapeHtml(get(root,'.pc-second'))}`:result.mode==='what-percent'?`${escapeHtml(get(root,'.pc-first'))} ÷ ${escapeHtml(get(root,'.pc-second'))} × 100`:`Difference: ${number(result.difference as number)} · change from ${escapeHtml(get(root,'.pc-first'))} to ${escapeHtml(get(root,'.pc-second'))}`;output.innerHTML=card('Percentage result',main,detail,'<strong>Comparison context:</strong> Percentage change uses the starting value as its denominator, so reversing the two values produces a different percentage.');}catch(error){output.innerHTML=warning(error instanceof Error?error.message:'Check the percentage values.')}};root.addEventListener('input',render);root.addEventListener('change',render);root.querySelector('.pc-reset')?.addEventListener('click',()=>{for(const selector of['.pc-first','.pc-second'])(root.querySelector(selector)as HTMLInputElement).value='';(root.querySelector('.pc-mode')as HTMLSelectElement).value='of';render()});sync(); });

document.querySelectorAll<HTMLElement>('.bn-tool').forEach(root => { const output=root.querySelector('.bn-result') as HTMLElement, initial=output.innerHTML; const render=()=>{if(['.bn-a','.bn-b','.bn-n'].some(selector=>get(root,selector)==='')){output.innerHTML=initial;return;}try{const result=expandBinomial({a:get(root,'.bn-a'),b:get(root,'.bn-b'),exponent:get(root,'.bn-n'),k:get(root,'.bn-k')});const selected=result.selectedCoefficient===null?'Add k to inspect the coefficient of x^(n−k).':`k = ${result.selectedK}: coefficient ${number(result.selectedCoefficient,10)}`;output.innerHTML=card('Expanded polynomial',result.expansion,`${selected}<br>Nonzero terms: ${result.termCount}`,'<strong>Theorem context:</strong> k runs from 0 to n; the k-th coefficient multiplies x^(n−k). Zero coefficients may remove terms from the displayed expansion.');}catch(error){output.innerHTML=warning(error instanceof Error?error.message:'Check the binomial inputs.')}};root.addEventListener('input',render);root.querySelector('.bn-reset')?.addEventListener('click',()=>{for(const selector of['.bn-a','.bn-b','.bn-n','.bn-k'])(root.querySelector(selector)as HTMLInputElement).value='';render()}); });

document.querySelectorAll<HTMLElement>('.st-tool').forEach(root => { const output=root.querySelector('.st-result') as HTMLElement, initial=output.innerHTML; const render=()=>{if(!get(root,'.st-values').trim()){output.innerHTML=initial;return;}try{const result=calculateStatistics(get(root,'.st-values'));const modes=result.modes.length?result.modes.map(value=>number(value)).join(', '):'No repeated mode';output.innerHTML=card('Mean',number(result.mean),`Count: ${result.count} · Sum: ${number(result.sum)} · Median: ${number(result.median)} · Mode: ${modes}<br>Min: ${number(result.min)} · Max: ${number(result.max)} · Range: ${number(result.range)}<br>Population SD: ${number(result.populationStandardDeviation)} · Sample SD: ${result.sampleStandardDeviation===null?'Needs at least 2 values':number(result.sampleStandardDeviation)}`,'<strong>Method context:</strong> Q1 and Q3 use the median-of-halves method with the overall median excluded for odd-sized lists. Sample variance divides by n−1; population variance divides by n.');}catch(error){output.innerHTML=warning(error instanceof Error?error.message:'Check the data list.')}};root.addEventListener('input',render);root.querySelector('.st-reset')?.addEventListener('click',()=>{(root.querySelector('.st-values')as HTMLTextAreaElement).value='';render()}); });
</script>
