---
import ConverterToolShell from './templates/ConverterToolShell.astro';
import { SWIM_COURSES, SWIM_EVENTS } from '../../lib/swimTimeConverter.mjs';
---

<div id="swim-time-converter">
  <ConverterToolShell
    inputTitle="Enter Your Swim"
    resultTitle="Estimated Course Equivalent"
    resultDescription="See the converted time, average pace, and even-split estimates as soon as the swim time is valid."
  >
    <form slot="inputs" id="stc-form" class="space-y-4" novalidate>
      <div>
        <label for="stc-event" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300">Swimming event</label>
        <select id="stc-event" class="w-full rounded-xl border border-gray-200 bg-white px-3.5 py-3 text-sm text-gray-900 outline-none transition focus:border-primary-400 focus:ring-2 focus:ring-primary-500/15 dark:border-white/10 dark:bg-white/5 dark:text-white">
          {SWIM_EVENTS.map(event => <option value={event.key} selected={event.key === '100-free'}>{event.label}</option>)}
        </select>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="stc-sex" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300">NCAA factor table</label>
          <select id="stc-sex" class="w-full rounded-xl border border-gray-200 bg-white px-3.5 py-3 text-sm text-gray-900 outline-none transition focus:border-primary-400 focus:ring-2 focus:ring-primary-500/15 dark:border-white/10 dark:bg-white/5 dark:text-white">
            <option value="men">Men</option>
            <option value="women">Women</option>
          </select>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Used when an LCM course is selected.</p>
        </div>
        <div>
          <label for="stc-time" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300">Swim time</label>
          <input id="stc-time" type="text" inputmode="decimal" autocomplete="off" placeholder="1:00.00" aria-describedby="stc-time-help" class="w-full rounded-xl border border-gray-200 bg-white px-3.5 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-primary-400 focus:ring-2 focus:ring-primary-500/15 dark:border-white/10 dark:bg-white/5 dark:text-white" />
          <p id="stc-time-help" class="mt-1 text-xs text-gray-500 dark:text-gray-400">Use seconds or minutes:seconds, such as 58.42 or 1:02.35.</p>
        </div>
      </div>

      <div class="grid grid-cols-[1fr_auto_1fr] items-end gap-2">
        <div>
          <label for="stc-from" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300">From course</label>
          <select id="stc-from" class="w-full rounded-xl border border-gray-200 bg-white px-3 py-3 text-sm text-gray-900 outline-none transition focus:border-primary-400 focus:ring-2 focus:ring-primary-500/15 dark:border-white/10 dark:bg-white/5 dark:text-white">
            {Object.entries(SWIM_COURSES).map(([value, course]) => <option value={value} selected={value === 'SCY'}>{course.label}</option>)}
          </select>
        </div>
        <button id="stc-swap" type="button" aria-label="Swap source and target pool courses" class="mb-0.5 inline-flex h-11 w-11 items-center justify-center rounded-xl border border-gray-200 bg-white text-gray-600 transition hover:border-primary-300 hover:text-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500/30 dark:border-white/10 dark:bg-white/5 dark:text-gray-300">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 16-4-4 4-4"/><path d="M3 12h18"/><path d="m17 8 4 4-4 4"/></svg>
        </button>
        <div>
          <label for="stc-to" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300">To course</label>
          <select id="stc-to" class="w-full rounded-xl border border-gray-200 bg-white px-3 py-3 text-sm text-gray-900 outline-none transition focus:border-primary-400 focus:ring-2 focus:ring-primary-500/15 dark:border-white/10 dark:bg-white/5 dark:text-white">
            {Object.entries(SWIM_COURSES).map(([value, course]) => <option value={value} selected={value === 'LCM'}>{course.label}</option>)}
          </select>
        </div>
      </div>

      <div>
        <label for="stc-split" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300">Even-split interval</label>
        <select id="stc-split" class="w-full rounded-xl border border-gray-200 bg-white px-3.5 py-3 text-sm text-gray-900 outline-none transition focus:border-primary-400 focus:ring-2 focus:ring-primary-500/15 dark:border-white/10 dark:bg-white/5 dark:text-white">
          <option value="25">Every 25</option>
          <option value="50" selected>Every 50</option>
          <option value="100">Every 100</option>
        </select>
      </div>
    </form>

    <div slot="controls" class="flex justify-center">
      <button id="stc-reset" type="button" class="min-h-11 rounded-xl border border-gray-200 px-5 py-2.5 text-sm font-semibold text-gray-700 transition hover:border-primary-300 hover:text-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500/30 dark:border-white/10 dark:text-gray-300">
        Reset
      </button>
    </div>

    <div slot="result">
      <div id="stc-initial" class="flex min-h-80 flex-col items-center justify-center rounded-2xl border border-dashed border-gray-300 bg-white/70 px-5 text-center dark:border-white/15 dark:bg-white/[0.025]">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary-50 text-primary-500 dark:bg-primary-900/30">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
        </div>
        <p class="mt-4 font-semibold text-gray-800 dark:text-gray-200">Your converted swim time will appear here</p>
        <p class="mt-2 max-w-sm text-sm leading-6 text-gray-500 dark:text-gray-400">Choose an event and courses, then enter a valid swim time.</p>
      </div>

      <div id="stc-error" class="hidden min-h-80 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm leading-6 text-amber-800 dark:border-amber-800/40 dark:bg-amber-900/15 dark:text-amber-200" role="status"></div>

      <div id="stc-valid" class="hidden space-y-4">
        <div class="rounded-2xl border border-primary-200 bg-white p-5 text-center shadow-sm dark:border-primary-800/40 dark:bg-surface-dark">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400">Estimated equivalent</p>
          <p id="stc-result-time" class="mt-2 text-4xl font-bold tabular-nums text-gray-900 dark:text-white">—</p>
          <p id="stc-result-course" class="mt-2 text-sm text-gray-500 dark:text-gray-400"></p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-surface-dark">
            <p class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Average pace per 50</p>
            <p id="stc-pace" class="mt-1 text-xl font-bold tabular-nums text-gray-900 dark:text-white">—</p>
          </div>
          <div class="rounded-xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-surface-dark">
            <p class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Applied multiplier</p>
            <p id="stc-factor" class="mt-1 text-xl font-bold tabular-nums text-gray-900 dark:text-white">—</p>
          </div>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-surface-dark">
          <div class="flex items-center justify-between gap-3">
            <h3 class="font-semibold text-gray-900 dark:text-white">Even-pace split estimates</h3>
            <span id="stc-split-label" class="text-xs text-gray-500 dark:text-gray-400"></span>
          </div>
          <div class="mt-3 max-h-64 overflow-auto rounded-lg border border-gray-100 dark:border-white/5">
            <table class="w-full min-w-72 text-left text-sm">
              <thead class="sticky top-0 bg-gray-50 text-xs uppercase tracking-wide text-gray-500 dark:bg-gray-900 dark:text-gray-400">
                <tr><th class="px-3 py-2">Distance</th><th class="px-3 py-2">Split</th><th class="px-3 py-2">Cumulative</th></tr>
              </thead>
              <tbody id="stc-splits" class="divide-y divide-gray-100 text-gray-700 dark:divide-white/5 dark:text-gray-300"></tbody>
            </table>
          </div>
        </div>

        <div class="rounded-xl bg-blue-50 px-4 py-3 text-xs leading-5 text-blue-800 dark:bg-blue-900/20 dark:text-blue-200">
          <strong>Result context:</strong> Use this equivalent for training plans and course-to-course comparison. Meet entry, qualification, and team systems may require a different official conversion table.
        </div>
      </div>
    </div>

    <p slot="footer" class="text-xs leading-5 text-gray-500 dark:text-gray-400">
      Model: NCAA 2025–26/2026–27 sample conversion factors, updated August 5, 2026. Reverse and SCM–LCM results invert or combine the published metric-to-SCY factors.
    </p>
  </ConverterToolShell>
</div>

<script>
  import { SWIM_COURSES, SWIM_EVENTS, buildEvenSplits, convertSwimTime, formatSwimTime, parseSwimTime } from '../../lib/swimTimeConverter.mjs';

  const root = document.querySelector('#swim-time-converter');
  if (root && root.getAttribute('data-initialized') !== 'true') {
    root.setAttribute('data-initialized', 'true');
    const form = root.querySelector('#stc-form');
    const eventInput = root.querySelector('#stc-event');
    const sexInput = root.querySelector('#stc-sex');
    const timeInput = root.querySelector('#stc-time');
    const fromInput = root.querySelector('#stc-from');
    const toInput = root.querySelector('#stc-to');
    const splitInput = root.querySelector('#stc-split');
    const initial = root.querySelector('#stc-initial');
    const error = root.querySelector('#stc-error');
    const valid = root.querySelector('#stc-valid');
    const resultTime = root.querySelector('#stc-result-time');
    const resultCourse = root.querySelector('#stc-result-course');
    const pace = root.querySelector('#stc-pace');
    const factor = root.querySelector('#stc-factor');
    const splitLabel = root.querySelector('#stc-split-label');
    const splitsBody = root.querySelector('#stc-splits');

    const showState = (state, message = '') => {
      initial?.classList.toggle('hidden', state !== 'initial');
      error?.classList.toggle('hidden', state !== 'error');
      valid?.classList.toggle('hidden', state !== 'valid');
      if (error) error.textContent = message;
    };

    const updateSplitOptions = () => {
      const event = SWIM_EVENTS.find(item => item.key === eventInput?.value);
      const distance = event?.distances[toInput?.value];
      if (!distance || !splitInput) return;
      Array.from(splitInput.options).forEach(option => {
        option.disabled = Number(option.value) > distance;
      });
      if (Number(splitInput.value) > distance) splitInput.value = distance >= 50 ? '50' : '25';
    };

    const update = () => {
      updateSplitOptions();
      const rawTime = timeInput?.value.trim() || '';
      if (!rawTime) {
        showState('initial');
        return;
      }
      const timeSeconds = parseSwimTime(rawTime);
      if (!Number.isFinite(timeSeconds)) {
        showState('error', 'Enter a valid positive swim time, such as 58.42 or 1:02.35. Values after a colon must be below 60.');
        return;
      }

      try {
        const result = convertSwimTime({
          timeSeconds,
          eventKey: eventInput?.value,
          sex: sexInput?.value,
          fromCourse: fromInput?.value,
          toCourse: toInput?.value,
        });
        const interval = Number(splitInput?.value || 50);
        const rows = buildEvenSplits(result.convertedSeconds, result.targetDistance, interval);
        const targetCourse = SWIM_COURSES[toInput.value];
        const sourceCourse = SWIM_COURSES[fromInput.value];

        if (resultTime) resultTime.textContent = formatSwimTime(result.convertedSeconds);
        if (resultCourse) resultCourse.textContent = `${formatSwimTime(timeSeconds)} ${fromInput.value} (${result.sourceDistance} ${result.sourceUnit}) converted to ${toInput.value} (${result.targetDistance} ${result.targetUnit})`;
        if (pace) pace.textContent = `${formatSwimTime(result.convertedSeconds * 50 / result.targetDistance)} per 50 ${targetCourse.unit}`;
        if (factor) factor.textContent = `× ${result.multiplier.toFixed(5)}`;
        if (splitLabel) splitLabel.textContent = `Every ${interval} ${targetCourse.unit}`;
        if (splitsBody) {
          splitsBody.replaceChildren();
          rows.forEach(row => {
            const tr = document.createElement('tr');
            [
              `${row.distance} ${targetCourse.unit}`,
              formatSwimTime(row.splitSeconds),
              formatSwimTime(row.cumulativeSeconds),
            ].forEach(value => {
              const td = document.createElement('td');
              td.className = 'px-3 py-2 tabular-nums';
              td.textContent = value;
              tr.appendChild(td);
            });
            splitsBody.appendChild(tr);
          });
        }
        showState('valid');
      } catch (conversionError) {
        showState('error', conversionError instanceof Error ? conversionError.message : 'This conversion could not be calculated.');
      }
    };

    form?.addEventListener('submit', event => event.preventDefault());
    form?.addEventListener('input', update);
    form?.addEventListener('change', update);
    root.querySelector('#stc-swap')?.addEventListener('click', () => {
      const previous = fromInput.value;
      fromInput.value = toInput.value;
      toInput.value = previous;
      update();
      fromInput.focus();
    });
    root.querySelector('#stc-reset')?.addEventListener('click', () => {
      form?.reset();
      update();
      timeInput?.focus();
    });
    update();
  }
</script>
