<div class="max-w-lg mx-auto">
  <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-6 space-y-5">
    <div>
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Preview the QR Reader Workflow</h2>
      <p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">Testing the planned upload flow? Add an image to preview it; this demo does not decode QR content.</p>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Upload QR Code Image</label>
      <div class="relative">
        <input id="qrr-file" type="file" accept="image/*" class="hidden" />
        <label for="qrr-file" class="flex items-center justify-center gap-2 w-full px-4 py-4 rounded-xl border-2 border-dashed border-gray-300 dark:border-white/10 hover:border-primary-500 hover:text-primary-500 transition-colors cursor-pointer text-gray-500 dark:text-gray-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span>Click to upload or drag and drop</span>
        </label>
      </div>
    </div>
    
    <div id="qrr-preview" class="hidden">
      <img id="qrr-image" class="mx-auto rounded-xl max-h-48 object-contain" />
    </div>
    
    <button id="qrr-scan" class="w-full px-4 py-3 rounded-xl bg-primary-500 text-white font-medium hover:bg-primary-600 transition-colors hidden">
      Check Demo Status
    </button>
    
    <div id="qrr-result" class="min-h-[8rem] p-4 rounded-xl border border-blue-100 bg-blue-50/70 text-center flex flex-col items-center justify-center dark:border-blue-800/30 dark:bg-blue-900/10" aria-live="polite">
      <div class="text-xs text-blue-700 dark:text-blue-300 mb-1">Workflow Status</div>
      <div id="qrr-text" class="text-sm leading-6 text-blue-800 dark:text-blue-200">Upload preview available · QR decoding not implemented.</div>
    </div>
  </div>
</div>

<script>
  (function() {
    const fileInput = document.getElementById('qrr-file') as HTMLInputElement;
    const preview = document.getElementById('qrr-preview');
    const image = document.getElementById('qrr-image') as HTMLImageElement;
    const scanBtn = document.getElementById('qrr-scan');
    const text = document.getElementById('qrr-text');
    
    fileInput?.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (e) => {
          if (image) image.src = e.target?.result as string;
          preview?.classList.remove('hidden');
          scanBtn?.classList.remove('hidden');
          if (text) text.textContent = 'Image preview ready · no QR content has been decoded.';
        };
        reader.readAsDataURL(file);
      }
    });
    
    scanBtn?.addEventListener('click', () => {
      if (text) text.textContent = 'Demo status: image preview works, but scanning and decoded output are not implemented.';
    });
  })();
</script>
