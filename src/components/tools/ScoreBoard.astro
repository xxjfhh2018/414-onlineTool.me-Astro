<div class="max-w-2xl mx-auto">
  <div class="rounded-2xl bg-white dark:bg-surface-dark border border-gray-200/60 dark:border-white/10 p-6 mb-6">
    <div class="grid grid-cols-3 gap-3 mb-4">
      <div>
        <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Reading</label>
        <input id="sb-reading" type="number" min="200" max="800" placeholder="400" 
               class="w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none text-center text-gray-800 dark:text-gray-200" />
      </div>
      <div>
        <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Writing</label>
        <input id="sb-writing" type="number" min="200" max="800" placeholder="400" 
               class="w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none text-center text-gray-800 dark:text-gray-200" />
      </div>
      <div>
        <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Math</label>
        <input id="sb-math" type="number" min="200" max="800" placeholder="400" 
               class="w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none text-center text-gray-800 dark:text-gray-200" />
      </div>
    </div>
    <div class="mb-4">
      <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Test Date</label>
      <input id="sb-date" type="date" 
             class="w-full px-3 py-2 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 outline-none text-gray-800 dark:text-gray-200" />
    </div>
    <div id="sb-draft" class="mb-3 text-center text-sm text-gray-500 dark:text-gray-400" aria-live="polite">Enter all three section scores to preview the total.</div>
    <button id="sb-add" type="button" disabled class="w-full px-4 py-2 rounded-xl bg-primary-500 text-white font-medium hover:bg-primary-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
      Add Score
    </button>
  </div>
  
  <div id="sb-scores" class="space-y-3"><div class="rounded-xl border border-dashed border-gray-300 dark:border-white/15 p-4 text-center text-sm text-gray-500 dark:text-gray-400">No scores saved yet.</div></div>
  
  <div id="sb-summary" class="min-h-[9rem] mt-6 rounded-2xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:text-gray-400" aria-live="polite">
    Your best saved score will appear here
  </div>
</div>

<script>
  (function() {
    const reading = document.getElementById('sb-reading') as HTMLInputElement;
    const writing = document.getElementById('sb-writing') as HTMLInputElement;
    const math = document.getElementById('sb-math') as HTMLInputElement;
    const date = document.getElementById('sb-date') as HTMLInputElement;
    const addBtn = document.getElementById('sb-add');
    const draft = document.getElementById('sb-draft');
    const container = document.getElementById('sb-scores');
    const summary = document.getElementById('sb-summary');
    
    let scores: { date: string; reading: number; writing: number; math: number; total: number }[] = [];
    
    function render() {
      if (!container) return;
      if (!scores.length) {
        container.innerHTML = '<div class="rounded-xl border border-dashed border-gray-300 dark:border-white/15 p-4 text-center text-sm text-gray-500 dark:text-gray-400">No scores saved yet.</div>';
        return;
      }
      container.innerHTML = scores.map((s, i) => `
        <div class="flex items-center gap-4 p-4 rounded-xl bg-white dark:bg-surface-dark border border-gray-100 dark:border-white/5">
          <div class="flex-1">
            <div class="text-xs text-gray-500 dark:text-gray-400">${s.date}</div>
            <div class="flex gap-4 mt-1">
              <span class="text-sm">R: <strong>${s.reading}</strong></span>
              <span class="text-sm">W: <strong>${s.writing}</strong></span>
              <span class="text-sm">M: <strong>${s.math}</strong></span>
            </div>
          </div>
          <div class="text-xl font-bold text-primary-500">${s.total}</div>
          <button data-i="${i}" class="sb-del text-gray-400 hover:text-red-500 text-sm">✕</button>
        </div>
      `).join('');
      
      container.querySelectorAll('.sb-del').forEach(btn => {
        btn.addEventListener('click', () => {
          const i = parseInt(btn.getAttribute('data-i') || '0');
          scores.splice(i, 1);
          render();
          updateSummary();
        });
      });
    }
    
    function updateSummary() {
      if (scores.length === 0) {
        if (summary) {
          summary.className = 'min-h-[9rem] mt-6 rounded-2xl border border-dashed border-gray-300 dark:border-white/15 bg-gray-50/70 dark:bg-white/[0.03] p-5 flex items-center justify-center text-center text-sm text-gray-500 dark:text-gray-400';
          summary.textContent = 'Your best saved score will appear here';
        }
        return;
      }
      const best = Math.max(...scores.map(s => s.total));
      if (summary) {
        summary.className = 'min-h-[9rem] mt-6 p-5 rounded-2xl bg-primary-50 dark:bg-primary-900/20 text-center flex flex-col items-center justify-center';
        summary.innerHTML = `<div class="text-sm text-gray-500 dark:text-gray-400">Best Total Score</div><div class="text-4xl font-bold text-primary-600 dark:text-primary-400 mt-1">${best}</div>`;
      }
    }

    function getDraft() {
      const r = Number(reading?.value);
      const w = Number(writing?.value);
      const m = Number(math?.value);
      const valid = [r, w, m].every(score => Number.isFinite(score) && score >= 200 && score <= 800);
      return { r, w, m, valid };
    }

    function updateDraft() {
      const current = getDraft();
      if (addBtn instanceof HTMLButtonElement) addBtn.disabled = !current.valid;
      if (!draft) return;
      const hasAnyValue = Boolean(reading?.value || writing?.value || math?.value);
      if (current.valid) {
        draft.className = 'mb-3 text-center text-sm font-medium text-primary-600 dark:text-primary-400';
        draft.textContent = `Current total: ${current.r + current.w + current.m}`;
      } else {
        draft.className = `mb-3 text-center text-sm ${hasAnyValue ? 'text-amber-700 dark:text-amber-300' : 'text-gray-500 dark:text-gray-400'}`;
        draft.textContent = hasAnyValue ? 'Each section score must be between 200 and 800.' : 'Enter all three section scores to preview the total.';
      }
    }
    
    addBtn?.addEventListener('click', () => {
      const { r, w, m, valid } = getDraft();
      const d = date?.value || new Date().toISOString().split('T')[0];
      
      if (valid) {
        scores.push({ date: d, reading: r, writing: w, math: m, total: r + w + m });
        scores.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
        render();
        updateSummary();
        if (reading) reading.value = '';
        if (writing) writing.value = '';
        if (math) math.value = '';
        updateDraft();
      }
    });
    [reading, writing, math].forEach(input => input?.addEventListener('input', updateDraft));
    updateDraft();
  })();
</script>
