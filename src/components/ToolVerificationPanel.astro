---
import type { ToolVerification } from '../data/toolVerification';

const { verification } = Astro.props as { verification: ToolVerification };
const tone = verification.status === 'verified'
  ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-300'
  : verification.status === 'demo'
    ? 'bg-amber-50 text-amber-800 dark:bg-amber-900/20 dark:text-amber-300'
    : 'bg-blue-50 text-blue-700 dark:bg-blue-900/20 dark:text-blue-300';
---

<aside aria-label="Calculator data status">
  <h2 class="mb-4 text-xl font-bold text-gray-900 dark:text-white">Data, Version, and Assumptions</h2>
  <div class="rounded-2xl border border-gray-100 bg-white p-5 dark:border-white/5 dark:bg-surface-dark sm:p-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap items-center gap-2">
        <span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${tone}`}>{verification.statusLabel}</span>
        <span class="text-sm font-medium text-gray-800 dark:text-gray-200">{verification.versionLabel}</span>
      </div>
      <span class="text-xs text-gray-500 dark:text-gray-400">Last reviewed: <time datetime={verification.lastReviewed}>{verification.lastReviewed}</time></span>
    </div>
    <div class="mt-3 flex flex-col gap-2 text-sm leading-6 text-gray-600 dark:text-gray-400 sm:flex-row sm:items-start sm:justify-between">
      <p>{verification.reviewNote}</p>
      <a class="shrink-0 font-medium text-primary-600 underline hover:no-underline dark:text-primary-400" href={verification.sourceUrl} target="_blank" rel="noopener noreferrer">{verification.sourceLabel}</a>
    </div>
    <details class="mt-4 border-t border-gray-100 pt-4 dark:border-white/5">
      <summary class="cursor-pointer text-sm font-semibold text-gray-800 dark:text-gray-200">Assumptions and exclusions</summary>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-gray-600 dark:text-gray-400">
        {verification.exclusions.map(item => <li>{item}</li>)}
      </ul>
    </details>
  </div>
</aside>
